{
	"name": "enlisted-cheats",
	"type": "module",
	"version": "1.0.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev --host 0.0.0.0 --port 3000",
		"dev:alt": "astro dev --host 0.0.0.0 --port 3001",
		"start": "astro dev --host 0.0.0.0 --port 3000",
		"dev:ip": "node scripts/dev-with-ip.mjs",
		"build": "astro build",
		"build:cf": "node scripts/cloudflare-build.mjs",
		"seo:audit": "node scripts/seo-audit.mjs",
		"build:validate": "astro build && node scripts/validate-sitemaps.mjs && node scripts/seo-audit.mjs",
		"optimize:images": "node scripts/optimize-responsive-images.mjs",
		"fetch:images": "node scripts/fetch-arc-raiders-images.mjs",
		"fetch:enlisted-official": "node scripts/fetch-enlisted-official-images.mjs",
		"setup:logo": "node scripts/setup-enlisted-logo.mjs",
    "fetch:logo": "node scripts/fetch-zadeyo-logo.mjs",
    "extract:video-poster": "node scripts/extract-video-poster.mjs",
		"preview": "astro preview --host 0.0.0.0 --port 3000",
		"preview:alt": "astro preview --host 0.0.0.0 --port 3001",
		"validate:sitemaps": "node scripts/validate-sitemaps.mjs",
		"generate:i18n": "node scripts/generate-i18n-content.mjs",
		"generate:blog": "node scripts/generate-blog-posts.mjs",
		"generate:guides": "node scripts/generate-external-guides.mjs",
		"fetch:guide-images": "node scripts/fetch-guide-ign-images.mjs",
		"deploy": "npm run build && wrangler deploy",
		"cf:deploy": "npm run build:cf && wrangler deploy",
		"pages:deploy": "wrangler pages deploy dist --project-name=enlistedcheats",
		"astro": "astro"
	},
	"dependencies": {
		"@fontsource-variable/outfit": "^5.2.8",
		"@fontsource-variable/syne": "^5.2.7",
		"@tailwindcss/vite": "^4.3.2",
		"astro": "^7.0.9",
		"tailwindcss": "^4.3.2"
	},
	"devDependencies": {
		"ffmpeg-static": "^5.3.0",
		"sharp": "^0.35.3",
		"terser": "^5.49.0",
		"wrangler": "^4.30.0"
	}
}
