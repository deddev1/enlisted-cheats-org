---
import '../styles/global.css';
import { productInfo, siteConfig } from '../data/site';
import { metaKeywordsContent } from '../data/seo';
import I18nHead from '../components/I18nHead.astro';
import LocaleSuggest from '../components/LocaleSuggest.astro';
import { defaultLocale, localeMap, locales, type LocaleCode } from '../data/i18n/locales';
import type { PageId } from '../data/i18n/content.generated';

interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	title: string;
	description: string;
	canonicalPath?: string;
	ogImage?: string;
	ogImageAlt?: string;
	keywords?: string;
	noindex?: boolean;
	type?: 'website' | 'article';
	breadcrumbs?: Crumb[];
	locale?: LocaleCode;
	pageId?: PageId;
	extraGraph?: Record<string, unknown>[];
	lcpImage?: string;
	lcpImageSrcSet?: string;
	lcpImageSizes?: string;
}

const {
	title,
	description,
	canonicalPath = Astro.url.pathname,
	ogImage = siteConfig.defaultOgImage,
	ogImageAlt = title,
	keywords = metaKeywordsContent,
	noindex = false,
	type = 'website',
	breadcrumbs,
	locale = defaultLocale,
	pageId,
	extraGraph = [],
	lcpImage,
	lcpImageSrcSet,
	lcpImageSizes = '100vw',
} = Astro.props;

const path = canonicalPath.endsWith('/') || canonicalPath.includes('.') ? canonicalPath : `${canonicalPath}/`;
const canonicalURL = new URL(path === '//' ? '/' : path, siteConfig.url).href;
const ogImageURL = new URL(ogImage, siteConfig.url).href;
const logoURL = new URL(siteConfig.logoRaster, siteConfig.url).href;
const ogImageIsLogo = ogImage === siteConfig.logo;
const ogImageType = ogImage.endsWith('.webp') ? 'image/webp' : 'image/png';
const ogImageWidth = ogImageIsLogo ? '512' : '1920';
const ogImageHeight = ogImageIsLogo ? '512' : '1080';
const twitterCard = ogImageIsLogo ? 'summary' : 'summary_large_image';
const robots = noindex
	? 'noindex, nofollow'
	: 'index, follow, max-image-preview:large';
const siteDescription = `${productInfo.tagline}. ${productInfo.summary}`;
const localeMeta = localeMap[locale];
const schemaLanguage = localeMeta.ogLocale.replace('_', '-');
const ogLocale = localeMeta.ogLocale;

const graph: Record<string, unknown>[] = [
	{
		'@type': 'WebPage',
		'@id': `${canonicalURL}#webpage`,
		url: canonicalURL,
		name: title,
		description,
		isPartOf: { '@id': `${siteConfig.url}/#website` },
		inLanguage: schemaLanguage,
		primaryImageOfPage: {
			'@type': 'ImageObject',
			url: ogImageURL,
		},
	},
	{
		'@type': 'WebSite',
		'@id': `${siteConfig.url}/#website`,
		url: siteConfig.url,
		name: siteConfig.name,
		description: siteDescription,
		inLanguage: schemaLanguage,
		publisher: { '@id': `${siteConfig.url}/#organization` },
	},
	{
		'@type': 'Organization',
		'@id': `${siteConfig.url}/#organization`,
		name: siteConfig.name,
		url: siteConfig.url,
		email: siteConfig.supportEmail,
		logo: {
			'@type': 'ImageObject',
			url: logoURL,
			width: siteConfig.logoRasterWidth,
			height: siteConfig.logoRasterHeight,
		},
		image: logoURL,
		contactPoint: {
			'@type': 'ContactPoint',
			contactType: 'customer support',
			email: siteConfig.supportEmail,
			availableLanguage: locales.map((l) => l.name),
		},
	},
];

if (breadcrumbs && breadcrumbs.length > 0) {
	graph.push({
		'@type': 'BreadcrumbList',
		'@id': `${canonicalURL}#breadcrumb`,
		itemListElement: breadcrumbs.map((crumb, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: crumb.label,
			...(crumb.href
				? { item: new URL(crumb.href, siteConfig.url).href }
				: { item: canonicalURL }),
		})),
	});
}

if (extraGraph.length > 0) {
	// Nodes must not carry a nested @context inside @graph (invalid JSON-LD).
	graph.push(
		...extraGraph.map((node) => {
			const { ['@context']: _ignored, ...rest } = node as Record<string, unknown> & {
				'@context'?: unknown;
			};
			return rest;
		}),
	);
}

const softwareNode = extraGraph.find((node) => node['@type'] === 'SoftwareApplication');
if (softwareNode) {
	const webpage = graph.find((node) => node['@type'] === 'WebPage') as Record<string, unknown> | undefined;
	if (webpage) {
		webpage.about = { '@id': softwareNode['@id'] };
	}
}
---

<!doctype html>
<html lang={locale} dir={localeMeta.dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#061112" />
		<meta name="robots" content={robots} />
		<meta name="googlebot" content={robots} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={siteConfig.name} />
		<link rel="canonical" href={canonicalURL} />
		{pageId && <I18nHead pageId={pageId} locale={locale} />}
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="sitemap" type="application/xml" title="Sitemap Index" href="/sitemap-index.xml" />
		<link rel="sitemap" type="application/xml" title="Page Sitemap" href="/sitemap.xml" />
		<link rel="sitemap" type="application/xml" title="Image Sitemap" href="/sitemap-images.xml" />
		{
			lcpImage && !lcpImageSrcSet && (
				<link
					rel="preload"
					as="image"
					href={lcpImage}
					type={lcpImage.includes('.png') ? 'image/png' : 'image/webp'}
					fetchpriority="high"
				/>
			)
		}
		{
			lcpImage && lcpImageSrcSet && (
				<>
					<link
						rel="preload"
						as="image"
						href={lcpImage}
						type="image/webp"
						fetchpriority="high"
						media="(max-width: 760px)"
					/>
					<link
						rel="preload"
						as="image"
						href={lcpImageSrcSet.split(',')[0].trim().split(' ')[0]}
						type="image/webp"
						imagesrcset={lcpImageSrcSet}
						imagesizes={lcpImageSizes}
						fetchpriority="high"
						media="(min-width: 761px)"
					/>
				</>
			)
		}

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteConfig.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:secure_url" content={ogImageURL} />
		<meta property="og:image:type" content={ogImageType} />
		<meta property="og:image:width" content={ogImageWidth} />
		<meta property="og:image:height" content={ogImageHeight} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content={ogLocale} />

		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		{!noindex && locale === defaultLocale && (
			<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
		)}

		<title>{title}</title>
		<script is:inline src="/trusted-types-policy.js"></script>
	</head>
	<body>
		{pageId && <LocaleSuggest currentLocale={locale} pageId={pageId} />}
		<slot />
	</body>
</html>
