---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { enlistedImages } from '../data/enlisted';
import { heroPreloadSrc, heroSizes, heroSrcSet, heroIsExternal, contentSrc, contentSrcSet, galleryTileSizes, isExternalImage } from '../lib/responsive-images';
import { englishPaths, pageIds, type PageId } from '../data/i18n/routing';
import { defaultLocale } from '../data/i18n/locales';

type GalleryInput = string | { src: string; alt: string };

interface Props {
	title: string;
	description: string;
	canonicalPath?: string;
	heading: string;
	intro: string;
	eyebrow?: string;
	heroImage?: string;
	heroAlt?: string;
	gallery?: ReadonlyArray<GalleryInput>;
	galleryTitle?: string;
	ctaPrimary?: { href: string; label: string };
	ctaSecondary?: { href: string; label: string };
	showGallery?: boolean;
	hideBanner?: boolean;
	locale?: import('../data/i18n/locales').LocaleCode;
	pageId?: import('../data/i18n/content.generated').PageId;
	extraGraph?: Record<string, unknown>[];
	contentWidth?: 'narrow' | 'full';
}

const {
	title,
	description,
	canonicalPath = '/',
	heading,
	intro,
	eyebrow,
	heroImage = enlistedImages.hero,
	heroAlt = 'Enlisted cheats product preview',
	gallery = enlistedImages.product.slice(0, 3),
	galleryTitle = 'Enlisted cheats UI reference',
	ctaPrimary,
	ctaSecondary,
	showGallery = true,
	hideBanner = false,
	locale = defaultLocale,
	pageId: pageIdProp,
	extraGraph = [],
	contentWidth = 'narrow',
} = Astro.props;

function resolvePageId(path: string): PageId | undefined {
	for (const id of pageIds) {
		if (englishPaths[id] === path) return id;
	}
	return undefined;
}

const pageId = pageIdProp ?? resolvePageId(canonicalPath);

const ui = getUi(locale);
const homeHref = getLocalizedPath('home', locale);
const resolvedEyebrow = eyebrow ?? ui.product.title;

const normalizedGallery = gallery
	.map((item) => {
		if (typeof item !== 'string') {
			return {
				src: contentSrc(item.src),
				srcset: contentSrcSet(item.src),
				alt: item.alt,
			};
		}

		const file = item.split('/').pop()?.replace(/\.webp$/i, '') ?? 'enlisted-cheats';
		const keywordAlt = file
			.split('-')
			.map((part) => part.charAt(0).toUpperCase() + part.slice(1))
			.join(' ');

		return {
			src: contentSrc(item),
			srcset: contentSrcSet(item),
			alt: heroAlt || `${keywordAlt} - ${ui.product.title}`,
		};
	})
	.filter((item) => Boolean(item.src));

const breadcrumbs = [
	{ label: ui.nav.home, href: homeHref },
	{ label: heading },
];

const isHeroLcp = heroImage === enlistedImages.hero;
const lcpImage = isHeroLcp ? heroPreloadSrc : undefined;
const lcpImageSrcSet = isHeroLcp ? heroSrcSet : undefined;
const lcpImageSizes = isHeroLcp ? heroSizes : undefined;
---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	ogImage={heroImage}
	ogImageAlt={heroAlt}
	breadcrumbs={breadcrumbs}
	locale={locale}
	pageId={pageId}
	extraGraph={extraGraph}
	lcpImage={lcpImage}
	lcpImageSrcSet={lcpImageSrcSet}
	lcpImageSizes={lcpImageSizes}
>
	<Navbar locale={locale} pageId={pageId} />
	<main class:list={['page', hideBanner && 'page--compact']}>
		{
			!hideBanner && (
		<section class="banner">
			<div class="banner__media">
				{
					isHeroLcp ? (
						heroIsExternal ? (
							<img
								src={heroPreloadSrc}
								alt={heroAlt}
								width="1600"
								height="900"
								class="banner__img"
								fetchpriority="high"
								decoding="async"
							/>
						) : (
						<picture>
							<source media="(max-width: 760px)" srcset={heroPreloadSrc} type="image/webp" />
							<source
								media="(min-width: 761px)"
								srcset={heroSrcSet}
								sizes={heroSizes}
								type="image/webp"
							/>
							<img
								src={heroPreloadSrc}
								alt={heroAlt}
								width="1600"
								height="900"
								class="banner__img"
								fetchpriority="high"
								decoding="async"
							/>
						</picture>
						)
					) : isExternalImage(heroImage) ? (
						<img
							src={heroImage}
							alt={heroAlt}
							width="1600"
							height="900"
							class="banner__img"
							loading="lazy"
							decoding="async"
						/>
					) : (
						<picture>
							<source
								media="(max-width: 760px)"
								srcset={contentSrc(heroImage)}
								type="image/webp"
							/>
							<source
								media="(min-width: 761px)"
								srcset={contentSrcSet(heroImage) ?? contentSrc(heroImage)}
								sizes="100vw"
								type="image/webp"
							/>
							<img
								src={contentSrc(heroImage)}
								srcset={contentSrcSet(heroImage)}
								sizes="100vw"
								alt={heroAlt}
								width="1600"
								height="900"
								class="banner__img"
								loading="lazy"
								decoding="async"
							/>
						</picture>
					)
				}
				<div class="banner__scrim" aria-hidden="true"></div>
			</div>
			<div class="shell banner__content">
				<nav class="banner__crumbs" aria-label="Breadcrumb">
					<a href={homeHref}>{ui.nav.home}</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">{heading}</span>
				</nav>
				<p class="banner__eyebrow">{resolvedEyebrow}</p>
				<h1 class="banner__title">{heading}</h1>
				<p class="banner__intro">{intro}</p>
				{
					(ctaPrimary || ctaSecondary) && (
						<div class="banner__actions">
							{ctaPrimary && (
								<a
									class:list={[
										ctaPrimary.label === 'Buy Now' ? 'btn-buy' : 'btn btn--primary',
									]}
									href={ctaPrimary.href}
									rel={ctaPrimary.href.startsWith('http') ? 'noopener noreferrer' : undefined}
								>
									{ctaPrimary.label}
								</a>
							)}
							{ctaSecondary && (
								<a
									class:list={[
										ctaSecondary.label === 'Buy Now' ? 'btn-buy' : 'btn btn--ghost',
									]}
									href={ctaSecondary.href}
									rel={ctaSecondary.href.startsWith('http') ? 'noopener noreferrer' : undefined}
								>
									{ctaSecondary.label}
								</a>
							)}
						</div>
					)
				}
			</div>
		</section>
			)
		}

		<div class="shell page__wrap">
			<article class:list={['article', contentWidth === 'full' && 'article--full']}>
				<slot />
			</article>

			{
				showGallery && normalizedGallery.length > 0 && (
					<section class="gallery-block" aria-labelledby="page-gallery-title">
						<div class="gallery-block__head">
							<p class="gallery-block__eyebrow">{ui.product.title}</p>
							<h2 id="page-gallery-title" class="gallery-block__title">{galleryTitle}</h2>
						</div>
						<div class="gallery-block__grid">
							{normalizedGallery.map((image) => (
								<figure class="gallery-block__item">
									<img
										src={image.src}
										{...(image.srcset ? { srcset: image.srcset } : {})}
										sizes={galleryTileSizes}
										alt={image.alt}
										width="800"
										height="500"
										loading="lazy"
										decoding="async"
									/>
									<figcaption>{image.alt}</figcaption>
								</figure>
							))}
						</div>
					</section>
				)
			}
		</div>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.page {
		overflow-x: clip;
		padding-bottom: calc(3.25rem + env(safe-area-inset-bottom, 0px));
	}

	.page--compact .page__wrap {
		padding-top: clamp(1.5rem, 3vw, 2rem);
	}

	.page--compact .article--full {
		gap: clamp(1.5rem, 3vw, 2.25rem);
	}

	.banner {
		position: relative;
		isolation: isolate;
		min-height: clamp(220px, 38vh, 380px);
		overflow: hidden;
		border-bottom: 1px solid rgba(197, 138, 69, 0.12);
		margin-bottom: 2rem;
	}

	.banner__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.banner__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
	}

	.banner__scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(13, 17, 18, 0.72) 0%, rgba(13, 17, 18, 0.88) 100%),
			linear-gradient(90deg, rgba(13, 17, 18, 0.55), rgba(13, 17, 18, 0.35) 50%, rgba(13, 17, 18, 0.55));
	}

	.banner__content {
		position: relative;
		z-index: 1;
		max-width: 720px;
		margin-inline: auto;
		padding: 2.75rem 0 2.5rem;
		text-align: center;
	}

	.banner__crumbs {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-bottom: 1rem;
		font-size: 0.8rem;
		color: var(--color-faint);
	}

	.banner__crumbs a {
		color: var(--color-muted);
		font-weight: 600;
	}

	.banner__crumbs a:hover {
		color: var(--color-orchid);
	}

	.banner__eyebrow {
		margin: 0 0 0.55rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-orchid);
	}

	.banner__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 4.5vw, 2.75rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.12;
	}

	.banner__intro {
		margin: 0.9rem auto 0;
		max-width: 36rem;
		color: #E5EEEE;
		font-size: 1.02rem;
		line-height: 1.65;
	}

	.banner__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.65rem;
		margin-top: 1.35rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.7rem;
		padding: 0.7rem 1.15rem;
		border-radius: 0.75rem;
		font-size: 0.92rem;
		font-weight: 700;
		transition:
			transform 0.2s ease,
			filter 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.btn--primary {
		background: var(--gradient-brand);
		color: white;
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.28);
	}

	.btn--primary:hover {
		transform: translateY(-1px);
		filter: brightness(1.05);
		color: white;
	}

	.btn--ghost {
		border: 1px solid rgba(197, 138, 69, 0.28);
		background: rgba(29, 36, 35, 0.55);
		color: var(--color-ink);
	}

	.btn--ghost:hover {
		border-color: rgba(197, 138, 69, 0.5);
		color: var(--color-ink);
	}

	.page__wrap {
		display: grid;
		gap: 2rem;
	}

	.article {
		width: 100%;
		max-width: 760px;
		margin-inline: auto;
		display: grid;
		gap: 1rem;
		text-align: left;
		color: #d8cee9;
		line-height: 1.7;
	}

	.article--full {
		max-width: var(--page-max);
	}

	.article :global(.card-panel) {
		padding: 1.35rem 1.45rem;
		border-radius: 0.95rem;
		border: 1px solid rgba(197, 138, 69, 0.14);
		background: rgba(21, 26, 26, 0.9);
		display: grid;
		gap: 0.8rem;
	}

	.article :global(h2) {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-ink);
	}

	.article :global(h3) {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
		color: var(--color-ink);
	}

	.article :global(p) {
		margin: 0;
		color: var(--color-muted);
	}

	.article :global(.card-panel ul) {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.5rem;
	}

	.article :global(.card-panel li) {
		position: relative;
		padding: 0.55rem 0.75rem 0.55rem 2rem;
		border-radius: 0.65rem;
		background: rgba(13, 17, 18, 0.4);
		border: 1px solid rgba(197, 138, 69, 0.1);
		color: #d4cae6;
		font-size: 0.95rem;
	}

	.article :global(.card-panel li::before) {
		content: '';
		position: absolute;
		left: 0.8rem;
		top: 50%;
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 999px;
		background: var(--color-orchid);
		transform: translateY(-50%);
	}

	.article :global(a:not(.btn-buy):not(.btn):not(.pricing-showcase__cart):not(.features-detail__pricing-link):not(.features-detail__checkout-link)) {
		color: var(--color-orchid);
		font-weight: 600;
	}

	.article :global(a:not(.btn-buy):not(.btn):not(.pricing-showcase__cart):not(.features-detail__pricing-link):not(.features-detail__checkout-link):hover) {
		color: #D39A50;
	}

	.article :global(.btn-buy),
	.article :global(.btn-buy:hover),
	.article :global(.btn-buy:visited),
	.article :global(.btn-buy:focus-visible) {
		color: #ffffff;
		text-shadow: 0 1px 3px rgba(13, 17, 18, 0.55);
	}

	.article :global(.price-grid) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.article :global(.price-card) {
		display: grid;
		gap: 0.3rem;
		justify-items: center;
		padding: 1.2rem 0.9rem;
		border-radius: 0.85rem;
		border: 1px solid rgba(197, 138, 69, 0.18);
		background: rgba(13, 17, 18, 0.45);
		text-align: center;
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.article :global(.price-card:hover) {
		border-color: rgba(197, 138, 69, 0.4);
		transform: translateY(-1px);
	}

	.article :global(.price-card.is-featured) {
		background: linear-gradient(160deg, #343B31, #B47A3C 55%, #D39A50);
		border-color: transparent;
		color: white;
	}

	.article :global(.price-card.is-featured .price-card__meta) {
		color: rgba(255, 255, 255, 0.88);
	}

	.article :global(.price-card__label) {
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.article :global(.price-card__price) {
		font-family: var(--font-display);
		font-size: 1.9rem;
		font-weight: 800;
		color: var(--color-ink);
	}

	.article :global(.price-card.is-featured .price-card__price) {
		color: white;
	}

	.article :global(.price-card__meta) {
		font-size: 0.78rem;
		color: var(--color-muted);
	}

	.article :global(.cta-row) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 0.25rem;
	}

	.article :global(.cta-btn) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.55rem;
		padding: 0.65rem 1.05rem;
		border-radius: 0.7rem;
		font-size: 0.9rem;
		font-weight: 700;
		transition:
			transform 0.2s ease,
			filter 0.2s ease,
			border-color 0.2s ease;
	}

	.article :global(.cta-btn--primary) {
		background: var(--gradient-brand);
		color: white;
		box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
	}

	.article :global(.cta-btn--primary:hover) {
		transform: translateY(-1px);
		filter: brightness(1.05);
		color: white;
	}

	.article :global(.cta-btn--ghost) {
		border: 1px solid rgba(197, 138, 69, 0.28);
		background: transparent;
		color: var(--color-ink);
	}

	.article :global(.cta-btn--ghost:hover) {
		border-color: rgba(197, 138, 69, 0.5);
		color: var(--color-ink);
	}

	.gallery-block {
		width: 100%;
		max-width: var(--page-max);
		margin-inline: auto;
		display: grid;
		gap: 1rem;
		padding-top: 0.5rem;
		border-top: 1px solid rgba(197, 138, 69, 0.12);
	}

	.gallery-block__head {
		text-align: center;
	}

	.gallery-block__eyebrow {
		margin: 0 0 0.35rem;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-orchid);
	}

	.gallery-block__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 800;
	}

	.gallery-block__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.gallery-block__item {
		position: relative;
		margin: 0;
		overflow: hidden;
		border-radius: 0.85rem;
		border: 1px solid rgba(197, 138, 69, 0.14);
		background: #151A1A;
		aspect-ratio: 16 / 10;
	}

	.gallery-block__item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.gallery-block__item:hover img {
		transform: scale(1.3);
	}

	@media (hover: none), (pointer: coarse) {
		.gallery-block__item:hover img {
			transform: none;
		}

		.gallery-block__item figcaption {
			opacity: 1;
		}
	}

	.gallery-block__item figcaption {
		position: absolute;
		inset: auto 0 0;
		padding: 1.4rem 0.75rem 0.65rem;
		background: linear-gradient(transparent, rgba(13, 17, 18, 0.92));
		color: #d8cfea;
		font-size: 0.72rem;
		font-weight: 600;
	}

	@media (max-width: 800px) {
		.article :global(.price-grid) {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.page {
			padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
		}

		.banner {
			margin-bottom: 1.25rem;
		}

		.banner__content {
			padding: 2rem 0 1.65rem;
			max-width: none;
		}

		.banner__crumbs {
			font-size: 0.75rem;
			margin-bottom: 0.75rem;
		}

		.banner__title {
			font-size: clamp(1.45rem, 6.5vw, 2rem);
			line-height: 1.15;
			overflow-wrap: anywhere;
		}

		.banner__intro {
			font-size: 0.92rem;
			line-height: 1.55;
			max-width: none;
		}

		.banner__actions {
			flex-direction: column;
			align-items: stretch;
			width: 100%;
		}

		.banner__actions .btn-buy,
		.banner__actions .btn {
			width: 100%;
			min-height: var(--touch-min);
		}

		.page__wrap {
			gap: 1.35rem;
		}

		.article {
			width: 100%;
		}

		.article :global(.card-panel) {
			padding: 1rem 0.95rem;
		}

		.article :global(h2) {
			font-size: 1.05rem;
			line-height: 1.35;
		}

		.article :global(.cta-row) {
			flex-direction: column;
		}

		.article :global(.cta-btn) {
			width: 100%;
			min-height: var(--touch-min);
			justify-content: center;
		}

		.gallery-block__grid {
			grid-template-columns: 1fr;
		}

		.gallery-block__item figcaption {
			font-size: 0.68rem;
		}
	}
</style>
