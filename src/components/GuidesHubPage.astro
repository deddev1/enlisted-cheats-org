---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import { siteConfig } from '../data/site';
import {
	absoluteGuideUrl,
	formatExternalGuideHost,
	getMixedExternalGuides,
	guidesBasePath,
} from '../data/guides/helpers';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale } from '../data/i18n/locales';

const locale = defaultLocale;
const otherGameGuides = getMixedExternalGuides();
const homeHref = getLocalizedPath('home', locale);
const cheatsGuidesHref = '/blog/';

function otherGameGuideLabel(title: string): string {
	const trimmed = title.replace(/\s*\|\s*Guides$/, '').trim();
	return trimmed.length <= 52 ? trimmed : `${trimmed.slice(0, 49).trimEnd()}…`;
}

const title = 'Other PC Game Cheat Guides | Partner Directory';
const description =
	'Partner cheat guides for other PC games — outbound links only, not indexed. Enlisted cheats guides (ESP, aimbot, setup) live on our cheats guides hub.';

const canonicalURL = absoluteGuideUrl();

const extraGraph = [
	{
		'@type': 'CollectionPage',
		'@id': `${canonicalURL}#collection`,
		name: title,
		description,
		url: canonicalURL,
		inLanguage: 'en',
		isPartOf: { '@id': `${siteConfig.url}/#website` },
	},
];
---

<Layout
	title={title}
	description={description}
	canonicalPath={guidesBasePath}
	locale={locale}
	noindex={true}
	breadcrumbs={[{ label: 'Home', href: homeHref }, { label: 'Partner guides' }]}
	extraGraph={extraGraph}
>
	<Navbar locale={locale} />
	<main class="guides shell">
		<header class="guides__hero">
			<p class="guides__eyebrow">Partner directory</p>
			<h1>Other games cheat guides</h1>
			<p class="guides__intro">
				Outbound partner links for cheat guides on other PC titles. This page is not indexed — search engines
				should focus on our
				<a href={cheatsGuidesHref}>Enlisted cheats guides</a> for ESP, aimbot, setup, and vendor comparisons.
			</p>
		</header>

		{
			otherGameGuides.length > 0 && (
				<section
					class="guides__section guides__section--external"
					id="other-games-guides"
					aria-labelledby="external-guides-title"
				>
					<h2 id="external-guides-title" class="guides__section-title">Partner cheat guides</h2>
					<p class="guides__section-intro">
						Mixed across franchises so one game does not dominate the list. Links use
						<code>nofollow</code> and this hub uses <code>noindex</code> so it does not compete with
						<a href={cheatsGuidesHref}>Enlisted cheats guides</a>.
					</p>

					<div class="guides__grid">
						{otherGameGuides.map((guide) => (
							<article class="guides__card guides__card--external">
								<a
									class="guides__card-link"
									href={guide.externalUrl}
									target="_blank"
									rel="nofollow noopener noreferrer"
								>
									<img
										src={guide.imageSrc}
										alt={guide.imageAlt}
										width="640"
										height="360"
										loading="lazy"
										decoding="async"
									/>
									<div class="guides__card-body">
										<span class="guides__cat">{guide.gameName}</span>
										<h3 class="guides__card-title">{otherGameGuideLabel(guide.title)}</h3>
										<p class="guides__card-url">{formatExternalGuideHost(guide.externalUrl)}</p>
										<p>{guide.intro}</p>
									</div>
								</a>
							</article>
						))}
					</div>
				</section>
			)
		}
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.guides {
		padding: 2.5rem 0 4rem;
	}

	.guides__hero {
		margin-bottom: 2.5rem;
	}

	.guides__eyebrow {
		margin: 0 0 0.5rem;
		color: #B47A3C;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.guides__hero h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(2rem, 4vw, 2.8rem);
		line-height: 1.1;
	}

	.guides__intro {
		margin: 0;
		max-width: 42rem;
		color: rgba(255, 255, 255, 0.78);
		font-size: 1.05rem;
		line-height: 1.65;
	}

	.guides__intro a {
		color: #B47A3C;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.guides__section {
		margin-bottom: 2.5rem;
	}

	.guides__section--external {
		padding-top: 0.5rem;
	}

	.guides__section-title {
		margin: 0 0 0.5rem;
		font-size: 1.5rem;
	}

	.guides__section-intro {
		margin: 0 0 1.25rem;
		max-width: 40rem;
		color: rgba(255, 255, 255, 0.65);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.guides__section-intro a {
		color: #B47A3C;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.guides__section-intro code {
		font-size: 0.88em;
		color: rgba(180, 122, 60, 0.95);
	}

	.guides__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.9rem;
	}

	.guides__card {
		display: flex;
		flex-direction: column;
		border-radius: 0.95rem;
		border: 1px solid rgba(197, 138, 69, 0.14);
		background: rgba(20, 24, 30, 0.88);
		overflow: hidden;
		color: inherit;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.guides__card:hover {
		border-color: rgba(197, 138, 69, 0.38);
		transform: translateY(-2px);
	}

	.guides__card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	.guides__card img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.guides__card-body {
		display: grid;
		gap: 0.45rem;
		padding: 0.9rem 1rem 1rem;
	}

	.guides__cat {
		color: #B47A3C;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.guides__card-body h3,
	.guides__card-title {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.35;
		font-weight: 800;
	}

	.guides__card-link:hover .guides__card-title {
		color: #B47A3C;
	}

	.guides__card-url {
		margin: 0;
		color: rgba(180, 122, 60, 0.92);
		font-size: 0.78rem;
		font-weight: 600;
		word-break: break-all;
	}

	.guides__card-body p:not(.guides__card-title):not(.guides__card-url) {
		margin: 0;
		color: rgba(255, 255, 255, 0.65);
		font-size: 0.86rem;
		line-height: 1.55;
	}

	@media (max-width: 720px) {
		.guides__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
