---
import { siteConfig } from '../data/site';

interface Props {
	canonicalPath: string;
}

const { canonicalPath } = Astro.props;
const path = canonicalPath.endsWith('/') || canonicalPath.includes('.') ? canonicalPath : `${canonicalPath}/`;
const href = new URL(path === '//' ? '/' : path, siteConfig.url).href;
---

<link rel="alternate" hreflang="en" href={href} />
<link rel="alternate" hreflang="x-default" href={href} />
