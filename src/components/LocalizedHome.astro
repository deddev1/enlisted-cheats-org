---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HomeFeaturesSpotlight from '../components/HomeFeaturesSpotlight.astro';
import PricingPlans from '../components/PricingPlans.astro';
import PricingFeatureList from '../components/PricingFeatureList.astro';
import HomeAboutUs from '../components/HomeAboutUs.astro';
import HomeFaq from '../components/HomeFaq.astro';
import HomeExplore from '../components/HomeExplore.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocaleContent, getPageContent } from '../data/i18n';
import { getCanonicalPath, getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { defaultLocale } from '../data/i18n/locales';
import { homeFaqs, productInfo, siteConfig, customerReviewStats, customerReviews } from '../data/site';
import { enlistedImages, pricingShopImage } from '../data/enlisted';
import {
	buildAggregateOffer,
	buildFaqSchemaNode,
	buildSoftwareApplicationSchema,
} from '../data/schema';
import { heroPreloadSrc, heroSizes, heroSrcSet, heroIsExternal } from '../lib/responsive-images';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const { ui } = getLocaleContent(locale);
const home = getPageContent(locale, 'home');

const title = home.title;
const description = home.description;
/** SEO consolidates to English; locale routes remain for UX. */
const canonicalPath = getCanonicalPath('home', locale);
const canonicalURL = new URL(canonicalPath, siteConfig.url).href;
const heroImage = new URL(enlistedImages.hero, siteConfig.url).href;

const extraGraph: Record<string, unknown>[] =
	locale === defaultLocale
		? [
	{
		'@type': 'Product',
		'@id': `${canonicalURL}#product`,
		name: productInfo.name,
		description: productInfo.summary,
		image: heroImage,
		brand: { '@type': 'Brand', name: productInfo.brand },
		url: canonicalURL,
		offers: buildAggregateOffer(canonicalURL),
		aggregateRating: {
			'@type': 'AggregateRating',
			ratingValue: customerReviewStats.averageRating.toFixed(1),
			reviewCount: customerReviewStats.totalCount,
			bestRating: '5',
			worstRating: '1',
		},
		review: customerReviews.map((review) => ({
			'@type': 'Review',
			author: { '@type': 'Person', name: review.handle },
			datePublished: review.date,
			reviewRating: {
				'@type': 'Rating',
				ratingValue: String(review.rating),
				bestRating: '5',
				worstRating: '1',
			},
			reviewBody: review.text,
		})),
	},
	buildSoftwareApplicationSchema(canonicalURL, heroImage),
	buildFaqSchemaNode(canonicalURL, homeFaqs),
]
		: [];
---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={home.imageAlt}
	locale={locale}
	pageId="home"
	breadcrumbs={[{ label: ui.nav.home }]}
	extraGraph={extraGraph}
	lcpImage={heroPreloadSrc}
	lcpImageSrcSet={heroIsExternal ? undefined : heroSrcSet}
	lcpImageSizes={heroSizes}
>
	<main class="site">
		<div class="hero-stage">
			<Navbar locale={locale} pageId="home" overlay />
			<Hero
				locale={locale}
				imageAlt={home.imageAlt}
				accent={ui.hero.accent}
			/>
		</div>
		<HomeFeaturesSpotlight locale={locale} />
		<section
			class="site__section site__section--store"
			id="store"
			aria-label={ui.product.title}
			style={`--store-bg: url('${pricingShopImage.src}')`}
		>
			<div class="shell store-stack">
				<PricingPlans locale={locale} showRelatedPages={false} showPageTitle={false} />
				<HomeAboutUs locale={locale} />
				<PricingFeatureList locale={locale} showRelatedPages={false} />
			</div>
		</section>
		<section class="site__section site__section--reviews">
			<CustomerReviews locale={locale} />
		</section>
		<section class="site__section site__section--faq">
			<HomeFaq locale={locale} />
		</section>
		<section class="site__section site__section--explore">
			<HomeExplore locale={locale} />
		</section>
		<SiteFooter locale={locale} />
	</main>
</Layout>

<style>
	.site {
		overflow-x: clip;
	}

	.hero-stage {
		position: relative;
	}

	.site__section--reviews,
	.site__section--faq,
	.site__section--explore,
	.site__section--store {
		content-visibility: auto;
		contain-intrinsic-size: 1px 720px;
	}

	.site__section {
		padding-block: var(--section-space);
	}

	:global(.feat-spotlight) + .site__section--store {
		padding-top: 0;
	}

	.site__section--store {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding-block: clamp(1.35rem, 2.8vw, 2.15rem);
	}

	.site__section--store::before {
		content: '';
		position: absolute;
		inset: -6%;
		z-index: 0;
		background:
			linear-gradient(
				180deg,
				rgba(13, 17, 18, 0.9) 0%,
				rgba(13, 17, 18, 0.62) 42%,
				rgba(13, 17, 18, 0.88) 100%
			),
			var(--store-bg) center 18% / cover no-repeat;
		filter: saturate(0.82) brightness(0.48);
		pointer-events: none;
	}

	.site__section--store::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		background: radial-gradient(ellipse 90% 70% at 50% 40%, rgba(197, 138, 69, 0.07), transparent 68%);
		pointer-events: none;
	}

	.site__section--store > .shell {
		position: relative;
		z-index: 1;
	}

	.store-stack {
		display: grid;
		gap: 0.85rem;
		align-items: start;
	}

	.store-stack :global(.home-about) {
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border-panel);
	}

	@media (max-width: 760px) {
		.site__section--store {
			contain-intrinsic-size: 1px 1200px;
		}
	}
</style>
