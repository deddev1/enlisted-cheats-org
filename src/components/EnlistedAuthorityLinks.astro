---
import { enlistedAuthorityLinks } from '../data/guides/helpers';

interface Props {
	headingLevel?: 'h2' | 'h3';
}

const { headingLevel = 'h3' } = Astro.props;
const HeadingTag = headingLevel;
---

<section class="authority-links" aria-labelledby="enlisted-authority-title">
	<HeadingTag id="enlisted-authority-title" class="authority-links__title">
		Official game guides &amp; supplys
	</HeadingTag>
	<p class="authority-links__intro">
		We link to trusted third-party sources so you can verify patch notes, player stats, and mission info
		outside our site.
	</p>
	<ul class="authority-links__list">
		{
			enlistedAuthorityLinks.map((link) => (
				<li>
					<a
						class="authority-links__item"
						href={link.href}
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="authority-links__item-title">{link.title}</span>
						<span class="authority-links__item-desc">{link.description}</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.authority-links {
		margin-top: 1.75rem;
		padding: 1.25rem 1.35rem;
		border-radius: 1rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(21, 26, 26, 0.72);
	}

	.authority-links__title {
		margin: 0 0 0.45rem;
		font-size: 1.15rem;
		font-weight: 800;
		color: rgba(255, 255, 255, 0.95);
	}

	.authority-links__intro {
		margin: 0 0 1rem;
		max-width: 40rem;
		color: rgba(255, 255, 255, 0.62);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.authority-links__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.55rem;
	}

	.authority-links__item {
		display: grid;
		gap: 0.2rem;
		padding: 0.85rem 1rem;
		border-radius: 0.75rem;
		border: 1px solid rgba(255, 255, 255, 0.06);
		background: rgba(255, 255, 255, 0.03);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.authority-links__item:hover {
		border-color: var(--color-border-gold);
		background: rgba(197, 138, 69, 0.06);
		color: inherit;
	}

	.authority-links__item-title {
		color: #b47a3c;
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.35;
	}

	.authority-links__item-desc {
		color: rgba(255, 255, 255, 0.58);
		font-size: 0.84rem;
		line-height: 1.5;
	}
</style>
