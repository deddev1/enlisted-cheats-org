---
import { productInfo } from '../data/site';

interface Props {
	defaultPlanId: string;
	class?: string;
}

const { defaultPlanId, class: className } = Astro.props;
---

<div class:list={['plan-summary', className]} data-plan-summary>
	{
		productInfo.plans.map((plan) => {
			const bullets =
				productInfo.planSummaries[plan.id as keyof typeof productInfo.planSummaries] ?? [];
			return (
				<div
					class:list={['plan-summary__panel', plan.id === defaultPlanId && 'is-active']}
					data-plan-summary-panel={plan.id}
				>
					<p class="plan-summary__label">You get:</p>
					<ul>
						{bullets.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
			);
		})
	}
</div>

<style>
	.plan-summary {
		width: 100%;
		box-sizing: border-box;
	}

	.plan-summary__panel {
		display: none;
		margin: 0;
		padding: 0.85rem 1.15rem;
		border-radius: 0.9rem;
		border: 1px solid rgba(32, 191, 192, 0.2);
		background: rgba(13, 35, 36, 0.75);
		box-sizing: border-box;
	}

	.plan-summary__panel.is-active {
		display: block;
	}

	.plan-summary__label {
		margin: 0 0 0.4rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-faint);
	}

	.plan-summary__panel ul {
		margin: 0;
		padding-left: 1.1rem;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.2rem 1rem;
		list-style: disc;
	}

	.plan-summary__panel li {
		color: var(--color-muted);
		font-size: 0.88rem;
		line-height: 1.4;
	}

	@media (max-width: 560px) {
		.plan-summary__panel ul {
			grid-template-columns: 1fr;
		}
	}
</style>
