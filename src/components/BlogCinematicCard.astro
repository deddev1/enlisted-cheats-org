---
interface Props {
	href: string;
	imageSrc: string;
	imageAlt: string;
	title: string;
	description: string;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
}

const {
	href,
	imageSrc,
	imageAlt,
	title,
	description,
	loading = 'lazy',
	fetchpriority,
} = Astro.props;
---

<a href={href} class="blog-feature-card">
	<figure class="blog-feature-card__media">
		<img
			src={imageSrc}
			alt={imageAlt}
			width="640"
			height="360"
			class="blog-feature-card__img"
			loading={loading}
			decoding="async"
			fetchpriority={fetchpriority}
		/>
	</figure>
	<div class="blog-feature-card__panel">
		<h3 class="blog-feature-card__title">{title}</h3>
		<p class="blog-feature-card__text">{description}</p>
	</div>
</a>

<style>
	.blog-feature-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 22.5rem;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.14);
		background: rgba(18, 22, 24, 0.96);
		color: #fff;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.blog-feature-card:hover,
	.blog-feature-card:focus-visible {
		border-color: rgba(197, 138, 69, 0.42);
		transform: translateY(-2px);
		color: #fff;
	}

	.blog-feature-card__media {
		position: relative;
		margin: 0;
		flex: 0 0 48%;
		min-height: 10.5rem;
		overflow: hidden;
	}

	.blog-feature-card__img {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 10.5rem;
		object-fit: cover;
		object-position: center 35%;
	}

	.blog-feature-card__panel {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		gap: 0.6rem;
		padding: 1rem 0.9rem 1.15rem;
		background: rgba(16, 20, 22, 0.96);
		text-align: center;
	}

	.blog-feature-card__title {
		margin: 0;
		max-width: 16rem;
		font-family: var(--font-display);
		font-size: clamp(0.84rem, 1.2vw, 0.94rem);
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.blog-feature-card__text {
		margin: 0;
		max-width: 18rem;
		color: rgba(255, 255, 255, 0.86);
		font-size: clamp(0.74rem, 1vw, 0.8rem);
		line-height: 1.62;
		text-wrap: pretty;
	}
</style>
