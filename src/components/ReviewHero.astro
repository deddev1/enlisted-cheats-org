---
import {
	reviewDetailHeroImage,
	reviewHeroImage,
	type EnlistedScreenshot,
} from '../data/enlisted';

interface Props {
	title: string;
	subtitle?: string;
	image?: EnlistedScreenshot;
	priority?: boolean;
}

const {
	title,
	subtitle,
	image = reviewHeroImage,
	priority = false,
} = Astro.props;

const base = image.src.replace(/\.webp$/i, '');
const mobileSrc = `${base}-480w.webp`;
const desktopSrcSet = [
	`${base}-640w.webp 640w`,
	`${base}-960w.webp 960w`,
	`${base}-1400w.webp 1400w`,
].join(', ');
---

<section class="review-hero" aria-labelledby="review-hero-title">
	<div class="review-hero__media">
		<picture>
			<source media="(max-width: 760px)" srcset={mobileSrc} type="image/webp" />
			<source media="(min-width: 761px)" srcset={desktopSrcSet} sizes="100vw" type="image/webp" />
			<img
				src={`${base}-960w.webp`}
				srcset={desktopSrcSet}
				sizes="100vw"
				alt={image.alt}
				width="1920"
				height="1080"
				class="review-hero__img"
				fetchpriority={priority ? 'high' : undefined}
				loading={priority ? 'eager' : 'lazy'}
				decoding="async"
			/>
		</picture>
		<div class="review-hero__scrim" aria-hidden="true"></div>
	</div>

	<div class="shell review-hero__content">
		<h1 id="review-hero-title" class="review-hero__title">{title}</h1>
		{subtitle && <p class="review-hero__subtitle">{subtitle}</p>}
	</div>
</section>

<style>
	.review-hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: clamp(12rem, 28vw, 18rem);
		display: grid;
		align-items: end;
	}

	.review-hero__media {
		position: absolute;
		inset: 0;
	}

	.review-hero__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
	}

	.review-hero__scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(8, 10, 14, 0.35) 0%, rgba(8, 10, 14, 0.82) 72%, rgba(8, 10, 14, 0.95) 100%),
			linear-gradient(90deg, rgba(8, 10, 14, 0.55) 0%, transparent 55%);
	}

	.review-hero__content {
		position: relative;
		z-index: 1;
		padding-block: clamp(2.5rem, 6vw, 3.5rem) 1.35rem;
		display: grid;
		gap: 0.55rem;
		max-width: 44rem;
	}

	.review-hero__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 4vw, 2.6rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.08;
		text-wrap: balance;
	}

	.review-hero__subtitle {
		margin: 0;
		max-width: 38rem;
		color: #d8d0e8;
		font-size: clamp(0.92rem, 1.8vw, 1.02rem);
		line-height: 1.6;
	}
</style>
