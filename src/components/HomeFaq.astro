---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import FaqList from './FaqList.astro';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const faq = getUi(locale).homeFaq;
const faqHref = getLocalizedPath('faq', locale);
---

<section class="home-faq shell" aria-labelledby="home-faq-title">
	<div class="home-faq__head">
		<h2 id="home-faq-title" class="home-faq__title">
			<span class="home-faq__accent" aria-hidden="true"></span>
			{faq.title}
		</h2>
		<p class="home-faq__intro">{faq.intro}</p>
	</div>

	<FaqList items={faq.items} groupByCategory />

	<div class="home-faq__footer">
		<a class="home-faq__link" href={faqHref}>{faq.seeAll}</a>
		<a class="home-faq__link home-faq__link--muted" href="/blog/">{faq.readGuides}</a>
	</div>
</section>

<style>
	.home-faq {
		padding-block: 0;
	}

	.home-faq__head {
		display: grid;
		gap: 0.55rem;
		margin-bottom: 1.15rem;
	}

	.home-faq__title {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--heading-section);
		font-weight: 800;
	}

	.home-faq__accent {
		display: inline-block;
		width: 0.22rem;
		height: 1.35rem;
		border-radius: 999px;
		background: linear-gradient(180deg, #B47A3C, #343B31);
		flex-shrink: 0;
	}

	.home-faq__intro {
		margin: 0;
		max-width: 42rem;
		color: var(--color-muted);
		font-size: 0.92rem;
		line-height: 1.6;
	}

	.home-faq__footer {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem 1.25rem;
		margin-top: 1rem;
	}

	.home-faq__link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--color-orchid);
		font-size: 0.9rem;
		font-weight: 700;
	}

	.home-faq__link--muted {
		color: var(--color-muted);
		font-weight: 650;
	}

	.home-faq__link:hover {
		color: var(--color-ink);
	}
</style>
