---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getUi } from '../data/i18n';
import { getLocalizedPath, type PageId } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
	/** When true, navbar overlays the homepage hero without pushing content down. */
	overlay?: boolean;
}

const { locale = defaultLocale, pageId = 'home', overlay = false } = Astro.props;
const ui = getUi(locale);
const current = Astro.url.pathname;
const homeHref = getLocalizedPath('home', locale);

const isActive = (href: string, linkPageId?: PageId) => {
	if (linkPageId === 'home') {
		return current === href || current === `/${locale}/` || current === '/';
	}
	if (href === '/reviews/') {
		return current === '/reviews/' || current.startsWith('/reviews/');
	}
	if (linkPageId === 'hacks') {
		return (
			current === href ||
			current.startsWith(href) ||
			current.startsWith('/enlisted-cheats')
		);
	}
	return current === href || current.startsWith(href);
};

const cheatLinks = [
	{ label: ui.nav.cheats ?? 'Cheats', href: getLocalizedPath('hacks', locale), pageId: 'hacks' as PageId },
	{ label: ui.nav.esp ?? 'ESP', href: getLocalizedPath('enlisted-esp', locale), pageId: 'enlisted-esp' as PageId },
	{ label: ui.nav.aimbot ?? 'Aimbot', href: getLocalizedPath('enlisted-aimbot', locale), pageId: 'enlisted-aimbot' as PageId },
	{ label: 'Wallhack', href: getLocalizedPath('wallhack', locale), pageId: 'wallhack' as PageId },
	{ label: 'Radar', href: getLocalizedPath('radar', locale), pageId: 'radar' as PageId },
];

const cheatsActive = cheatLinks.some((link) => isActive(link.href, link.pageId));

const mainLinks = [
	{ label: ui.nav.updates, href: getLocalizedPath('updates', locale), pageId: 'updates' as PageId },
	{ label: ui.nav.features, href: getLocalizedPath('features', locale), pageId: 'features' as PageId },
	{ label: ui.nav.pricing, href: getLocalizedPath('pricing', locale), pageId: 'pricing' as PageId },
	{ label: ui.nav.setup, href: getLocalizedPath('setup', locale), pageId: 'setup' as PageId },
	{ label: ui.nav.faq, href: getLocalizedPath('faq', locale), pageId: 'faq' as PageId },
	{ label: ui.nav.reviews ?? 'Reviews', href: '/reviews/' },
];

const shopPlans = [
	{
		label: `${ui.product.monthly} license`,
		href: siteConfig.checkoutUrl,
		desc: `${productInfo.planSummaries.monthly[0]}. ${productInfo.planSummaries.monthly[1]} with anti-cheat updates while your license is active.`,
		image: '/images/enlisted-cheats-combat-esp.webp',
	},
	{
		label: `${ui.product.lifetime} license`,
		href: siteConfig.checkoutUrl,
		desc: `${productInfo.planSummaries.lifetime[0]}. ${productInfo.planSummaries.lifetime[2]} — one-time ${productInfo.planSummaries.lifetime[1].replace('One-time ', '')}.`,
		image: '/images/enlisted-cheats-hero.webp',
	},
];

const buyLabel = locale === 'en' ? 'Buy' : ui.nav.buyNow;
const shopLabel = locale === 'en' ? 'Shop' : buyLabel;
---

<header class:list={['nav', overlay && 'nav--overlay']} data-nav>
	<div class="nav__utility">
		<div class="nav__shell nav__utility-inner">
			<a href={homeHref} class="nav__utility-mark" aria-label={siteConfig.name}>
				<img src={siteConfig.logo} alt="" width="18" height="18" class="nav__utility-logo" />
			</a>
			<nav class="nav__utility-links" aria-label="Utility">
				<a href={getLocalizedPath('features', locale)} class="nav__utility-link">{ui.nav.features}</a>
				<a href={getLocalizedPath('support', locale)} class="nav__utility-link nav__utility-link--external">
					Support
					<span aria-hidden="true">↗</span>
				</a>
			</nav>
			<div class="nav__utility-right">
				<LanguageSwitcher pageId={pageId} currentLocale={locale} />
			</div>
		</div>
	</div>

	<div class="nav__main">
		<div class="nav__shell nav__main-inner">
			<a href={homeHref} class="nav__brand" aria-label={siteConfig.name}>
				<span class="nav__brand-emblem" aria-hidden="true">★</span>
				<span class="nav__brand-text">
					<span class="nav__brand-title">{productInfo.game.toUpperCase()}</span>
					<span class="nav__brand-sub">CHEATS</span>
				</span>
			</a>

			<nav class="nav__menu" id="nav-panel" data-nav-panel aria-label="Primary">
				<ul class="nav__list">
					<li class="nav__item nav__item--dropdown" data-nav-dropdown>
						<button
							type="button"
							class:list={['nav__trigger nav__trigger--accent', { 'is-active': cheatsActive }]}
							data-nav-dropdown-trigger
							aria-expanded="false"
							aria-controls="nav-cheats-menu"
						>
							{ui.nav.cheats ?? 'Cheats'}
							<span class="nav__chevron" aria-hidden="true"></span>
						</button>
						<div class="nav__dropdown nav__dropdown--menu" id="nav-cheats-menu" hidden>
							<ul class="nav__dropdown-list">
								{
									cheatLinks.map((link) => (
										<li>
											<a
												href={link.href}
												class:list={['nav__dropdown-link', { 'is-active': isActive(link.href, link.pageId) }]}
											>
												{link.label}
											</a>
										</li>
									))
								}
							</ul>
						</div>
					</li>

					{
						mainLinks.map((link) => (
							<li class="nav__item">
								<a
									href={link.href}
									class:list={['nav__link', { 'is-active': isActive(link.href, link.pageId) }]}
								>
									{link.label}
								</a>
							</li>
						))
					}

					<li class="nav__item nav__item--mobile-buy">
						<a href={siteConfig.checkoutUrl} class="nav__mobile-buy" rel="noopener noreferrer">
							{buyLabel}
						</a>
					</li>
				</ul>
			</nav>

			<div class="nav__actions">
				<div class="nav__shop" data-nav-dropdown>
					<button
						type="button"
						class="nav__shop-btn"
						data-nav-dropdown-trigger
						aria-expanded="false"
						aria-controls="nav-shop-menu"
					>
						<span class="nav__shop-star" aria-hidden="true">★</span>
						<span>{shopLabel}</span>
						<span class="nav__chevron nav__chevron--gold" aria-hidden="true"></span>
					</button>
					<div class="nav__dropdown nav__dropdown--shop" id="nav-shop-menu" hidden>
						<div class="nav__shop-grid">
							{
								shopPlans.map((plan) => (
									<a href={plan.href} class="nav__shop-card" rel="noopener noreferrer">
										<div class="nav__shop-card-media">
											<img src={plan.image} alt="" width="320" height="180" loading="lazy" decoding="async" />
											<span class="nav__shop-card-link" aria-hidden="true">↗</span>
										</div>
										<div class="nav__shop-card-body">
											<p class="nav__shop-card-title">{plan.label}</p>
											<p class="nav__shop-card-desc">{plan.desc}</p>
										</div>
									</a>
								))
							}
						</div>
						<a href={getLocalizedPath('pricing', locale)} class="nav__shop-all">
							{ui.nav.pricing} →
						</a>
					</div>
				</div>

				<button
					type="button"
					class="nav__toggle"
					aria-label="Open menu"
					aria-expanded="false"
					aria-controls="nav-panel"
					data-nav-toggle
				>
					<span class="nav__toggle-icon" aria-hidden="true"></span>
				</button>
			</div>
		</div>
	</div>

	<div class="nav__backdrop" data-nav-backdrop hidden aria-hidden="true"></div>
</header>

<script>
	const nav = document.querySelector('[data-nav]');
	if (nav) {
		const toggle = nav.querySelector('[data-nav-toggle]');
		const panel = nav.querySelector('[data-nav-panel]');
		const dropdowns = Array.from(nav.querySelectorAll('[data-nav-dropdown]'));

		const setOpen = (open: boolean) => {
			toggle?.setAttribute('aria-expanded', String(open));
			toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			nav.classList.toggle('is-open', open);
			document.body.classList.toggle('nav-open', open);
			const backdrop = nav.querySelector('[data-nav-backdrop]') as HTMLElement | null;
			if (backdrop) backdrop.hidden = !open;
			if (!open) closeDropdowns();
		};

		const openDropdown = (dropdown: Element) => {
			closeDropdowns();
			dropdown.classList.add('is-open');
			const trigger = dropdown.querySelector('[data-nav-dropdown-trigger]') as HTMLElement | null;
			const menu = dropdown.querySelector('.nav__dropdown') as HTMLElement | null;
			trigger?.setAttribute('aria-expanded', 'true');
			if (menu) menu.hidden = false;
		};

		const closeDropdown = (dropdown: Element) => {
			dropdown.classList.remove('is-open');
			const trigger = dropdown.querySelector('[data-nav-dropdown-trigger]') as HTMLElement | null;
			const menu = dropdown.querySelector('.nav__dropdown') as HTMLElement | null;
			trigger?.setAttribute('aria-expanded', 'false');
			if (menu) menu.hidden = true;
		};

		const closeDropdowns = () => {
			dropdowns.forEach((dropdown) => closeDropdown(dropdown));
		};

		const toggleDropdown = (dropdown: Element) => {
			if (dropdown.classList.contains('is-open')) {
				closeDropdown(dropdown);
				return;
			}
			openDropdown(dropdown);
		};

		const isDesktop = () => window.matchMedia('(min-width: 901px)').matches;

		dropdowns.forEach((dropdown) => {
			const trigger = dropdown.querySelector('[data-nav-dropdown-trigger]');

			trigger?.addEventListener('click', (event) => {
				event.stopPropagation();
				toggleDropdown(dropdown);
			});

			dropdown.addEventListener('mouseenter', () => {
				if (!isDesktop()) return;
				openDropdown(dropdown);
			});

			dropdown.addEventListener('mouseleave', () => {
				if (!isDesktop()) return;
				closeDropdown(dropdown);
			});
		});

		document.addEventListener('click', (event) => {
			if (!(event.target instanceof Element)) return;
			if (!nav.contains(event.target)) closeDropdowns();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				closeDropdowns();
				if (nav.classList.contains('is-open')) setOpen(false);
			}
		});

		toggle?.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		panel?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		nav.addEventListener('click', (event) => {
			const target = event.target as Element;
			if (nav.classList.contains('is-open') && target.hasAttribute('data-nav-backdrop')) {
				setOpen(false);
			}
		});

		const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 12);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}
</script>

<style is:global>
	:root {
		--nav-stack-height: 5.35rem;
	}

	body.nav-open {
		overflow: hidden;
	}

	.nav:not(.nav--overlay) + main,
	.nav:not(.nav--overlay) + .page {
		padding-top: calc(var(--nav-stack-height) + env(safe-area-inset-top, 0px));
	}

	.nav .lang-switcher__toggle {
		padding: 0.28rem 0.55rem;
		border-radius: 0.2rem;
		border-color: rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.04);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.nav .lang-switcher__panel {
		border-radius: 0.35rem;
		border-color: rgba(255, 255, 255, 0.12);
		background: rgba(12, 12, 12, 0.98);
	}
</style>

<style>
	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 90;
		pointer-events: none;
	}

	.nav__shell {
		width: min(100% - (var(--page-gutter) * 2), 1280px);
		margin: 0 auto;
	}

	.nav__utility,
	.nav__main,
	.nav__backdrop {
		pointer-events: auto;
	}

	.nav__utility {
		background: var(--color-midnight);
		border-bottom: 1px solid var(--color-border);
	}

	.nav__utility-inner {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-height: 2rem;
		padding-block: 0.2rem;
	}

	.nav__utility-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 0.15rem;
		background: rgba(255, 255, 255, 0.06);
	}

	.nav__utility-logo {
		display: block;
		width: 1rem;
		height: 1rem;
		object-fit: contain;
	}

	.nav__utility-links {
		display: flex;
		align-items: center;
		gap: 1.1rem;
	}

	.nav__utility-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.58);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.nav__utility-link:hover {
		color: rgba(255, 255, 255, 0.88);
	}

	.nav__utility-right {
		margin-left: auto;
	}

	.nav__main {
		background: rgba(13, 17, 18, 0.72);
		border-bottom: 1px solid var(--color-border);
		backdrop-filter: blur(10px);
		transition:
			background 0.25s ease,
			border-color 0.25s ease;
	}

	.nav.is-scrolled .nav__main {
		background: rgba(13, 17, 18, 0.94);
		border-bottom-color: var(--color-border);
	}

	.nav__main-inner {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-height: 3.35rem;
	}

	.nav__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		flex-shrink: 0;
		color: var(--color-ink);
		text-decoration: none;
	}

	.nav__brand-emblem {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 50%;
		font-size: 0.95rem;
		color: rgba(255, 255, 255, 0.88);
		background: rgba(255, 255, 255, 0.04);
	}

	.nav__brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}

	.nav__brand-title {
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	.nav__brand-sub {
		margin-top: 0.12rem;
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.28em;
		color: rgba(255, 255, 255, 0.62);
	}

	.nav__menu {
		flex: 1;
		min-width: 0;
	}

	.nav__list {
		display: flex;
		align-items: stretch;
		justify-content: center;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav__item {
		display: flex;
		align-items: stretch;
		position: relative;
	}

	.nav__item + .nav__item .nav__link,
	.nav__item + .nav__item .nav__trigger,
	.nav__item--dropdown + .nav__item .nav__link {
		border-left: 1px solid rgba(255, 255, 255, 0.12);
	}

	.nav__link,
	.nav__trigger {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 3.35rem;
		padding: 0 1rem;
		border: 0;
		background: transparent;
		color: rgba(255, 255, 255, 0.88);
		font: inherit;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}

	.nav__link:hover,
	.nav__trigger:hover {
		background: rgba(255, 255, 255, 0.06);
		color: var(--color-ink);
	}
	.nav__trigger.is-active {
		color: var(--color-ink);
	}

	.nav__trigger--accent,
	.nav__trigger--accent.is-active {
		color: #d39a50;
	}

	.nav__chevron {
		width: 0.45rem;
		height: 0.45rem;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(45deg) translateY(-1px);
		opacity: 0.75;
	}

	.nav__chevron--gold {
		border-color: var(--color-cta);
		transition: transform 0.2s ease;
	}

	.nav__shop.is-open .nav__chevron--gold,
	.nav__item--dropdown.is-open .nav__chevron {
		transform: rotate(-135deg) translateY(1px);
	}

	.nav__dropdown {
		position: absolute;
		top: 100%;
		left: 0;
		z-index: 5;
		min-width: 12rem;
		padding: 0.35rem 0;
		border: 1px solid var(--color-border);
		background: var(--color-card);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(4px);
		transition:
			opacity 0.18s ease,
			transform 0.18s ease,
			visibility 0.18s ease;
	}

	.nav__item--dropdown.is-open .nav__dropdown,
	.nav__shop.is-open .nav__dropdown {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateY(0);
	}

	.nav__dropdown-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav__dropdown-link {
		display: block;
		padding: 0.65rem 1rem;
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.nav__dropdown-link:hover,
	.nav__dropdown-link.is-active {
		background: rgba(255, 255, 255, 0.06);
		color: var(--color-ink);
	}

	.nav__actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-left: auto;
		flex-shrink: 0;
	}

	.nav__shop {
		position: relative;
	}

	.nav__shop-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2.35rem;
		padding: 0 0.95rem;
		border: 1px solid transparent;
		background: transparent;
		color: var(--color-ink);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.nav__shop-btn:hover,
	.nav__shop.is-open .nav__shop-btn {
		background: rgba(29, 36, 35, 0.92);
		border-color: var(--color-cta);
		box-shadow: inset 0 0 0 1px rgba(197, 138, 69, 0.25);
		color: var(--color-ink);
	}

	.nav__shop-star {
		color: var(--color-cta);
		font-size: 0.72rem;
		line-height: 1;
	}

	.nav__dropdown--shop {
		right: 0;
		left: auto;
		width: min(42rem, calc(100vw - 2rem));
		padding: 0.85rem;
		margin-top: -1px;
	}

	.nav__shop-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.nav__shop-card {
		display: grid;
		gap: 0;
		padding: 0;
		border: 1px solid var(--color-border);
		background: var(--color-bg-secondary);
		color: inherit;
		text-decoration: none;
		overflow: hidden;
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			transform 0.2s ease;
	}

	.nav__shop-card:hover {
		border-color: rgba(197, 138, 69, 0.55);
		background: var(--color-card-hover);
		transform: translateY(-1px);
	}

	.nav__shop-card-media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 8.5;
		background: var(--color-midnight);
	}

	.nav__shop-card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.nav__shop-card-link {
		position: absolute;
		top: 0.45rem;
		right: 0.45rem;
		display: grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		border: 1px solid rgba(241, 238, 229, 0.18);
		background: rgba(13, 17, 18, 0.55);
		font-size: 0.62rem;
		color: var(--color-body);
	}

	.nav__shop-card-body {
		padding: 0.85rem 0.9rem 1rem;
	}

	.nav__shop-card-title {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: 0.03em;
		text-transform: none;
		color: var(--color-cta);
	}

	.nav__shop-card-desc {
		margin: 0.45rem 0 0;
		font-size: 0.78rem;
		line-height: 1.55;
		color: var(--color-body);
	}

	.nav__shop-all {
		display: block;
		margin-top: 0.65rem;
		padding-top: 0.55rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		font-size: 0.72rem;
		font-weight: 700;
