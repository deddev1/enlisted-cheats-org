---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getUi } from '../data/i18n';
import { getLocalizedPath, type PageId } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
	/** When true, navbar overlays the homepage hero without pushing content down. */
	overlay?: boolean;
}

const { locale = defaultLocale, pageId = 'home', overlay = false } = Astro.props;
const ui = getUi(locale);
const current = Astro.url.pathname;
const homeHref = getLocalizedPath('home', locale);

const isActive = (href: string, linkPageId?: PageId) => {
	if (linkPageId === 'home') {
		return current === href || current === `/${locale}/` || current === '/';
	}
	if (href === '/reviews/') {
		return current === '/reviews/' || current.startsWith('/reviews/');
	}
	if (linkPageId === 'hacks') {
		return (
			current === href ||
			current.startsWith(href) ||
			current.startsWith('/enlisted-cheats')
		);
	}
	return current === href || current.startsWith(href);
};

const cheatLinks = [
	{ label: ui.nav.cheats ?? 'Cheats', href: getLocalizedPath('hacks', locale), pageId: 'hacks' as PageId },
	{ label: ui.nav.esp ?? 'ESP', href: getLocalizedPath('enlisted-esp', locale), pageId: 'enlisted-esp' as PageId },
	{ label: ui.nav.aimbot ?? 'Aimbot', href: getLocalizedPath('enlisted-aimbot', locale), pageId: 'enlisted-aimbot' as PageId },
	{ label: 'Wallhack', href: getLocalizedPath('wallhack', locale), pageId: 'wallhack' as PageId },
	{ label: 'Radar', href: getLocalizedPath('radar', locale), pageId: 'radar' as PageId },
];

const gameLinks = [
	{ label: locale === 'en' ? 'About' : ui.nav.features, href: getLocalizedPath('features', locale), pageId: 'features' as PageId },
	{ label: locale === 'en' ? 'Setup' : ui.nav.setup, href: getLocalizedPath('setup', locale), pageId: 'setup' as PageId },
	{ label: locale === 'en' ? 'Combat tips' : ui.nav.faq, href: getLocalizedPath('faq', locale), pageId: 'faq' as PageId },
];

const communityLinks = [
	{ label: ui.nav.reviews ?? 'Reviews', href: '/reviews/' },
	{ label: 'Blog', href: '/blog/' },
	{ label: 'Support', href: getLocalizedPath('support', locale) },
];

const cheatsActive = cheatLinks.some((link) => isActive(link.href, link.pageId));
const gameActive = gameLinks.some((link) => isActive(link.href, link.pageId));
const updatesHref = getLocalizedPath('updates', locale);
const updatesActive = isActive(updatesHref, 'updates');

const mainLinks = [
	{
		label: locale === 'en' ? 'News' : ui.nav.updates,
		href: updatesHref,
		pageId: 'updates' as PageId,
		active: updatesActive,
	},
	{
		label: locale === 'en' ? 'New Enlisted' : ui.nav.features,
		href: getLocalizedPath('features', locale),
		pageId: 'features' as PageId,
		accent: 'purple' as const,
		active: isActive(getLocalizedPath('features', locale), 'features'),
	},
	{
		label: locale === 'en' ? 'Reviews' : (ui.nav.reviews ?? 'Reviews'),
		href: '/reviews/',
		active: current === '/reviews/' || current.startsWith('/reviews/'),
	},
	{
		label: locale === 'en' ? 'Partnership' : ui.nav.pricing,
		href: getLocalizedPath('pricing', locale),
		pageId: 'pricing' as PageId,
		active: isActive(getLocalizedPath('pricing', locale), 'pricing'),
	},
];

const monthlyPlan = productInfo.plans.find((plan) => plan.id === 'monthly')!;
const lifetimePlan = productInfo.plans.find((plan) => plan.id === 'lifetime')!;

const shopPlans = [
	{
		label: locale === 'en' ? 'Monthly license' : ui.product.monthly,
		price: `$${monthlyPlan.price}`,
		href: siteConfig.checkoutUrl,
		desc:
			locale === 'en'
				? 'ESP, aimbot, wallhack, and radar for 30 days with anti-cheat updates while your license is active.'
				: `${productInfo.planSummaries.monthly[0]}. ${productInfo.planSummaries.monthly[2]}.`,
		image: '/images/enlisted-esp-overlay.webp',
	},
	{
		label: locale === 'en' ? 'Lifetime license' : ui.product.lifetime,
		price: `$${lifetimePlan.price}`,
		href: siteConfig.checkoutUrl,
		desc:
			locale === 'en'
				? 'One-time purchase with no renewals. Full feature stack and anti-cheat updates for as long as you play.'
				: `${productInfo.planSummaries.lifetime[1]}. ${productInfo.planSummaries.lifetime[2]}.`,
		image: '/images/enlisted-loot-pickup-esp.webp',
	},
];

const shopLabel = locale === 'en' ? 'Shop' : ui.nav.buyNow;
const cheatsUtilityLabel = locale === 'en' ? 'Cheats' : (ui.nav.cheats ?? 'Cheats');
---

<header class:list={['nav', overlay && 'nav--overlay']} data-nav>
	<div class="nav__utility">
		<div class="nav__shell nav__utility-inner">
			<a href={homeHref} class="nav__utility-mark" aria-label={siteConfig.name}>
				<span class="nav__utility-g" aria-hidden="true">G</span>
			</a>
			<nav class="nav__utility-links" aria-label="Utility">
				<div class="nav__utility-dropdown" data-nav-dropdown>
					<button
						type="button"
						class:list={['nav__utility-link nav__utility-link--menu', { 'is-active': cheatsActive }]}
						data-nav-dropdown-trigger
						aria-expanded="false"
						aria-controls="nav-utility-cheats-menu"
					>
						{cheatsUtilityLabel}
						<span class="nav__utility-chevron" aria-hidden="true"></span>
					</button>
					<div class="nav__dropdown nav__dropdown--utility" id="nav-utility-cheats-menu" hidden>
						<ul class="nav__dropdown-list">
							{
								cheatLinks.map((link) => (
									<li>
										<a
											href={link.href}
											class:list={['nav__dropdown-link', { 'is-active': isActive(link.href, link.pageId) }]}
										>
											{link.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</div>
				<a href={getLocalizedPath('support', locale)} class="nav__utility-link nav__utility-link--external">
					Support
					<span class="nav__utility-ext" aria-hidden="true"></span>
				</a>
			</nav>
			<div class="nav__utility-right">
				<div class="nav__utility-lang">
					<LanguageSwitcher pageId={pageId} currentLocale={locale} />
				</div>
			</div>
		</div>
	</div>

	<div class="nav__main">
		<div class="nav__shell nav__main-inner">
			<a href={homeHref} class="nav__brand" aria-label={siteConfig.name}>
				<img
					src="/images/enlisted-brand-mark.svg"
					alt=""
					width="132"
					height="36"
					class="nav__brand-logo"
					decoding="async"
				/>
			</a>

			<nav class="nav__menu" id="nav-panel" data-nav-panel aria-label="Primary">
				<ul class="nav__list">
					{
						mainLinks.map((link) => (
							<li class="nav__item">
								<a
									href={link.href}
									class:list={[
										'nav__link',
										{ 'is-active': link.active },
										link.accent === 'purple' && 'nav__link--purple',
									]}
								>
									{link.label}
								</a>
							</li>
						))
					}

					<li class="nav__item nav__item--dropdown" data-nav-dropdown>
						<button
							type="button"
							class:list={['nav__trigger', { 'is-active': gameActive }]}
							data-nav-dropdown-trigger
							aria-expanded="false"
							aria-controls="nav-game-menu"
						>
							{locale === 'en' ? 'Game' : productInfo.game}
							<span class="nav__chevron" aria-hidden="true"></span>
						</button>
						<div class="nav__dropdown nav__dropdown--menu" id="nav-game-menu" hidden>
							<ul class="nav__dropdown-list">
								{
									gameLinks.map((link) => (
										<li>
											<a
												href={link.href}
												class:list={['nav__dropdown-link', { 'is-active': isActive(link.href, link.pageId) }]}
											>
												{link.label}
											</a>
										</li>
									))
								}
							</ul>
						</div>
					</li>

					<li class="nav__item nav__item--dropdown" data-nav-dropdown>
						<button
							type="button"
							class="nav__trigger"
							data-nav-dropdown-trigger
							aria-expanded="false"
							aria-controls="nav-community-menu"
						>
							{locale === 'en' ? 'Community' : ui.nav.reviews ?? 'Community'}
							<span class="nav__chevron" aria-hidden="true"></span>
						</button>
						<div class="nav__dropdown nav__dropdown--menu" id="nav-community-menu" hidden>
							<ul class="nav__dropdown-list">
								{
									communityLinks.map((link) => (
										<li>
											<a
												href={link.href}
												class:list={[
													'nav__dropdown-link',
													{ 'is-active': 'pageId' in link ? isActive(link.href, link.pageId) : current === link.href || current.startsWith(link.href) },
												]}
											>
												{link.label}
											</a>
										</li>
									))
								}
							</ul>
						</div>
					</li>

					<li class="nav__item nav__item--mobile-buy">
						<a href={siteConfig.checkoutUrl} class="nav__mobile-buy" rel="noopener noreferrer">
							{shopLabel}
						</a>
					</li>
				</ul>
			</nav>

			<div class="nav__actions">
				<div class="nav__shop" data-nav-dropdown>
					<button
						type="button"
						class="nav__shop-btn"
						data-nav-dropdown-trigger
						aria-expanded="false"
						aria-controls="nav-shop-menu"
					>
						<span class="nav__shop-star" aria-hidden="true">★</span>
						<span>{shopLabel}</span>
						<span class="nav__chevron nav__chevron--gold" aria-hidden="true"></span>
					</button>
					<div class="nav__dropdown nav__dropdown--shop" id="nav-shop-menu" hidden>
						<div class="nav__shop-grid">
							{
								shopPlans.map((plan) => (
									<a href={plan.href} class="nav__shop-card" rel="noopener noreferrer">
										<div class="nav__shop-card-media">
											<img src={plan.image} alt="" width="320" height="180" loading="lazy" decoding="async" />
											<span class="nav__shop-card-link" aria-hidden="true">↗</span>
										</div>
										<div class="nav__shop-card-body">
											<p class="nav__shop-card-title">{plan.label}</p>
											<p class="nav__shop-card-desc">{plan.desc}</p>
										</div>
									</a>
								))
							}
						</div>
					</div>
				</div>

				<div class="nav__lang">
					<LanguageSwitcher pageId={pageId} currentLocale={locale} />
				</div>

				<button
					type="button"
					class="nav__toggle"
					aria-label="Open menu"
					aria-expanded="false"
					aria-controls="nav-panel"
					data-nav-toggle
				>
					<span class="nav__toggle-icon" aria-hidden="true"></span>
				</button>
			</div>
		</div>
	</div>

	<div class="nav__backdrop" data-nav-backdrop hidden aria-hidden="true"></div>
</header>

<script>
	const nav = document.querySelector('[data-nav]');
	if (nav) {
		const toggle = nav.querySelector('[data-nav-toggle]');
		const panel = nav.querySelector('[data-nav-panel]');
		const dropdowns = Array.from(nav.querySelectorAll('[data-nav-dropdown]'));

		const setOpen = (open: boolean) => {
			toggle?.setAttribute('aria-expanded', String(open));
			toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			nav.classList.toggle('is-open', open);
			document.body.classList.toggle('nav-open', open);
			const backdrop = nav.querySelector('[data-nav-backdrop]') as HTMLElement | null;
			if (backdrop) backdrop.hidden = !open;
			if (!open) closeDropdowns();
		};

		const openDropdown = (dropdown: Element) => {
			closeDropdowns();
			dropdown.classList.add('is-open');
			const trigger = dropdown.querySelector('[data-nav-dropdown-trigger]') as HTMLElement | null;
			const menu = dropdown.querySelector('.nav__dropdown') as HTMLElement | null;
			trigger?.setAttribute('aria-expanded', 'true');
			if (menu) menu.hidden = false;
		};

		const closeDropdown = (dropdown: Element) => {
			dropdown.classList.remove('is-open');
			const trigger = dropdown.querySelector('[data-nav-dropdown-trigger]') as HTMLElement | null;
			const menu = dropdown.querySelector('.nav__dropdown') as HTMLElement | null;
			trigger?.setAttribute('aria-expanded', 'false');
			if (menu) menu.hidden = true;
		};

		const closeDropdowns = () => {
			dropdowns.forEach((dropdown) => closeDropdown(dropdown));
		};

		const toggleDropdown = (dropdown: Element) => {
			if (dropdown.classList.contains('is-open')) {
				closeDropdown(dropdown);
				return;
			}
			openDropdown(dropdown);
		};

		const isDesktop = () => window.matchMedia('(min-width: 901px)').matches;

		dropdowns.forEach((dropdown) => {
			const trigger = dropdown.querySelector('[data-nav-dropdown-trigger]');

			trigger?.addEventListener('click', (event) => {
				event.stopPropagation();
				toggleDropdown(dropdown);
			});

			dropdown.addEventListener('mouseenter', () => {
				if (!isDesktop()) return;
				openDropdown(dropdown);
			});

			dropdown.addEventListener('mouseleave', () => {
				if (!isDesktop()) return;
				closeDropdown(dropdown);
			});
		});

		document.addEventListener('click', (event) => {
			if (!(event.target instanceof Element)) return;
			if (!nav.contains(event.target)) closeDropdowns();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				closeDropdowns();
				if (nav.classList.contains('is-open')) setOpen(false);
			}
		});

		toggle?.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		panel?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		nav.addEventListener('click', (event) => {
			const target = event.target as Element;
			if (nav.classList.contains('is-open') && target.hasAttribute('data-nav-backdrop')) {
				setOpen(false);
			}
		});

		const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 12);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}
</script>

<style is:global>
	:root {
		--nav-stack-height: 5.35rem;
		--nav-enlisted-purple: #a56bff;
		--nav-enlisted-gold: #d4a259;
		--nav-shop-bg: rgba(42, 32, 22, 0.92);
	}

	body.nav-open {
		overflow: hidden;
	}

	.nav:not(.nav--overlay) + main,
	.nav:not(.nav--overlay) + .page {
		padding-top: calc(var(--nav-stack-height) + env(safe-area-inset-top, 0px));
	}

	.nav .lang-switcher__toggle {
		padding: 0.28rem 0.55rem;
		border-radius: 0.2rem;
		border-color: rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.04);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.nav .lang-switcher__panel {
		border-radius: 0.35rem;
		border-color: rgba(255, 255, 255, 0.12);
		background: rgba(12, 12, 12, 0.98);
	}
</style>

<style>
	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 90;
		pointer-events: none;
	}

	.nav__shell {
		width: min(100% - (var(--page-gutter) * 2), 1280px);
		margin: 0 auto;
	}

	.nav__utility,
	.nav__main,
	.nav__backdrop {
		pointer-events: auto;
	}

	.nav__utility {
		background: #080808;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.nav__utility-inner {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		min-height: 1.85rem;
		padding-block: 0.15rem;
	}

	.nav__utility-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 0.12rem;
		background: rgba(255, 255, 255, 0.08);
		text-decoration: none;
	}

	.nav__utility-g {
		font-size: 0.72rem;
		font-weight: 800;
		line-height: 1;
		color: rgba(255, 255, 255, 0.72);
	}

	.nav__utility-links {
		display: flex;
		align-items: center;
		gap: 0.95rem;
	}

	.nav__utility-dropdown {
		position: relative;
	}

	.nav__utility-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0;
		border: 0;
		background: transparent;
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.55);
		text-decoration: none;
		cursor: pointer;
		transition: color 0.2s ease;
	}

	.nav__utility-link:hover,
	.nav__utility-dropdown.is-open .nav__utility-link--menu {
		color: rgba(255, 255, 255, 0.88);
	}

	.nav__utility-chevron {
		width: 0;
		height: 0;
		border-left: 0.22rem solid transparent;
		border-right: 0.22rem solid transparent;
		border-top: 0.28rem solid currentColor;
		opacity: 0.75;
		transform: translateY(1px);
	}

	.nav__utility-dropdown.is-open .nav__utility-chevron {
		transform: rotate(180deg) translateY(-1px);
	}

	.nav__utility-ext {
		width: 0.55rem;
		height: 0.55rem;
		border-top: 1px solid currentColor;
		border-right: 1px solid currentColor;
		transform: rotate(45deg) translate(-1px, 1px);
		opacity: 0.65;
	}

	.nav__dropdown--utility {
		left: 0;
		min-width: 10.5rem;
		padding: 0.25rem 0;
		border: 0;
		background: rgba(18, 18, 18, 0.98);
		box-shadow: 0 16px 32px rgba(0, 0, 0, 0.45);
	}

	.nav__utility-right {
		margin-left: auto;
	}

	.nav__utility-lang {
		display: none;
	}

	.nav__main {
		background: rgba(18, 22, 28, 0.62);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		backdrop-filter: blur(12px);
		transition:
			background 0.25s ease,
			border-color 0.25s ease;
	}

	.nav.is-scrolled .nav__main {
		background: rgba(12, 14, 18, 0.94);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	.nav__main-inner {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		min-height: 3.5rem;
	}

	.nav__brand {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
		color: var(--color-ink);
		text-decoration: none;
	}

	.nav__brand-logo {
		display: block;
		width: auto;
		height: 1.85rem;
		max-width: 8.5rem;
		object-fit: contain;
	}

	.nav__menu {
		flex: 1;
		min-width: 0;
	}

	.nav__list {
		display: flex;
		align-items: stretch;
		justify-content: flex-start;
		gap: 0.15rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav__item {
		display: flex;
		align-items: stretch;
		position: relative;
	}

	.nav__link,
	.nav__trigger {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 3.5rem;
		padding: 0 0.85rem;
		border: 0;
		background: transparent;
		color: rgba(255, 255, 255, 0.92);
		font: inherit;
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		text-transform: none;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}

	.nav__link:hover,
	.nav__trigger:hover,
	.nav__item--dropdown.is-open > .nav__trigger {
		background: rgba(255, 255, 255, 0.05);
		color: #fff;
	}

	.nav__link.is-active,
	.nav__trigger.is-active {
		color: #fff;
	}

	.nav__link--purple,
	.nav__link--purple:hover,
	.nav__link--purple.is-active {
		color: var(--nav-enlisted-purple);
	}

	.nav__chevron {
		width: 0;
		height: 0;
		border-left: 0.24rem solid transparent;
		border-right: 0.24rem solid transparent;
		border-top: 0.3rem solid currentColor;
		opacity: 0.8;
		transform: translateY(1px);
		transition: transform 0.2s ease;
	}

	.nav__chevron--gold {
		border-top-color: var(--nav-enlisted-gold);
	}

	.nav__shop.is-open .nav__chevron--gold,
	.nav__item--dropdown.is-open .nav__chevron {
		transform: rotate(180deg) translateY(-1px);
	}

	.nav__dropdown {
		position: absolute;
		top: 100%;
		left: 0;
		z-index: 5;
		min-width: 11.5rem;
		padding: 0.35rem 0;
		border: 0;
		background: rgba(18, 18, 18, 0.98);
		box-shadow: 0 18px 36px rgba(0, 0, 0, 0.45);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(0);
		transition:
			opacity 0.16s ease,
			visibility 0.16s ease;
	}

	.nav__utility-dropdown.is-open .nav__dropdown,
	.nav__item--dropdown.is-open .nav__dropdown,
	.nav__shop.is-open .nav__dropdown {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}

	.nav__dropdown-link {
		display: block;
		padding: 0.55rem 1rem;
		color: rgba(255, 255, 255, 0.86);
		font-size: 0.82rem;
