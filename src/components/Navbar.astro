---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getUi } from '../data/i18n';
import { getLocalizedPath, getNavForLocale, type PageId } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { siteConfig } from '../data/site';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
	overlay?: boolean;
}

const { locale = defaultLocale, pageId = 'home', overlay = false } = Astro.props;
const ui = getUi(locale);
const navLinks = getNavForLocale(locale, ui.nav);
const ctaLabel = ui.nav.buyNow;
const current = Astro.url.pathname;

const isActive = (href: string, linkPageId?: PageId) => {
	if (linkPageId === 'home') {
		return current === href || current === `/${locale}/` || current === '/';
	}
	if (href === '/reviews/') {
		return current === '/reviews/' || current.startsWith('/reviews/');
	}
	if (linkPageId === 'hacks') {
		return (
			current === href ||
			current.startsWith(href) ||
			current.startsWith('/enlisted-cheats')
		);
	}
	return current === href || current.startsWith(href);
};
---

<header class:list={['nav', { 'nav--overlay': overlay }]} data-nav>
	<div class="nav__backdrop" data-nav-backdrop hidden aria-hidden="true"></div>
	<div class="nav__bar">
		<nav class="nav__links" id="nav-panel" data-nav-panel aria-label="Primary">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class:list={['nav__link', { 'is-active': isActive(link.href, link.pageId) }]}
					>
						<span class="nav__link-glow" aria-hidden="true"></span>
						<span class="nav__link-text">{link.label}</span>
					</a>
				))
			}
			<a href={siteConfig.checkoutUrl} class="nav__cta nav__cta--mobile btn-buy" rel="noopener noreferrer">
				{ctaLabel}
			</a>
		</nav>

		<div class="nav__actions">
			<a
				href={siteConfig.checkoutUrl}
				class="nav__cta btn-buy"
				rel="noopener noreferrer"
			>
				{ctaLabel}
			</a>
			<LanguageSwitcher pageId={pageId} currentLocale={locale} />
			<button
				type="button"
				class="nav__toggle"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="nav-panel"
				data-nav-toggle
			>
				<span class="nav__toggle-icon" aria-hidden="true"></span>
			</button>
		</div>
	</div>
</header>

<script>
	const nav = document.querySelector('[data-nav]');
	if (nav) {
		const toggle = nav.querySelector('[data-nav-toggle]');
		const panel = nav.querySelector('[data-nav-panel]');

		const setOpen = (open: boolean) => {
			toggle?.setAttribute('aria-expanded', String(open));
			toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			nav.classList.toggle('is-open', open);
			document.body.classList.toggle('nav-open', open);
			const backdrop = nav.querySelector('[data-nav-backdrop]') as HTMLElement | null;
			if (backdrop) backdrop.hidden = !open;
		};

		toggle?.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		panel?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && nav.classList.contains('is-open')) {
				setOpen(false);
			}
		});

		nav.addEventListener('click', (event) => {
			const target = event.target as Element;
			if (nav.classList.contains('is-open') && target.hasAttribute('data-nav-backdrop')) {
				setOpen(false);
			}
		});

		const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 8);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}
</script>

<style is:global>
	body.nav-open {
		overflow: hidden;
	}
</style>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 80;
		padding: 0.65rem var(--page-gutter) 0;
		padding-top: calc(0.65rem + env(safe-area-inset-top, 0px));
		pointer-events: none;
	}

	.nav--overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 90;
		padding-top: calc(0.45rem + env(safe-area-inset-top, 0px));
	}

	.nav--overlay .nav__bar {
		background: rgba(8, 6, 4, 0.42);
		border-color: rgba(255, 255, 255, 0.08);
	}

	.nav--overlay.is-scrolled .nav__bar {
		background: rgba(8, 6, 4, 0.82);
	}

	.nav__bar {
		display: flex;
		align-items: center;
		gap: 1rem;
		width: min(100%, var(--page-max));
		margin: 0 auto;
		padding: 0.45rem 0.65rem;
		border-radius: 0.85rem;
		border: 1px solid rgba(255, 255, 255, 0.06);
		background: rgba(10, 28, 29, 0.42);
		backdrop-filter: blur(18px) saturate(1.1);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
		pointer-events: auto;
		transition:
			background 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	.nav.is-scrolled .nav__bar {
		background: rgba(10, 28, 29, 0.72);
		border-color: rgba(255, 255, 255, 0.08);
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.22);
	}

	.nav__links {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.2rem;
		flex: 1;
		min-width: 0;
	}

	.nav__link {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.42rem 0.72rem;
		border-radius: 0.5rem;
		border: 1px solid transparent;
		color: rgba(255, 255, 255, 0.58);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		white-space: nowrap;
		overflow: hidden;
		isolation: isolate;
		transition:
			color 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.nav__link-text {
		position: relative;
		z-index: 1;
	}

	.nav__link-glow {
		display: none;
	}

	.nav__link:hover {
		color: rgba(255, 255, 255, 0.88);
		background: rgba(255, 255, 255, 0.04);
		border-color: rgba(255, 255, 255, 0.06);
	}

	.nav__link.is-active {
		color: var(--color-ink);
		font-weight: 600;
		background: rgba(32, 191, 192, 0.06);
		border-color: rgba(32, 191, 192, 0.12);
	}

	.nav__link.is-active .nav__link-glow {
		display: none;
	}

	.nav__actions {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
	}

	.nav__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		min-height: 2.15rem;
		padding: 0.45rem 0.9rem;
		border-radius: 0.55rem;
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.03em;
		white-space: nowrap;
		text-decoration: none;
	}

	.nav__cta:hover {
		color: #ffffff;
	}

	.nav__toggle {
		display: none;
		place-items: center;
		width: 2.15rem;
		height: 2.15rem;
		flex-shrink: 0;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 0.5rem;
		background: rgba(255, 255, 255, 0.04);
		color: var(--color-ink);
		cursor: pointer;
		transition:
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.nav__toggle:hover {
		background: rgba(32, 191, 192, 0.1);
		border-color: rgba(32, 191, 192, 0.2);
	}

	.nav__toggle-icon,
	.nav__toggle-icon::before,
	.nav__toggle-icon::after {
		display: block;
		width: 16px;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
		transition:
			transform 0.25s ease,
			opacity 0.2s ease;
	}

	.nav__toggle-icon {
		position: relative;
	}

	.nav__toggle-icon::before,
	.nav__toggle-icon::after {
		content: '';
		position: absolute;
		left: 0;
	}

	.nav__toggle-icon::before {
		top: -5px;
	}

	.nav__toggle-icon::after {
		top: 5px;
	}

	.nav__toggle[aria-expanded='true'] .nav__toggle-icon {
		background: transparent;
	}

	.nav__toggle[aria-expanded='true'] .nav__toggle-icon::before {
		top: 0;
		transform: rotate(45deg);
	}

	.nav__toggle[aria-expanded='true'] .nav__toggle-icon::after {
		top: 0;
		transform: rotate(-45deg);
	}

	.nav__backdrop {
		display: none;
	}

	@media (max-width: 1024px) {
		.nav__link {
			padding: 0.38rem 0.55rem;
			font-size: 0.76rem;
		}
	}

	@media (max-width: 900px) {
		.nav__backdrop {
			display: block;
			position: fixed;
			inset: 0;
			z-index: 0;
			border: 0;
			padding: 0;
			margin: 0;
			background: rgba(6, 17, 18, 0.55);
			backdrop-filter: blur(6px);
			cursor: pointer;
		}

		.nav__backdrop[hidden] {
			display: none;
		}

		.nav__bar {
			position: relative;
			z-index: 2;
			gap: 0.65rem;
			padding: 0.45rem 0.55rem;
		}

		.nav__links {
			position: fixed;
			inset: 0;
			z-index: 1;
			display: grid;
			align-content: start;
			gap: 0.35rem;
			width: min(calc(100% - (var(--page-gutter) * 2)), 20rem);
			max-height: calc(100dvh - 5.5rem - env(safe-area-inset-top, 0px));
			height: fit-content;
			margin: calc(4.25rem + env(safe-area-inset-top, 0px)) auto 1.5rem;
			padding: 0.65rem;
			border-radius: 0.85rem;
			border: 1px solid rgba(255, 255, 255, 0.08);
			background: rgba(10, 28, 29, 0.94);
			backdrop-filter: blur(20px);
			box-shadow: 0 20px 48px rgba(0, 0, 0, 0.35);
			overflow-y: auto;
			overscroll-behavior: contain;
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transform: translateY(-8px);
			transition:
				opacity 0.2s ease,
				transform 0.2s ease,
				visibility 0.2s ease;
		}

		.nav.is-open .nav__links {
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: translateY(0);
		}

		.nav__link {
			justify-content: flex-start;
			padding: 0.85rem 1rem;
			border-radius: 0.6rem;
			font-size: 0.95rem;
			min-height: var(--touch-min);
		}

		.nav__toggle {
			display: grid;
			min-width: var(--touch-min);
			min-height: var(--touch-min);
		}

		.nav__cta {
			display: none;
		}

		.nav__cta--mobile {
			display: inline-flex;
			justify-content: center;
			width: 100%;
			margin-top: 0.35rem;
			min-height: var(--touch-min);
			padding: 0.85rem 1rem;
			font-size: 0.95rem;
			border-radius: 0.6rem;
		}
	}

	@media (min-width: 901px) {
		.nav__cta--mobile {
			display: none;
		}
	}

	@media (max-width: 420px) {
		.nav {
			padding-inline: 0.65rem;
		}
	}
</style>
