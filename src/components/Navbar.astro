---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getUi } from '../data/i18n';
import { getLocalizedPath, type PageId } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { enlistedScreenshots } from '../data/enlisted';
import { productInfo, siteConfig } from '../data/site';
import { contentSrc, contentSrcSet, galleryTileSizes } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
	overlay?: boolean;
}

const { locale = defaultLocale, pageId = 'home', overlay = false } = Astro.props;
const ui = getUi(locale);
const current = Astro.url.pathname;
const homeHref = getLocalizedPath('home', locale);
const cheatsHref = getLocalizedPath('hacks', locale);
const supportHref = getLocalizedPath('support', locale);
const shopLabel = 'Shop';
const pricingHref = getLocalizedPath('pricing', locale);

const shopCards = [
	{
		title: `${productInfo.plans[0].label} — $${productInfo.plans[0].price}`,
		description:
			'ESP, aimbot, wallhack, and radar for 30 days. Anti-cheat updates while your license is active.',
		href: siteConfig.checkoutUrl,
		image: enlistedScreenshots.mainMenu.src,
		alt: enlistedScreenshots.mainMenu.alt,
	},
	{
		title: `${productInfo.plans[1].label} — $${productInfo.plans[1].price}`,
		description:
			'One-time purchase with no renewals. Full feature stack and anti-cheat updates for as long as you play.',
		href: siteConfig.checkoutUrl,
		image: enlistedScreenshots.espOverlay.src,
		alt: enlistedScreenshots.espOverlay.alt,
	},
] as const;

const gameLinks = [
	{ label: ui.nav.features, href: getLocalizedPath('features', locale), pageId: 'features' as PageId },
	{ label: ui.nav.esp, href: getLocalizedPath('enlisted-esp', locale), pageId: 'enlisted-esp' as PageId },
	{ label: ui.nav.aimbot, href: getLocalizedPath('enlisted-aimbot', locale), pageId: 'enlisted-aimbot' as PageId },
	{ label: 'Wallhack', href: getLocalizedPath('wallhack', locale), pageId: 'wallhack' as PageId },
	{ label: 'Radar', href: getLocalizedPath('radar', locale), pageId: 'radar' as PageId },
];

const communityLinks = [
	{ label: 'Blog', href: '/blog/' },
	{ label: 'Guides', href: '/guides/' },
	{ label: ui.nav.reviews ?? 'Reviews', href: '/reviews/' },
	{ label: ui.nav.faq, href: getLocalizedPath('faq', locale), pageId: 'faq' as PageId },
];

const mainLinks = [
	{ label: ui.nav.home, href: homeHref, pageId: 'home' as PageId, accent: false },
	{ label: ui.nav.cheats ?? 'Cheats', href: cheatsHref, pageId: 'hacks' as PageId, accent: true },
	{ label: ui.nav.updates, href: getLocalizedPath('updates', locale), pageId: 'updates' as PageId, accent: false },
	{ label: ui.nav.pricing, href: getLocalizedPath('pricing', locale), pageId: 'pricing' as PageId, accent: false },
];

function pathMatches(href: string, id?: PageId) {
	if (id === 'home') return current === href || current === `/${locale}/` || current === '/';
	if (id === 'hacks') {
		return current === href || current.startsWith(href) || current.startsWith('/enlisted-cheats');
	}
	if (href === '/reviews/') return current.startsWith('/reviews/');
	if (href === '/blog/') return current.startsWith('/blog/');
	if (href === '/guides/') return current.startsWith('/guides/');
	return current === href || current.startsWith(href);
}

const gameActive = gameLinks.some((link) => pathMatches(link.href, link.pageId));
const communityActive = communityLinks.some((link) => pathMatches(link.href, link.pageId));
---

<header class:list={['nav', { 'nav--overlay': overlay }]} data-nav>
	<div class="nav__backdrop" data-nav-backdrop hidden aria-hidden="true"></div>

	<div class="nav__shell">
		<div class="nav__utility" aria-label="Utility">
			<a href={homeHref} class="nav__utility-logo" aria-label={siteConfig.name}>
				<img src={siteConfig.logoRaster} alt="" width="28" height="28" decoding="async" />
			</a>
			<nav class="nav__utility-links" aria-label="Quick links">
				<a href={cheatsHref} class:list={['nav__utility-link', { 'is-active': pathMatches(cheatsHref, 'hacks') }]}>
					{ui.nav.cheats ?? 'Cheats'}
				</a>
				<a href={supportHref} class="nav__utility-link nav__utility-link--external">
					Support
					<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path
							d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6h-2v6H5V5z"
							fill="currentColor"></path>
					</svg>
				</a>
			</nav>
		</div>

		<div class="nav__main">
			<a href={homeHref} class="nav__brand" aria-label={siteConfig.name}>
				<svg class="nav__brand-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
					<path
						d="M32 6l8 12 14 2-10 10 2 14-14-8-14 8 2-14L10 20l14-2L32 6z"
						fill="rgba(255,255,255,0.92)"></path>
					<path d="M12 44h40" stroke="rgba(240,192,96,0.85)" stroke-width="3" stroke-linecap="round"></path>
					<path d="M18 38l14 10 14-10" stroke="rgba(240,192,96,0.65)" stroke-width="2.5" fill="none"></path>
				</svg>
				<span class="nav__brand-text">Enlisted</span>
			</a>

			<nav class="nav__menu" id="nav-panel" data-nav-panel aria-label="Primary">
				{
					mainLinks.map((link) => (
						<a
							href={link.href}
							class:list={[
								'nav__menu-link',
								{
									'is-active': pathMatches(link.href, link.pageId),
									'is-accent': link.accent && pathMatches(link.href, link.pageId),
									'nav__menu-link--accent': link.accent,
								},
							]}
						>
							{link.label}
						</a>
					))
				}

				<details class="nav__dropdown" open={gameActive ? true : undefined}>
					<summary class:list={['nav__menu-link', 'nav__menu-link--dropdown', { 'is-active': gameActive }]}>
						Game
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path d="M7 10l5 5 5-5H7z" fill="currentColor"></path>
						</svg>
					</summary>
					<div class="nav__dropdown-panel">
						{
							gameLinks.map((link) => (
								<a
									href={link.href}
									class:list={['nav__dropdown-link', { 'is-active': pathMatches(link.href, link.pageId) }]}
								>
									{link.label}
								</a>
							))
						}
					</div>
				</details>

				<details class="nav__dropdown" open={communityActive ? true : undefined}>
					<summary class:list={['nav__menu-link', 'nav__menu-link--dropdown', { 'is-active': communityActive }]}>
						Community
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path d="M7 10l5 5 5-5H7z" fill="currentColor"></path>
						</svg>
					</summary>
					<div class="nav__dropdown-panel">
						{
							communityLinks.map((link) => (
								<a
									href={link.href}
									class:list={['nav__dropdown-link', { 'is-active': pathMatches(link.href, link.pageId) }]}
								>
									{link.label}
								</a>
							))
						}
					</div>
				</details>

				<a href={siteConfig.checkoutUrl} class="nav__shop nav__shop--mobile" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path d="M12 2l2.2 6.8H21l-5.5 4 2.1 6.7L12 15.8 6.4 19.5l2.1-6.7L3 8.8h6.8L12 2z" fill="currentColor"></path>
					</svg>
					{shopLabel}
				</a>
				<a href={pricingHref} class="nav__menu-link nav__menu-link--shop-mobile">
					{ui.nav.pricing}
				</a>
			</nav>

			<div class="nav__actions">
				<div class="nav__shop-wrap" data-nav-shop>
					<a
						href={siteConfig.checkoutUrl}
						class="nav__shop nav__shop-trigger"
						rel="noopener noreferrer"
						aria-haspopup="true"
						aria-expanded="false"
						data-nav-shop-trigger
					>
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path d="M12 2l2.2 6.8H21l-5.5 4 2.1 6.7L12 15.8 6.4 19.5l2.1-6.7L3 8.8h6.8L12 2z" fill="currentColor"></path>
						</svg>
						{shopLabel}
						<svg class="nav__shop-caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path d="M7 10l5 5 5-5H7z" fill="currentColor"></path>
						</svg>
					</a>
					<div class="nav__shop-mega" role="region" aria-label={shopLabel} data-nav-shop-panel>
						<div class="nav__shop-mega-grid">
							{
								shopCards.map((card) => (
									<a href={card.href} class="nav__shop-card" rel="noopener noreferrer">
										<div class="nav__shop-card-media">
											<img
												src={contentSrc(card.image)}
												srcset={contentSrcSet(card.image)}
												sizes={galleryTileSizes}
												alt={card.alt}
												width="640"
												height="400"
												loading="lazy"
												decoding="async"
											/>
											<span class="nav__shop-card-icon" aria-hidden="true">
												<svg viewBox="0 0 24 24" focusable="false">
													<path
														d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6h-2v6H5V5z"
														fill="currentColor"></path>
												</svg>
											</span>
										</div>
										<div class="nav__shop-card-body">
											<h3 class="nav__shop-card-title">{card.title}</h3>
											<p class="nav__shop-card-desc">{card.description}</p>
										</div>
									</a>
								))
							}
						</div>
						<a href={pricingHref} class="nav__shop-mega-foot">
							{ui.hero.viewPricing ?? ui.nav.pricing}
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" fill="currentColor"></path>
							</svg>
						</a>
					</div>
				</div>
				<LanguageSwitcher pageId={pageId} currentLocale={locale} />
				<button
					type="button"
					class="nav__toggle"
					aria-label="Open menu"
					aria-expanded="false"
					aria-controls="nav-panel"
					data-nav-toggle
				>
					<span class="nav__toggle-icon" aria-hidden="true"></span>
				</button>
			</div>
		</div>
	</div>
</header>

<script>
	const nav = document.querySelector('[data-nav]');
	if (nav) {
		const toggle = nav.querySelector('[data-nav-toggle]');
		const panel = nav.querySelector('[data-nav-panel]');

		const setOpen = (open: boolean) => {
			toggle?.setAttribute('aria-expanded', String(open));
			toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			nav.classList.toggle('is-open', open);
			document.body.classList.toggle('nav-open', open);
			const backdrop = nav.querySelector('[data-nav-backdrop]') as HTMLElement | null;
			if (backdrop) backdrop.hidden = !open;
		};

		toggle?.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		panel?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && nav.classList.contains('is-open')) {
				setOpen(false);
			}
		});

		nav.addEventListener('click', (event) => {
			const target = event.target as Element;
			if (nav.classList.contains('is-open') && target.hasAttribute('data-nav-backdrop')) {
			 setOpen(false);
			}
		});

		const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 8);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		nav.querySelectorAll('.nav__dropdown').forEach((dropdown) => {
			dropdown.addEventListener('toggle', () => {
				if (!(dropdown as HTMLDetailsElement).open) return;
				nav.querySelectorAll('.nav__dropdown').forEach((other) => {
					if (other !== dropdown) (other as HTMLDetailsElement).open = false;
				});
			});
		});

		const shopWrap = nav.querySelector('[data-nav-shop]');
		const shopTrigger = nav.querySelector('[data-nav-shop-trigger]') as HTMLAnchorElement | null;
		const shopPanel = nav.querySelector('[data-nav-shop-panel]') as HTMLElement | null;

		const setShopOpen = (open: boolean) => {
			if (!shopWrap || !shopTrigger) return;
			shopWrap.classList.toggle('is-open', open);
			shopTrigger.setAttribute('aria-expanded', String(open));
		};

		if (shopWrap && shopTrigger && shopPanel) {
			let closeTimer: ReturnType<typeof setTimeout> | undefined;

			const openShop = () => {
				clearTimeout(closeTimer);
				setShopOpen(true);
			};

			const scheduleClose = () => {
				clearTimeout(closeTimer);
				closeTimer = setTimeout(() => setShopOpen(false), 120);
			};

			shopWrap.addEventListener('mouseenter', openShop);
			shopWrap.addEventListener('mouseleave', scheduleClose);
			shopWrap.addEventListener('focusin', openShop);
			shopWrap.addEventListener('focusout', (event) => {
				if (!shopWrap.contains((event as FocusEvent).relatedTarget as Node)) {
					scheduleClose();
				}
			});
		}
	}
</script>

<style is:global>
	body.nav-open {
		overflow: hidden;
	}

	.nav .lang-switcher__toggle {
		border-color: rgba(255, 255, 255, 0.14);
		background: rgba(0, 0, 0, 0.35);
		color: rgba(255, 255, 255, 0.88);
		border-radius: 0.2rem;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.nav .lang-switcher__panel {
		border-color: rgba(255, 255, 255, 0.12);
		background: rgba(18, 16, 14, 0.98);
	}
</style>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		pointer-events: none;
	}

	.nav--overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
	}

	.nav__shell {
		pointer-events: auto;
	}

	.nav__utility {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-height: 2rem;
		padding: 0.35rem var(--page-gutter);
		padding-top: calc(0.35rem + env(safe-area-inset-top, 0px));
		background: rgba(0, 0, 0, 0.92);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.nav__utility-logo {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 0.15rem;
		background: rgba(255, 255, 255, 0.06);
	}

	.nav__utility-logo img {
		width: 1.35rem;
		height: 1.35rem;
		object-fit: contain;
	}

	.nav__utility-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.nav__utility-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.nav__utility-link svg {
		width: 0.85rem;
		height: 0.85rem;
		opacity: 0.75;
	}

	.nav__utility-link:hover,
	.nav__utility-link.is-active {
		color: #fff;
	}

	.nav__main {
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1rem;
		min-height: 3.35rem;
		padding: 0.35rem var(--page-gutter);
		background: rgba(8, 6, 4, 0.55);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(10px);
		transition:
			background 0.25s ease,
			border-color 0.25s ease;
	}

	.nav.is-scrolled .nav__main,
	.nav--overlay.is-scrolled .nav__main {
		background: rgba(8, 6, 4, 0.88);
	}

	.nav__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: #fff;
		text-decoration: none;
		min-width: 0;
	}

	.nav__brand-icon {
		width: 2rem;
		height: 2rem;
		flex-shrink: 0;
	}

	.nav__brand-text {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		line-height: 1;
		white-space: nowrap;
	}

	.nav__menu {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0;
		min-width: 0;
	}

	.nav__menu-link,
	.nav__menu-link--dropdown {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.65rem 0.95rem;
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		border-left: 1px solid rgba(255, 255, 255, 0.08);
		transition:
			color 0.2s ease,
			background 0.2s ease;
		white-space: nowrap;
	}

	.nav__menu > :first-child {
		border-left: 0;
	}

	.nav__menu-link--accent {
		color: #c8a8ff;
	}

	.nav__menu-link--accent.is-accent,
	.nav__menu-link--accent:hover {
		color: #dcc8ff;
	}

	.nav__menu-link:hover,
	.nav__menu-link.is-active,
	.nav__menu-link--dropdown:hover,
	.nav__menu-link--dropdown.is-active {
		color: #fff;
		background: rgba(255, 255, 255, 0.04);
	}

	.nav__menu-link--dropdown {
		list-style: none;
		cursor: pointer;
	}

	.nav__menu-link--dropdown::-webkit-details-marker {
		display: none;
	}

	.nav__menu-link--dropdown svg {
		width: 0.85rem;
		height: 0.85rem;
		opacity: 0.75;
	}

	.nav__dropdown {
		position: relative;
	}

	.nav__dropdown-panel {
		position: absolute;
		top: calc(100% + 1px);
		left: 0;
		z-index: 120;
		min-width: 11rem;
		padding: 0.35rem 0;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(18, 16, 14, 0.98);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
	}

	.nav__dropdown-link {
		display: block;
		padding: 0.65rem 1rem;
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-decoration: none;
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}

	.nav__dropdown-link:hover,
	.nav__dropdown-link.is-active {
		color: #fff;
		background: rgba(255, 255, 255, 0.06);
	}

	.nav__actions {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		flex-shrink: 0;
	}

	.nav__shop {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-height: 2.2rem;
		padding: 0.45rem 0.95rem;
		border: 1px solid rgba(240, 192, 96, 0.55);
		background: rgba(0, 0, 0, 0.28);
		color: #f0c060;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.nav__shop-wrap {
		position: relative;
	}

	.nav__shop-trigger:hover,
	.nav__shop-wrap.is-open .nav__shop-trigger,
	.nav__shop-wrap:focus-within .nav__shop-trigger {
		color: #ffe6a8;
		border-color: rgba(240, 192, 96, 0.85);
		background: rgba(240, 192, 96, 0.08);
	}

	.nav__shop-caret {
		opacity: 0.7;
		transition: transform 0.2s ease;
	}

	.nav__shop-wrap.is-open .nav__shop-caret,
	.nav__shop-wrap:focus-within .nav__shop-caret {
		transform: rotate(180deg);
	}

	.nav__shop-mega {
		position: absolute;
		top: calc(100% + 0.55rem);
		right: 0;
		z-index: 140;
		width: min(42rem, calc(100vw - 2 * var(--page-gutter)));
		padding: 0.85rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(16, 14, 12, 0.97);
		box-shadow: 0 24px 56px rgba(0, 0, 0, 0.55);
		backdrop-filter: blur(12px);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(-6px);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			visibility 0.2s ease;
	}

	.nav__shop-wrap.is-open .nav__shop-mega,
	.nav__shop-wrap:focus-within .nav__shop-mega {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateY(0);
	}

	.nav__shop-mega-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.nav__shop-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
