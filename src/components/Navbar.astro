---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getUi } from '../data/i18n';
import { getLocalizedPath, type PageId } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { enlistedScreenshots } from '../data/enlisted';
import { productInfo, siteConfig } from '../data/site';
import { contentSrc, contentSrcSet, galleryTileSizes } from '../lib/responsive-images';

function shopImageAttrs(src: string) {
	const imageSrc = contentSrc(src);
	const srcset = contentSrcSet(src);
	return { src: imageSrc, ...(srcset ? { srcset } : {}) };
}

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
	overlay?: boolean;
}

const { locale = defaultLocale, pageId = 'home', overlay = false } = Astro.props;
const ui = getUi(locale);
const current = Astro.url.pathname;
const homeHref = getLocalizedPath('home', locale);
const cheatsHref = getLocalizedPath('hacks', locale);
const supportHref = getLocalizedPath('support', locale);
const shopLabel = 'Shop';
const pricingHref = getLocalizedPath('pricing', locale);
const updatesHref = getLocalizedPath('updates', locale);
const featuresHref = getLocalizedPath('features', locale);
const faqHref = getLocalizedPath('faq', locale);
const reviewsHref = '/reviews/';

const utilityLinks = [
	{ label: ui.nav.cheats ?? 'Enlisted Cheats', href: cheatsHref, pageId: 'hacks' as PageId },
	{ label: ui.nav.features, href: featuresHref, pageId: 'features' as PageId },
	{ label: ui.nav.pricing, href: pricingHref, pageId: 'pricing' as PageId },
];

const shopCards = [
	{
		title: `${productInfo.plans[0].label} — $${productInfo.plans[0].price}`,
		description:
			'ESP, aimbot, wallhack, and radar for 30 days. Anti-cheat updates while your license is active.',
		href: siteConfig.checkoutUrl,
		image: enlistedScreenshots.mainMenu.src,
		alt: enlistedScreenshots.mainMenu.alt,
	},
	{
		title: `${productInfo.plans[1].label} — $${productInfo.plans[1].price}`,
		description:
			'One-time purchase with no renewals. Full feature stack and anti-cheat updates for as long as you play.',
		href: siteConfig.checkoutUrl,
		image: enlistedScreenshots.espOverlay.src,
		alt: enlistedScreenshots.espOverlay.alt,
	},
] as const;

const mainLinksBefore = [
	{ label: ui.nav.home, href: homeHref, pageId: 'home' as PageId },
	{ label: ui.nav.cheats ?? 'Cheats', href: cheatsHref, pageId: 'hacks' as PageId },
];

const mainLinksAfter = [
	{ label: ui.nav.updates, href: updatesHref, pageId: 'updates' as PageId },
	{ label: ui.nav.pricing, href: pricingHref, pageId: 'pricing' as PageId },
	{ label: ui.nav.reviews ?? 'Reviews', href: reviewsHref, pageId: undefined },
	{ label: ui.nav.faq, href: faqHref, pageId: 'faq' as PageId },
];

function pathMatches(href: string, id?: PageId) {
	if (id === 'home') return current === href || current === `/${locale}/` || current === '/';
	if (id === 'hacks') {
		return current === href || current.startsWith(href) || current.startsWith('/enlisted-cheats');
	}
	if (href === '/reviews/') return current.startsWith('/reviews/');
	if (href === '/blog/') return current.startsWith('/blog/');
	if (href === '/guides/') return current.startsWith('/guides/');
	return current === href || current.startsWith(href);
}

const featureLinks = [
	{ label: 'All features', href: featuresHref, pageId: 'features' as PageId },
	{ label: ui.nav.esp, href: getLocalizedPath('enlisted-esp', locale), pageId: 'enlisted-esp' as PageId },
	{ label: 'Wallhack', href: getLocalizedPath('wallhack', locale), pageId: 'wallhack' as PageId },
	{ label: ui.nav.aimbot, href: getLocalizedPath('enlisted-aimbot', locale), pageId: 'enlisted-aimbot' as PageId },
	{ label: 'Radar', href: getLocalizedPath('radar', locale), pageId: 'radar' as PageId },
] as const;

function featureLinkActive(linkPageId: PageId): boolean {
	if (pageId === linkPageId) return true;
	const link = featureLinks.find((entry) => entry.pageId === linkPageId);
	if (!link) return false;
	return pathMatches(link.href, linkPageId);
}

const featuresActive = featureLinks.some((link) => featureLinkActive(link.pageId));
---

<header class:list={['nav', { 'nav--overlay': overlay }]} data-nav>
	<div class="nav__backdrop" data-nav-backdrop hidden aria-hidden="true"></div>

	<div class="nav__shell">
		{
			!overlay && (
				<div class="nav__utility" aria-label="Utility">
					<a href={homeHref} class="nav__utility-logo" aria-label={siteConfig.name}>
						<img src={siteConfig.logoRaster} alt={siteConfig.name} width="28" height="28" decoding="async" />
					</a>
					<nav class="nav__utility-links" aria-label="Quick links">
						<div class="nav__utility-dropdown" data-nav-dropdown>
							<button type="button" class="nav__utility-link nav__utility-link--dropdown" aria-expanded="false">
								Cheats
								<svg class="nav__caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									<path d="M7 10l5 5 5-5H7z" fill="currentColor"></path>
								</svg>
							</button>
							<div class="nav__utility-panel">
								{
									utilityLinks.map((link) => (
										<a
											href={link.href}
											class:list={[
												'nav__utility-panel-link',
												{ 'is-active': pathMatches(link.href, link.pageId) },
											]}
										>
											{link.label}
										</a>
									))
								}
							</div>
						</div>
						<a href={supportHref} class="nav__utility-link nav__utility-link--external">
							Support
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path
									d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6h-2v6H5V5z"
									fill="currentColor"></path>
							</svg>
						</a>
					</nav>
				</div>
			)
		}

		<div class="nav__main">
			<a href={homeHref} class="nav__brand" aria-label={siteConfig.name}>
				<img
					src={siteConfig.logoRaster}
					alt=""
					class="nav__brand-mark"
					width={siteConfig.logoRasterWidth}
					height={siteConfig.logoRasterHeight}
					decoding="async"
				/>
			</a>

			<nav class="nav__menu" id="nav-panel" data-nav-panel aria-label="Primary">
				{
					mainLinksBefore.map((link) => (
						<a
							href={link.href}
							class:list={[
								'nav__menu-link',
								{ 'is-active': pathMatches(link.href, link.pageId) },
							]}
						>
							{link.label}
						</a>
					))
				}

				<div class="nav__features-wrap" data-nav-dropdown data-nav-features>
					<a
						href={featuresHref}
						class:list={['nav__menu-link', 'nav__features-trigger', { 'is-active': featuresActive }]}
						aria-haspopup="true"
						aria-expanded="false"
						data-nav-features-trigger
					>
						{ui.nav.features}
						<svg class="nav__caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path d="M7 10l5 5 5-5H7z" fill="currentColor"></path>
						</svg>
					</a>
					<div class="nav__features-panel" role="menu" aria-label={ui.nav.features} data-nav-features-panel>
						{
							featureLinks.map((link) => (
								<a
									href={link.href}
									class:list={[
										'nav__features-panel-link',
										{ 'is-active': featureLinkActive(link.pageId) },
									]}
									role="menuitem"
									aria-current={featureLinkActive(link.pageId) ? 'page' : undefined}
								>
									{link.label}
								</a>
							))
						}
					</div>
				</div>

				{
					mainLinksAfter.map((link) => (
						<a
							href={link.href}
							class:list={[
								'nav__menu-link',
								{ 'is-active': pathMatches(link.href, link.pageId) },
							]}
						>
							{link.label}
						</a>
					))
				}

			</nav>

			<div class="nav__actions">
				<div class="nav__shop-wrap" data-nav-shop data-nav-dropdown>
					<a
						href={siteConfig.checkoutUrl}
						class="nav__shop nav__shop-trigger"
						rel="noopener noreferrer"
						aria-haspopup="true"
						aria-expanded="false"
						data-nav-shop-trigger
					>
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path d="M12 2l2.2 6.8H21l-5.5 4 2.1 6.7L12 15.8 6.4 19.5l2.1-6.7L3 8.8h6.8L12 2z" fill="currentColor"></path>
						</svg>
						<span class="nav__shop-label">{shopLabel}</span>
						<svg class="nav__caret nav__shop-caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path d="M7 10l5 5 5-5H7z" fill="currentColor"></path>
						</svg>
					</a>
					<div class="nav__shop-mega" role="region" aria-label={shopLabel} data-nav-shop-panel>
						<div class="nav__shop-mega-grid">
							{
								shopCards.map((card) => (
									<a href={card.href} class="nav__shop-card" rel="noopener noreferrer">
										<div class="nav__shop-card-media">
											<img
												{...shopImageAttrs(card.image)}
												sizes={galleryTileSizes}
												alt={card.alt}
												width="640"
												height="400"
												loading="lazy"
												decoding="async"
											/>
											<span class="nav__shop-card-icon" aria-hidden="true">
												<svg viewBox="0 0 24 24" focusable="false">
													<path
														d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6h-2v6H5V5z"
														fill="currentColor"></path>
												</svg>
											</span>
										</div>
										<div class="nav__shop-card-body">
											<h3 class="nav__shop-card-title">{card.title}</h3>
											<p class="nav__shop-card-desc">{card.description}</p>
										</div>
									</a>
								))
							}
						</div>
					</div>
				</div>

				<LanguageSwitcher pageId={pageId} currentLocale={locale} />
				<button
					type="button"
					class="nav__toggle"
					aria-label="Open menu"
					aria-expanded="false"
					aria-controls="nav-panel"
					data-nav-toggle
				>
					<span class="nav__toggle-icon" aria-hidden="true"></span>
				</button>
			</div>
		</div>
	</div>
</header>

<script>
	const nav = document.querySelector('[data-nav]');
	if (nav) {
		const toggle = nav.querySelector('[data-nav-toggle]');
		const panel = nav.querySelector('[data-nav-panel]');

		const setOpen = (open: boolean) => {
			toggle?.setAttribute('aria-expanded', String(open));
			toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			nav.classList.toggle('is-open', open);
			document.body.classList.toggle('nav-open', open);
			const backdrop = nav.querySelector('[data-nav-backdrop]') as HTMLElement | null;
			if (backdrop) backdrop.hidden = !open;
		};

		toggle?.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		panel?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		nav.addEventListener('click', (event) => {
			const target = event.target as Element;
			if (nav.classList.contains('is-open') && target.hasAttribute('data-nav-backdrop')) {
			 setOpen(false);
			}
		});

		const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 8);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		const closeAllDropdowns = (except?: Element | null) => {
			nav.querySelectorAll('[data-nav-dropdown]').forEach((dropdown) => {
				if (except && dropdown === except) return;
				dropdown.classList.remove('is-open');
				dropdown.querySelector('[aria-expanded]')?.setAttribute('aria-expanded', 'false');
			});
		};

		const bindShopDropdown = (dropdown: Element) => {
			const trigger = dropdown.querySelector('[data-nav-shop-trigger]') as HTMLElement | null;
			if (!trigger) return;

			let closeTimer: ReturnType<typeof setTimeout> | undefined;

			const setDropdownOpen = (open: boolean) => {
				clearTimeout(closeTimer);
				if (open) {
					closeAllDropdowns(dropdown);
					dropdown.classList.add('is-open');
					trigger.setAttribute('aria-expanded', 'true');
				} else {
					dropdown.classList.remove('is-open');
					trigger.setAttribute('aria-expanded', 'false');
				}
			};

			const scheduleClose = () => {
				clearTimeout(closeTimer);
				closeTimer = setTimeout(() => setDropdownOpen(false), 140);
			};

			if (window.matchMedia('(min-width: 961px)').matches) {
				dropdown.addEventListener('mouseenter', () => setDropdownOpen(true));
				dropdown.addEventListener('mouseleave', scheduleClose);
				dropdown.addEventListener('focusin', () => setDropdownOpen(true));
				dropdown.addEventListener('focusout', (event) => {
					if (!dropdown.contains((event as FocusEvent).relatedTarget as Node)) {
						scheduleClose();
					}
				});
			} else {
				trigger.addEventListener('click', (event) => {
					event.preventDefault();
					const isOpen = dropdown.classList.contains('is-open');
					closeAllDropdowns();
					setDropdownOpen(!isOpen);
				});
			}
		};

		const bindFeaturesDropdown = (dropdown: Element) => {
			const trigger = dropdown.querySelector('[data-nav-features-trigger]') as HTMLElement | null;
			if (!trigger) return;

			let closeTimer: ReturnType<typeof setTimeout> | undefined;

			const setDropdownOpen = (open: boolean) => {
				clearTimeout(closeTimer);
				if (open) {
					closeAllDropdowns(dropdown);
					dropdown.classList.add('is-open');
					trigger.setAttribute('aria-expanded', 'true');
				} else {
					dropdown.classList.remove('is-open');
					trigger.setAttribute('aria-expanded', 'false');
				}
			};

			const scheduleClose = () => {
				clearTimeout(closeTimer);
				closeTimer = setTimeout(() => setDropdownOpen(false), 140);
			};

			if (window.matchMedia('(min-width: 961px)').matches) {
				dropdown.addEventListener('mouseenter', () => setDropdownOpen(true));
				dropdown.addEventListener('mouseleave', scheduleClose);
				dropdown.addEventListener('focusin', () => setDropdownOpen(true));
				dropdown.addEventListener('focusout', (event) => {
					if (!dropdown.contains((event as FocusEvent).relatedTarget as Node)) {
						scheduleClose();
					}
				});
			} else {
				trigger.addEventListener('click', (event) => {
					event.preventDefault();
					const isOpen = dropdown.classList.contains('is-open');
					closeAllDropdowns();
					setDropdownOpen(!isOpen);
				});
			}
		};

		const bindUtilityDropdown = (dropdown: Element) => {
			const trigger = dropdown.querySelector('button') as HTMLElement | null;
			if (!trigger) return;

			const setDropdownOpen = (open: boolean) => {
				if (open) {
					closeAllDropdowns(dropdown);
					dropdown.classList.add('is-open');
					trigger.setAttribute('aria-expanded', 'true');
				} else {
					dropdown.classList.remove('is-open');
					trigger.setAttribute('aria-expanded', 'false');
				}
			};

			trigger.addEventListener('click', () => {
				const isOpen = dropdown.classList.contains('is-open');
				closeAllDropdowns();
				setDropdownOpen(!isOpen);
			});
		};

		document.addEventListener('click', (event) => {
			const target = event.target as Element;
			if (!nav.contains(target)) {
				closeAllDropdowns();
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				if (nav.classList.contains('is-open')) {
					setOpen(false);
				}
				closeAllDropdowns();
			}
		});

		nav.querySelectorAll('[data-nav-features]').forEach(bindFeaturesDropdown);
		nav.querySelectorAll('[data-nav-shop]').forEach(bindShopDropdown);
		nav.querySelectorAll('.nav__utility-dropdown[data-nav-dropdown]').forEach(bindUtilityDropdown);
	}
</script>

<style is:global>
	body.nav-open {
		overflow: hidden;
	}

	.nav .lang-switcher__toggle {
		border-color: rgba(255, 255, 255, 0.14);
		background: rgba(0, 0, 0, 0.35);
		color: rgba(255, 255, 255, 0.88);
		border-radius: 0.2rem;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.nav .lang-switcher__panel {
		border-color: rgba(255, 255, 255, 0.12);
		background: rgba(18, 16, 14, 0.98);
	}
</style>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		pointer-events: none;
	}

	.nav--overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
	}

	.nav--overlay .nav__main {
		padding-top: calc(0.35rem + env(safe-area-inset-top, 0px));
		background: linear-gradient(
			180deg,
			rgba(13, 17, 18, 0.28) 0%,
			rgba(13, 17, 18, 0.12) 100%
		);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	.nav__shell {
		pointer-events: auto;
	}

	.nav__utility {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-height: 2rem;
		padding: 0.35rem var(--page-gutter);
		padding-top: calc(0.35rem + env(safe-area-inset-top, 0px));
		background: rgba(13, 17, 18, 0.42);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.nav__utility-logo {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 0.15rem;
		background: rgba(255, 255, 255, 0.06);
	}

	.nav__utility-logo img {
		width: 1.35rem;
		height: 1.35rem;
		object-fit: contain;
	}

	.nav__utility-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.nav__utility-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.nav__utility-link svg {
		width: 0.85rem;
		height: 0.85rem;
		opacity: 0.75;
	}

	.nav__utility-link:hover,
	.nav__utility-link.is-active {
		color: #fff;
	}

	.nav__utility-dropdown {
		position: relative;
	}

	.nav__utility-link--dropdown {
		border: 0;
		background: transparent;
		cursor: pointer;
		font: inherit;
	}

	.nav__utility-panel {
		position: absolute;
		top: calc(100% + 0.35rem);
		left: 0;
		z-index: 130;
		min-width: 11rem;
		padding: 0.35rem 0;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(12, 12, 12, 0.98);
		box-shadow: 0 14px 32px rgba(0, 0, 0, 0.45);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(-4px);
		transition:
			opacity 0.18s ease,
			transform 0.18s ease,
			visibility 0.18s ease;
	}

	.nav__utility-dropdown.is-open .nav__utility-panel,
	.nav__utility-dropdown:focus-within .nav__utility-panel {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateY(0);
	}

	.nav__utility-panel-link {
		display: block;
		padding: 0.55rem 1rem;
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}

	.nav__utility-panel-link:hover,
	.nav__utility-panel-link.is-active {
		color: #fff;
		background: rgba(255, 255, 255, 0.06);
	}

	.nav__caret {
		width: 0.85rem;
		height: 0.85rem;
		opacity: 0.75;
		transition: transform 0.2s ease;
	}

	.nav__utility-dropdown.is-open .nav__caret,
	.nav__dropdown.is-open .nav__caret,
	.nav__features-wrap.is-open .nav__caret,
	.nav__shop-wrap.is-open .nav__shop-caret {
		transform: rotate(180deg);
	}

	.nav__main {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: stretch;
		gap: 0;
		min-height: 3.5rem;
		padding: 0 var(--page-gutter);
		background: linear-gradient(
			180deg,
			rgba(13, 17, 18, 0.52) 0%,
			rgba(13, 17, 18, 0.34) 100%
		);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(14px) saturate(1.1);
		-webkit-backdrop-filter: blur(14px) saturate(1.1);
		transition:
			background 0.25s ease,
			border-color 0.25s ease,
			backdrop-filter 0.25s ease;
	}

	.nav.is-scrolled .nav__main,
	.nav--overlay.is-scrolled .nav__main {
		background: linear-gradient(
			180deg,
			rgba(13, 17, 18, 0.78) 0%,
			rgba(13, 17, 18, 0.62) 100%
		);
		border-bottom-color: rgba(255, 255, 255, 0.12);
	}

	.nav--overlay.is-scrolled .nav__main {
		background: linear-gradient(
			180deg,
			rgba(13, 17, 18, 0.68) 0%,
			rgba(13, 17, 18, 0.5) 100%
		);
	}

	.nav__brand {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #fff;
		text-decoration: none;
