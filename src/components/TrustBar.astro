---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const trust = getUi(locale).trust;

const items = [
	{
		key: 'status',
		value: trust.status,
		live: true,
		href: getLocalizedPath('updates', locale),
	},
	{
		key: 'delivery',
		value: trust.delivery,
		live: false,
		href: getLocalizedPath('pricing', locale),
	},
	{
		key: 'platform',
		value: trust.platform,
		live: false,
		href: getLocalizedPath('setup', locale),
	},
	{
		key: 'anticheat',
		value: trust.antiCheatShort,
		live: false,
		href: getLocalizedPath('undetected', locale),
	},
] as const;
---

<section class="trust-strip shell" aria-label="Package status">
	<ul class="trust-strip__list">
		{
			items.map((item) => (
				<li class:list={['trust-strip__item', { 'trust-strip__item--live': item.live }]}>
					<a class="trust-strip__link" href={item.href}>
						{item.live && <span class="trust-strip__pulse" aria-hidden="true" />}
						<span class="trust-strip__text">{item.value}</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.trust-strip {
		padding-block: 0.35rem 0.55rem;
		content-visibility: auto;
		contain-intrinsic-size: 1px 36px;
	}

	.trust-strip__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.trust-strip__item {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.trust-strip__item:not(:first-child)::before {
		content: '';
		display: block;
		width: 3px;
		height: 3px;
		border-radius: 50%;
		margin-inline: 0.7rem 0.85rem;
		background: rgba(32, 191, 192, 0.32);
		flex-shrink: 0;
	}

	.trust-strip__link {
		display: inline-flex;
		align-items: center;
		gap: 0.38rem;
		padding: 0.15rem 0;
		color: rgba(229, 238, 238, 0.72);
		font-size: 0.78rem;
		font-weight: 500;
		line-height: 1.35;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.trust-strip__link:hover {
		color: rgba(255, 255, 255, 0.95);
	}

	.trust-strip__item--live .trust-strip__link {
		color: rgba(32, 191, 192, 0.92);
	}

	.trust-strip__item--live .trust-strip__link:hover {
		color: #20BFC0;
	}

	.trust-strip__pulse {
		width: 0.36rem;
		height: 0.36rem;
		border-radius: 50%;
		background: #20BFC0;
		flex-shrink: 0;
	}

	.trust-strip__text {
		letter-spacing: 0.01em;
	}

	@media (max-width: 520px) {
		.trust-strip__list {
			row-gap: 0.4rem;
			padding-inline: 0.25rem;
		}

		.trust-strip__link {
			font-size: 0.74rem;
		}

		.trust-strip__item:not(:first-child)::before {
			margin-inline: 0.45rem 0.55rem;
		}
	}

	@media (min-width: 521px) and (max-width: 720px) {
		.trust-strip__link {
			font-size: 0.76rem;
		}

		.trust-strip__item:not(:first-child)::before {
			margin-inline: 0.5rem 0.6rem;
		}
	}

	@media (min-width: 901px) {
		.trust-strip {
			padding-block: 0.4rem 0.65rem;
		}

		.trust-strip__link {
			font-size: 0.81rem;
		}

		.trust-strip__item:not(:first-child)::before {
			margin-inline: 0.85rem 0.95rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.trust-strip__pulse {
			animation: trust-pulse 2.4s ease-in-out infinite;
		}
	}

	@keyframes trust-pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.7;
		}
	}
</style>
