---
import { showcaseGameplay } from '../data/enlisted';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { contentSrc, contentSrcSet } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;

const showcaseCards = [
	{
		badge: 'Wallhack',
		badgeTone: 'green',
		title: 'See enemies through cover',
		description:
			'Green wallhack silhouettes reveal infantry behind wooden walls, sandbags, and trench lines.',
		image: showcaseGameplay[0],
		href: getLocalizedPath('wallhack', locale),
	},
	{
		badge: 'ESP',
		badgeTone: 'green',
		title: 'Red soldier ESP overlay',
		description:
			'Bright enemy outlines across open ground so you can track flanks before they push your position.',
		image: showcaseGameplay[1],
		href: getLocalizedPath('enlisted-esp', locale),
	},
	{
		badge: 'Aimbot',
		badgeTone: 'gold',
		title: 'Scoped target highlight',
		description:
			'Purple chams and mark-enemy cues through optics for fast weak-spot shots at range.',
		image: showcaseGameplay[2],
		href: getLocalizedPath('enlisted-aimbot', locale),
	},
	{
		badge: 'Radar',
		badgeTone: 'gold',
		title: 'Radar with skeleton ESP',
		description:
			'Top-down threat map plus skeleton boxes, snaplines, and distance tags in heavy combat.',
		image: showcaseGameplay[3],
		href: getLocalizedPath('radar', locale),
	},
	{
		badge: 'Combat',
		badgeTone: 'green',
		title: 'Soldier icons through terrain',
		description:
			'2D radar and soldier markers that stay visible through hills, smoke, and hard cover.',
		image: showcaseGameplay[4],
		href: getLocalizedPath('features', locale),
	},
] as const;

const scrollCards = [...showcaseCards, ...showcaseCards];
---

<section class="cheat-showcase" aria-labelledby="cheat-showcase-title">
	<div class="cheat-showcase__fade" aria-hidden="true"></div>

	<div class="shell cheat-showcase__inner">
		<header class="cheat-showcase__head">
			<div class="cheat-showcase__head-copy">
				<h2 id="cheat-showcase-title" class="cheat-showcase__title">
					Cheat showcase
					<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" fill="currentColor"></path>
					</svg>
				</h2>
				<p class="cheat-showcase__lead">
					ESP, aimbot, radar, and wallhack screenshots from the live Enlisted Cheats package.
				</p>
			</div>
		</header>

		<div class="cheat-showcase__stage">
			<div class="cheat-showcase__viewport" data-cheat-scroll-viewport>
				<div class="cheat-showcase__track" data-cheat-scroll-track>
					{
						scrollCards.map((card) => {
							const imageSrc = contentSrc(card.image.src);
							const imageSrcSet = contentSrcSet(card.image.src);

							return (
								<article class="cheat-showcase__card">
									<a href={card.href} class="cheat-showcase__card-link">
										<div class="cheat-showcase__media">
											<img
												src={imageSrc}
												{...(imageSrcSet ? { srcset: imageSrcSet } : {})}
												sizes="(max-width: 560px) 78vw, 296px"
												alt={card.image.alt}
												width="530"
												height="320"
												loading="lazy"
												decoding="async"
											/>
										</div>
									<div class="cheat-showcase__body">
										<div class="cheat-showcase__meta">
											<span class:list={['cheat-showcase__badge', `cheat-showcase__badge--${card.badgeTone}`]}>
												{card.badge}
											</span>
											<span class="cheat-showcase__label">Windows PC</span>
										</div>
										<h3 class="cheat-showcase__card-title">{card.title}</h3>
										<p class="cheat-showcase__card-desc">{card.description}</p>
									</div>
								</a>
							</article>
							);
						})
					}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.cheat-showcase {
		position: relative;
		margin-top: -3.5rem;
		padding: 0 0 1.25rem;
		background: linear-gradient(
			180deg,
			rgba(13, 17, 18, 0) 0%,
			rgba(13, 17, 18, 0.72) 8%,
			var(--color-bg) 18%,
			var(--color-bg-secondary) 100%
		);
		isolation: isolate;
	}

	.cheat-showcase__fade {
		position: absolute;
		inset: 0 0 auto;
		height: 6rem;
		background: linear-gradient(
			180deg,
			rgba(13, 17, 18, 0) 0%,
			rgba(13, 17, 18, 0.55) 55%,
			rgba(13, 17, 18, 0.92) 100%
		);
		pointer-events: none;
		z-index: 0;
	}

	.cheat-showcase__inner {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 1.1rem;
		padding-top: 3.75rem;
	}

	.cheat-showcase__head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
	}

	.cheat-showcase__head-copy {
		display: grid;
		gap: 0.45rem;
		min-width: 0;
	}

	.cheat-showcase__title {
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
		margin: 0;
		color: var(--color-gold);
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 1.65rem);
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.cheat-showcase__title svg {
		width: 1.15rem;
		height: 1.15rem;
		opacity: 0.85;
	}

	.cheat-showcase__lead {
		margin: 0;
		max-width: 42rem;
		color: var(--color-faint);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.cheat-showcase__stage {
		width: 100%;
		min-width: 0;
	}

	.cheat-showcase__viewport {
		position: relative;
		width: 100%;
		overflow: hidden;
		mask-image: linear-gradient(
			90deg,
			#000 0%,
			#000 calc(100% - 3.5rem),
			transparent 100%
		);
	}

	.cheat-showcase__track {
		display: flex;
		flex-direction: row;
		align-items: stretch;
		gap: 0.85rem;
		width: max-content;
		padding-block: 0.15rem;
		will-change: transform;
		animation: cheat-showcase-scroll 26s linear infinite;
	}

	.cheat-showcase__viewport:hover .cheat-showcase__track,
	.cheat-showcase__viewport:focus-within .cheat-showcase__track {
		animation-play-state: paused;
	}

	.cheat-showcase__card {
		display: flex;
		flex: 0 0 clamp(16.5rem, 28vw, 18.5rem);
		width: clamp(16.5rem, 28vw, 18.5rem);
	}

	.cheat-showcase__card-link {
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100%;
		overflow: hidden;
		border: 1px solid rgba(58, 61, 55, 0.85);
		background: var(--color-card);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			transform 0.2s ease;
	}

	.cheat-showcase__card-link:hover {
		border-color: rgba(197, 138, 69, 0.45);
		background: var(--color-card-hover);
		transform: translateY(-3px);
	}

	.cheat-showcase__media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.04);
	}

	.cheat-showcase__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cheat-showcase__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 0.85rem 0.95rem 1rem;
		min-height: 8.5rem;
	}

	.cheat-showcase__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 0.55rem;
	}

	.cheat-showcase__badge {
		display: inline-flex;
		align-items: center;
		padding: 0.18rem 0.45rem;
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.cheat-showcase__badge--green {
		background: var(--color-green);
		color: #f1eee5;
	}

	.cheat-showcase__badge--gold {
		background: var(--color-accent);
		color: #0d1112;
	}

	.cheat-showcase__label {
		color: var(--color-faint);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.cheat-showcase__card-title {
		margin: 0;
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.cheat-showcase__card-desc {
		margin: 0.45rem 0 0;
		color: var(--color-body);
		font-size: 0.82rem;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}

	@keyframes cheat-showcase-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (max-width: 560px) {
		.cheat-showcase {
			margin-top: -2.5rem;
			padding-bottom: 1rem;
		}

		.cheat-showcase__inner {
			padding-top: 3rem;
			gap: 0.9rem;
		}

		.cheat-showcase__card {
			flex-basis: min(78vw, 17.5rem);
			width: min(78vw, 17.5rem);
		}

		.cheat-showcase__body {
			min-height: 7.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cheat-showcase__track {
			animation: none;
			flex-wrap: wrap;
			width: 100%;
		}

		.cheat-showcase__viewport {
			overflow: visible;
			mask-image: none;
		}

		.cheat-showcase__card {
			flex: 1 1 min(100%, 17.5rem);
			width: auto;
		}
	}
</style>
