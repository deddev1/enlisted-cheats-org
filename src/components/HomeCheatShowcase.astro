---
import { showcaseGameplay } from '../data/enlisted';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { contentSrc, contentSrcSet } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;

const showcaseCards = [
	{
		badge: 'Wallhack',
		badgeTone: 'green',
		title: 'Enemy ESP through cover',
		description:
			'Green wallhack highlights soldiers behind wooden walls and trench fortifications before they peek.',
		image: showcaseGameplay[0],
		href: getLocalizedPath('wallhack', locale),
	},
	{
		badge: 'ESP',
		badgeTone: 'green',
		title: 'Red soldier silhouettes',
		description:
			'Bright red ESP outlines on open ground so you spot pushes, flanks, and exposed infantry early.',
		image: showcaseGameplay[1],
		href: getLocalizedPath('enlisted-esp', locale),
	},
	{
		badge: 'Aimbot',
		badgeTone: 'gold',
		title: 'Scoped enemy highlight',
		description:
			'Purple chams and mark-enemy cues through optics for faster long-range weak-spot shots.',
		image: showcaseGameplay[2],
		href: getLocalizedPath('enlisted-aimbot', locale),
	},
	{
		badge: 'Radar',
		badgeTone: 'gold',
		title: 'Skeleton ESP and snaplines',
		description:
			'2D radar, skeleton boxes, snaplines, and soldier distance tags during heavy firefights.',
		image: showcaseGameplay[3],
		href: getLocalizedPath('radar', locale),
	},
	{
		badge: 'Radar',
		badgeTone: 'gold',
		title: 'Soldiers visible through terrain',
		description:
			'Top-down radar plus soldier icons that stay readable through hills, smoke, and hard cover.',
		image: showcaseGameplay[4],
		href: getLocalizedPath('radar', locale),
	},
] as const;

const scrollCards = [...showcaseCards, ...showcaseCards];
const cardCount = showcaseCards.length;
---

<section class="cheat-showcase" aria-labelledby="cheat-showcase-title">
	<div class="cheat-showcase__fade" aria-hidden="true"></div>

	<div class="shell cheat-showcase__inner">
		<header class="cheat-showcase__head">
			<div class="cheat-showcase__head-copy">
				<h2 id="cheat-showcase-title" class="cheat-showcase__title">
					<span class="cheat-showcase__accent" aria-hidden="true"></span>
					Cheat showcase
				</h2>
				<p class="cheat-showcase__lead">
					Live Enlisted Cheats screenshots — wallhack, ESP, aimbot, and radar from the Windows PC package.
				</p>
			</div>
		</header>
	</div>

	<div class="cheat-showcase__stage">
		<div class="cheat-showcase__viewport" data-cheat-scroll-viewport style={`--cheat-scroll-steps: ${cardCount}`}>
			<div class="cheat-showcase__track" data-cheat-scroll-track aria-hidden="true">
					{
						scrollCards.map((card) => {
							const imageSrc = contentSrc(card.image.src);
							const imageSrcSet = contentSrcSet(card.image.src);

							return (
								<article class="cheat-showcase__card">
									<a href={card.href} class="cheat-showcase__card-link">
										<div class="cheat-showcase__media">
											<img
												src={imageSrc}
												{...(imageSrcSet ? { srcset: imageSrcSet } : {})}
												sizes="(max-width: 560px) 78vw, 320px"
												alt={card.image.alt}
												width="530"
												height="320"
												loading="lazy"
												decoding="async"
											/>
										</div>
									<div class="cheat-showcase__body">
										<div class="cheat-showcase__meta">
											<span class:list={['cheat-showcase__badge', `cheat-showcase__badge--${card.badgeTone}`]}>
												{card.badge}
											</span>
											<span class="cheat-showcase__label">Windows PC</span>
										</div>
										<h3 class="cheat-showcase__card-title">{card.title}</h3>
										<p class="cheat-showcase__card-desc">{card.description}</p>
									</div>
								</a>
							</article>
							);
						})
					}
				</div>
			</div>
		</div>
</section>

<style>
	.cheat-showcase {
		position: relative;
		margin-top: -3rem;
		padding: 0 0 1rem;
		background: linear-gradient(
			180deg,
			rgba(13, 17, 18, 0) 0%,
			rgba(13, 17, 18, 0.72) 8%,
			var(--color-bg) 18%,
			var(--color-bg-secondary) 100%
		);
		isolation: isolate;
	}

	.cheat-showcase__fade {
		position: absolute;
		inset: 0 0 auto;
		height: 6rem;
		background: linear-gradient(
			180deg,
			rgba(13, 17, 18, 0) 0%,
			rgba(13, 17, 18, 0.55) 55%,
			rgba(13, 17, 18, 0.92) 100%
		);
		pointer-events: none;
		z-index: 0;
	}

	.cheat-showcase__inner {
		position: relative;
		z-index: 1;
		padding-top: 3rem;
		padding-bottom: 0.85rem;
	}

	.cheat-showcase__head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
	}

	.cheat-showcase__head-copy {
		display: grid;
		gap: 0.45rem;
		min-width: 0;
	}

	.cheat-showcase__title {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0;
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: var(--heading-section);
		font-weight: 800;
		line-height: 1.15;
	}

	.cheat-showcase__accent {
		display: inline-block;
		width: 0.22rem;
		height: 1.35rem;
		border-radius: 999px;
		background: linear-gradient(180deg, #b47a3c, #343b31);
		flex-shrink: 0;
	}

	.cheat-showcase__lead {
		margin: 0;
		max-width: 42rem;
		color: var(--color-faint);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.cheat-showcase__stage {
		width: 100%;
		overflow: hidden;
	}

	.cheat-showcase__viewport {
		width: 100%;
		overflow: hidden;
		padding-inline: var(--shell-inset);
		mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
	}

	.cheat-showcase__track {
		display: flex;
		flex-direction: row;
		align-items: stretch;
		gap: 0.75rem;
		width: max-content;
		padding-block: 0.35rem 0.5rem;
		will-change: transform;
		animation: cheat-showcase-scroll var(--cheat-scroll-duration, 42s) linear infinite;
		animation-play-state: running;
	}

	.cheat-showcase__viewport:hover .cheat-showcase__track,
	.cheat-showcase__viewport:focus-within .cheat-showcase__track {
		animation-play-state: paused;
	}

	.cheat-showcase__card {
		display: flex;
		flex: 0 0 clamp(14rem, 21vw, 17rem);
		width: clamp(14rem, 21vw, 17rem);
		min-width: clamp(14rem, 21vw, 17rem);
	}

	.cheat-showcase__card-link {
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--color-border-panel);
		background: rgba(0, 0, 0, 0.42);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.cheat-showcase__card-link:hover {
		border-color: var(--color-border-panel-strong);
		background: rgba(0, 0, 0, 0.52);
	}

	.cheat-showcase__media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.04);
	}

	.cheat-showcase__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cheat-showcase__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 0.7rem 0.8rem 0.85rem;
		min-height: 7.5rem;
	}

	.cheat-showcase__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 0.55rem;
	}

	.cheat-showcase__badge {
		display: inline-flex;
		align-items: center;
		padding: 0.18rem 0.45rem;
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.cheat-showcase__badge--green {
		background: var(--color-green);
		color: #f1eee5;
	}

	.cheat-showcase__badge--gold {
		background: var(--color-accent);
		color: #0d1112;
	}

	.cheat-showcase__label {
		color: var(--color-faint);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.cheat-showcase__card-title {
		margin: 0;
		color: #fff;
		font-family: var(--font-display);
		font-size: clamp(0.84rem, 1.05vw, 0.92rem);
		font-weight: 800;
		letter-spacing: -0.01em;
		line-height: 1.35;
		text-transform: none;
		text-wrap: balance;
		min-height: 2.5em;
	}

	.cheat-showcase__card-desc {
		margin: 0.45rem 0 0;
		color: rgba(229, 238, 238, 0.88);
		font-size: 0.82rem;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	@keyframes cheat-showcase-scroll {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(calc(-50% - 0.375rem), 0, 0);
		}
	}

	@media (max-width: 560px) {
		.cheat-showcase {
			margin-top: -2.5rem;
			padding-bottom: 1rem;
		}

		.cheat-showcase__inner {
			padding-top: 2.5rem;
			padding-bottom: 0.75rem;
		}

		.cheat-showcase__card {
			flex-basis: min(78vw, 16rem);
			width: min(78vw, 16rem);
		}

		.cheat-showcase__body {
			min-height: 7rem;
		}

		.cheat-showcase__card-title {
			font-size: 0.92rem;
			min-height: 2.6em;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cheat-showcase__track {
			animation: none;
			flex-wrap: wrap;
			width: 100%;
		}

		.cheat-showcase__viewport {
			overflow: visible;
			mask-image: none;
		}

		.cheat-showcase__card {
			flex: 1 1 min(100%, 17.5rem);
			width: auto;
		}
	}
</style>
