---
import { enlistedScreenshots } from '../data/enlisted';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { contentSrc, contentSrcSet } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;

const showcaseCards = [
	{
		badge: 'ESP',
		badgeTone: 'green',
		title: 'Enemy wallhack overlay',
		description:
			'Soldier, vehicle, and tank outlines through terrain with distance readouts and team colour coding.',
		image: enlistedScreenshots.espOverlay,
		href: getLocalizedPath('enlisted-esp', locale),
	},
	{
		badge: 'Aimbot',
		badgeTone: 'gold',
		title: 'Smooth combat targeting',
		description:
			'Configurable FOV, smoothing, and weak-spot priority for rifles, SMGs, and sniper rifles.',
		image: enlistedScreenshots.aimbotMenu,
		href: getLocalizedPath('enlisted-aimbot', locale),
	},
	{
		badge: 'Wallhack',
		badgeTone: 'green',
		title: 'ESP bounding boxes',
		description:
			'Enemy boxes with health bars in campaign missions, squad assaults, and large-scale battles.',
		image: enlistedScreenshots.espBoxes,
		href: getLocalizedPath('wallhack', locale),
	},
	{
		badge: 'Radar',
		badgeTone: 'gold',
		title: '2D threat minimap',
		description:
			'Directional cues for flanks and enemies outside your line of sight with adjustable range.',
		image: enlistedScreenshots.radarMinimap,
		href: getLocalizedPath('radar', locale),
	},
	{
		badge: 'Combat',
		badgeTone: 'green',
		title: 'Live battle ESP',
		description:
			'Toggleable ESP categories for tank fights, infantry pushes, and defence sectors without overlay noise.',
		image: enlistedScreenshots.combatEsp,
		href: getLocalizedPath('features', locale),
	},
	{
		badge: 'Settings',
		badgeTone: 'gold',
		title: 'In-client control panel',
		description:
			'Hotkeys, colours, and per-module toggles for ESP, radar, and aimbot mid-match.',
		image: enlistedScreenshots.settingsPanel,
		href: getLocalizedPath('features', locale),
	},
] as const;

const scrollCards = [...showcaseCards, ...showcaseCards];
---

<section class="cheat-showcase" aria-labelledby="cheat-showcase-title">
	<div class="cheat-showcase__fade" aria-hidden="true"></div>

	<div class="shell cheat-showcase__inner">
		<header class="cheat-showcase__head">
			<h2 id="cheat-showcase-title" class="cheat-showcase__title">
				Cheat showcase
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" fill="currentColor"></path>
				</svg>
			</h2>
			<p class="cheat-showcase__lead">ESP, aimbot, radar, and wallhack screenshots from the live Enlisted Cheats package.</p>
		</header>

		<div class="cheat-showcase__stage">
			<div class="cheat-showcase__viewport" data-cheat-scroll-viewport>
				<div class="cheat-showcase__track" data-cheat-scroll-track>
					{
						scrollCards.map((card) => (
							<article class="cheat-showcase__card">
								<a href={card.href} class="cheat-showcase__card-link">
									<div class="cheat-showcase__media">
										<img
											src={contentSrc(card.image.src)}
											srcset={contentSrcSet(card.image.src)}
											sizes="(max-width: 560px) 78vw, 280px"
											alt={card.image.alt}
											width="640"
											height="360"
											loading="lazy"
											decoding="async"
										/>
									</div>
									<div class="cheat-showcase__body">
										<div class="cheat-showcase__meta">
											<span class:list={['cheat-showcase__badge', `cheat-showcase__badge--${card.badgeTone}`]}>
												{card.badge}
											</span>
											<span class="cheat-showcase__label">Windows PC</span>
										</div>
										<h3 class="cheat-showcase__card-title">{card.title}</h3>
										<p class="cheat-showcase__card-desc">{card.description}</p>
									</div>
								</a>
							</article>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.cheat-showcase {
		position: relative;
		margin-top: -4.5rem;
		padding: 0 0 2.5rem;
		background: linear-gradient(
			180deg,
			rgba(13, 17, 18, 0) 0%,
			rgba(13, 17, 18, 0.72) 8%,
			var(--color-bg) 18%,
			var(--color-bg-secondary) 100%
		);
		isolation: isolate;
	}

	.cheat-showcase__fade {
		position: absolute;
		inset: 0 0 auto;
		height: 7rem;
		background: linear-gradient(
			180deg,
			rgba(13, 17, 18, 0) 0%,
			rgba(13, 17, 18, 0.55) 55%,
			rgba(13, 17, 18, 0.92) 100%
		);
		pointer-events: none;
		z-index: 0;
	}

	.cheat-showcase__inner {
		position: relative;
		z-index: 1;
		padding-top: 4.5rem;
	}

	.cheat-showcase__head {
		display: grid;
		gap: 0.45rem;
		margin-bottom: 1.35rem;
	}

	.cheat-showcase__title {
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
		margin: 0;
		color: var(--color-gold);
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 1.65rem);
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.cheat-showcase__title svg {
		width: 1.15rem;
		height: 1.15rem;
		opacity: 0.85;
	}

	.cheat-showcase__lead {
		margin: 0;
		max-width: 36rem;
		color: var(--color-faint);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.cheat-showcase__stage {
		width: 100%;
	}

	.cheat-showcase__viewport {
		position: relative;
		width: 100%;
		overflow: hidden;
		mask-image: linear-gradient(
			90deg,
			transparent 0%,
			#000 6%,
			#000 94%,
			transparent 100%
		);
	}

	.cheat-showcase__track {
		display: flex;
		flex-direction: row;
		align-items: stretch;
		gap: 0.85rem;
		width: max-content;
		padding-block: 0.15rem;
		will-change: transform;
		animation: cheat-showcase-scroll 55s linear infinite;
	}

	.cheat-showcase__viewport:hover .cheat-showcase__track,
	.cheat-showcase__viewport:focus-within .cheat-showcase__track {
		animation-play-state: paused;
	}

	.cheat-showcase__card {
		flex: 0 0 min(78vw, 17.5rem);
		width: min(78vw, 17.5rem);
	}

	.cheat-showcase__card-link {
		display: block;
		overflow: hidden;
		border: 1px solid rgba(58, 61, 55, 0.85);
		background: var(--color-card);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			transform 0.2s ease;
	}

	.cheat-showcase__card-link:hover {
		border-color: rgba(197, 138, 69, 0.45);
		background: var(--color-card-hover);
		transform: translateY(-3px);
	}

	.cheat-showcase__media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.04);
	}

	.cheat-showcase__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cheat-showcase__body {
		padding: 0.85rem 0.95rem 1rem;
	}

	.cheat-showcase__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 0.55rem;
	}

	.cheat-showcase__badge {
		display: inline-flex;
		align-items: center;
		padding: 0.18rem 0.45rem;
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.cheat-showcase__badge--green {
		background: var(--color-green);
		color: #f1eee5;
	}

	.cheat-showcase__badge--gold {
		background: var(--color-accent);
		color: #0d1112;
	}

	.cheat-showcase__label {
		color: var(--color-faint);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.cheat-showcase__card-title {
		margin: 0;
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.cheat-showcase__card-desc {
		margin: 0.45rem 0 0;
		color: var(--color-body);
		font-size: 0.82rem;
		line-height: 1.55;
	}

	@keyframes cheat-showcase-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (min-width: 900px) {
		.cheat-showcase__card {
			flex-basis: 18.5rem;
			width: 18.5rem;
		}
	}

	@media (max-width: 560px) {
		.cheat-showcase {
			margin-top: -3rem;
			padding-bottom: 2rem;
		}

		.cheat-showcase__inner {
			padding-top: 3.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cheat-showcase__track {
			animation: none;
			flex-wrap: wrap;
			width: 100%;
		}

		.cheat-showcase__viewport {
			overflow: visible;
			mask-image: none;
		}

		.cheat-showcase__card {
			flex: 1 1 min(100%, 17.5rem);
			width: auto;
		}
	}
</style>
