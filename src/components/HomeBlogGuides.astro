---
import { getFeaturedPosts, blogCardHeading, blogCardExcerpt } from '../data/blog/helpers';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import BlogCinematicCard from './BlogCinematicCard.astro';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const posts = getFeaturedPosts(locale, 3);
---

{
	posts.length > 0 ? (
		<section class="home-blog shell" aria-labelledby="home-blog-title">
			<header class="home-blog__head">
				<h2 id="home-blog-title" class="home-blog__title">Enlisted blog</h2>
				<p class="home-blog__intro">
					Guides on ESP, aimbot, undetected maintenance, campaign missions, battlefield farming, and patch
					notes.
				</p>
			</header>

			<div class="home-blog__grid">
				{posts.map((post, index) => (
					<BlogCinematicCard
						href={post.canonicalPath}
						imageSrc={post.imageSrc}
						imageAlt={post.translation.imageAlt}
						title={blogCardHeading(post.translation.title)}
						description={blogCardExcerpt(post.translation.intro)}
						loading={index === 0 ? 'eager' : 'lazy'}
						fetchpriority={index === 0 ? 'high' : undefined}
					/>
				))}
			</div>

			<p class="home-blog__more">
				<a href="/blog/">Browse all blog posts</a>
			</p>
		</section>
	) : null
}

<style>
	.home-blog {
		padding-block: 0;
	}

	.home-blog__head {
		display: grid;
		gap: 0.55rem;
		margin-bottom: 1rem;
		text-align: center;
	}

	.home-blog__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 2.2vw, 1.45rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.home-blog__intro {
		margin: 0 auto;
		max-width: 40rem;
		color: var(--color-muted);
		font-size: 0.88rem;
		line-height: 1.55;
	}

	.home-blog__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.65rem;
		align-items: stretch;
	}

	.home-blog__more {
		margin: 0.85rem 0 0;
		text-align: center;
	}

	.home-blog__more a {
		color: var(--color-gold-hover);
		font-size: 0.86rem;
		font-weight: 700;
		text-decoration: none;
	}

	.home-blog__more a:hover {
		color: var(--color-ink);
	}

	@media (max-width: 900px) {
		.home-blog__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
