---
import {
	enlistedOfficialScreens,
	gameplayScreenshots,
} from '../data/enlisted';
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { homeFaqs, productInfo, siteConfig } from '../data/site';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const cheatsUrl = getLocalizedPath('hacks', locale);
const featuresUrl = getLocalizedPath('features', locale);
const pricingUrl = getLocalizedPath('pricing', locale);
const updatesUrl = getLocalizedPath('updates', locale);
const setupUrl = getLocalizedPath('setup', locale);
const espUrl = getLocalizedPath('enlisted-esp', locale);
const wallhackUrl = getLocalizedPath('wallhack', locale);
const aimbotUrl = getLocalizedPath('enlisted-aimbot', locale);
const radarUrl = getLocalizedPath('radar', locale);
const faqUrl = getLocalizedPath('faq', locale);
const supportUrl = getLocalizedPath('support', locale);

const monthlyPlan = productInfo.plans[0];

const spotlightFeatures = [
	{
		title: 'ESP & wallhack',
		body: 'Red enemy silhouettes on open ground and green wallhack boxes through wooden trenches — spot pushes, flanks, and hidden soldiers before they peek.',
		image: gameplayScreenshots.esp,
		href: espUrl,
		linkLabel: 'ESP guide',
		align: 'left' as const,
	},
	{
		title: 'Aimbot & scoped targeting',
		body: 'Purple chams and weak-spot priority through optics. Smooth FOV controls and hotkey toggles so you stay accurate in squad assaults without menu clutter.',
		image: gameplayScreenshots.aimbot,
		href: aimbotUrl,
		linkLabel: 'Aimbot guide',
		align: 'right' as const,
	},
	{
		title: 'Radar & combat intel',
		body: '2D battlefield radar, skeleton ESP, snaplines, and soldier distance tags. Read threats through smoke, hills, and hard cover during heavy firefights.',
		image: gameplayScreenshots.radarCombat,
		href: radarUrl,
		linkLabel: 'Radar guide',
		align: 'left' as const,
	},
	{
		title: 'Updates after every patch',
		body: 'When Gaijin ships anti-cheat or game updates, we rebuild the Enlisted cheat stack and publish maintenance notes so your license keeps working.',
		image: enlistedOfficialScreens.squadCombat,
		href: updatesUrl,
		linkLabel: 'Patch updates',
		align: 'right' as const,
	},
] as const;

const quickFaqs = homeFaqs.slice(0, 4);
---

<section class="feat-spotlight" aria-labelledby="feat-spotlight-title">
	<div class="feat-spotlight__hero">
		<img
			src={enlistedOfficialScreens.battlefieldPanorama.src}
			alt=""
			class="feat-spotlight__hero-img"
			width="1920"
			height="1080"
			loading="lazy"
			decoding="async"
			aria-hidden="true"
		/>
		<div class="feat-spotlight__hero-scrim" aria-hidden="true"></div>
		<div class="shell feat-spotlight__hero-inner">
			<p class="feat-spotlight__hero-kicker">Cheats for Enlisted · Windows PC</p>
			<h2 id="feat-spotlight-title" class="feat-spotlight__hero-title">
				<span>This is</span>
				<strong>Enlisted Cheats</strong>
			</h2>
			<div class="feat-spotlight__hero-divider" aria-hidden="true">
				<span></span>
				<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
					<path d="M12 2l2.4 7.4H22l-6 4.4 2.3 7.2L12 16.8 5.7 20.9 8 13.8 2 9.4h7.6L12 2z" fill="currentColor"></path>
				</svg>
				<span></span>
			</div>
			<p class="feat-spotlight__hero-intro">
				Here are the main features waiting in your package — ESP, wallhack, aimbot, and radar with
				anti-cheat maintenance after every Enlisted patch.
			</p>
		</div>
	</div>

	<div class="feat-spotlight__body">
		<div class="shell feat-spotlight__intro">
			<p class="feat-spotlight__intro-text">
				One license covers campaign missions, squad assaults, and large-scale battles. Toggle modules
				mid-match, read our <a href={setupUrl}>setup guide</a>, and get rebuilds when patches land on
				the <a href={updatesUrl}>updates page</a>.
			</p>
		</div>

		<div class="feat-spotlight__stage" aria-label="Main Enlisted cheat features">
			{
				spotlightFeatures.map((feature) => (
					<article class:list={['feat-spotlight__row', `feat-spotlight__row--${feature.align}`]}>
						<div class="feat-spotlight__row-bg" aria-hidden="true">
							<img src={feature.image.src} alt="" width="960" height="540" loading="lazy" decoding="async" />
						</div>
						<div class="shell feat-spotlight__row-inner">
							<div class="feat-spotlight__row-content">
								<span class="feat-spotlight__badge" aria-hidden="true">
									<svg viewBox="0 0 24 24" focusable="false">
										<path
											d="M12 2l2.4 7.4H22l-6 4.4 2.3 7.2L12 16.8 5.7 20.9 8 13.8 2 9.4h7.6L12 2z"
											fill="currentColor"></path>
										<path d="M9.2 12.3l1.6 1.6 3.8-3.9" stroke="#140c04" stroke-width="1.8" stroke-linecap="round"></path>
									</svg>
								</span>
								<h3 class="feat-spotlight__row-title">{feature.title}</h3>
								<p class="feat-spotlight__row-text">{feature.body}</p>
								<a href={feature.href} class="feat-spotlight__row-link">
									{feature.linkLabel}
									<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
										<path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
									</svg>
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>

		<div class="feat-spotlight__buy-band">
			<div class="shell feat-spotlight__buy-inner">
				<img
					src={siteConfig.logoRaster}
					alt={siteConfig.logoAlt}
					class="feat-spotlight__buy-logo"
					width={siteConfig.logoRasterWidth}
					height={siteConfig.logoRasterHeight}
					loading="lazy"
					decoding="async"
				/>
				<p class="feat-spotlight__buy-tagline">
					Undetected <a href={cheatsUrl}>Enlisted cheats</a> for Windows PC — from ${monthlyPlan.price}/mo
				</p>
				<div class="feat-spotlight__buy-actions">
					<a href={siteConfig.checkoutUrl} class="feat-spotlight__buy-btn" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM6.2 6h14.6l-1.4 7H8.1L6.2 6zm-.8-2 2.2 11h11.2l2-11H5.4z"
								fill="currentColor"></path>
						</svg>
						Get access
					</a>
					<a href={pricingUrl} class="feat-spotlight__buy-secondary">{ui.nav.pricing}</a>
					<a href={featuresUrl} class="feat-spotlight__buy-secondary">{ui.nav.features}</a>
				</div>
				<p class="feat-spotlight__buy-note">
					Also includes <a href={wallhackUrl}>wallhack</a> · Instant delivery ·{' '}
					<a href={supportUrl}>Support</a> when patches land
				</p>
			</div>
		</div>

		<div class="feat-spotlight__faq">
			<div class="shell">
				<h3 class="feat-spotlight__faq-title">FAQ</h3>
				<div class="feat-spotlight__faq-list">
					{
						quickFaqs.map((item) => (
							<details class="feat-spotlight__faq-item">
								<summary class="feat-spotlight__faq-q">
									<span class="feat-spotlight__faq-icon" aria-hidden="true">?</span>
									<span>{item.question}</span>
									<svg class="feat-spotlight__faq-caret" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M7 10l5 5 5-5H7z" fill="currentColor"></path>
									</svg>
								</summary>
								<div class="feat-spotlight__faq-a">
									<p set:html={item.answer} />
								</div>
							</details>
						))
					}
				</div>
				<a href={faqUrl} class="feat-spotlight__faq-more">See all FAQ questions</a>
			</div>
		</div>
	</div>
</section>

<style>
	.feat-spotlight {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background: #0a1012;
	}

	.feat-spotlight__hero {
		position: relative;
		min-height: clamp(280px, 42vh, 420px);
		display: grid;
		align-items: end;
		overflow: hidden;
	}

	.feat-spotlight__hero-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
		filter: saturate(1.05) contrast(1.06) brightness(0.72);
	}

	.feat-spotlight__hero-scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(8, 12, 14, 0.35) 0%, rgba(8, 12, 14, 0.82) 58%, rgba(8, 12, 14, 0.96) 100%),
			radial-gradient(ellipse 80% 60% at 50% 40%, rgba(197, 138, 69, 0.08), transparent 70%);
	}

	.feat-spotlight__hero-inner {
		position: relative;
		z-index: 1;
		padding: clamp(2rem, 5vw, 3rem) 0 clamp(1.75rem, 3.5vw, 2.5rem);
		text-align: center;
	}

	.feat-spotlight__hero-kicker {
		margin: 0 0 0.65rem;
		color: rgba(255, 220, 170, 0.82);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.feat-spotlight__hero-title {
		margin: 0;
		color: rgba(255, 255, 255, 0.92);
		font-family: var(--font-display);
		font-size: clamp(1.55rem, 4.2vw, 2.85rem);
		font-weight: 500;
		line-height: 1.05;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.feat-spotlight__hero-title strong {
		display: block;
		margin-top: 0.15rem;
		color: #fff;
		font-weight: 800;
		font-size: clamp(1.85rem, 5vw, 3.35rem);
		letter-spacing: 0.06em;
		text-shadow: 0 8px 28px rgba(0, 0, 0, 0.45);
	}

	.feat-spotlight__hero-divider {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		margin: 1rem auto 0.85rem;
		max-width: 28rem;
		color: var(--color-gold-hover);
	}

	.feat-spotlight__hero-divider span {
		flex: 1;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(197, 138, 69, 0.55), transparent);
	}

	.feat-spotlight__hero-divider svg {
		width: 0.85rem;
		height: 0.85rem;
		flex-shrink: 0;
	}

	.feat-spotlight__hero-intro {
		margin: 0 auto;
		max-width: 38rem;
		color: rgba(229, 238, 238, 0.88);
		font-size: clamp(0.88rem, 1.5vw, 1rem);
		line-height: 1.62;
	}

	.feat-spotlight__body {
		background:
			linear-gradient(180deg, rgba(10, 16, 18, 0.98) 0%, rgba(12, 18, 20, 0.96) 100%);
	}

	.feat-spotlight__intro {
		padding: 1.35rem 0 0.5rem;
		text-align: center;
	}

	.feat-spotlight__intro-text {
		margin: 0 auto;
		max-width: 42rem;
		color: rgba(181, 180, 170, 0.92);
		font-size: 0.9rem;
		line-height: 1.65;
	}

	.feat-spotlight__intro-text a {
		color: var(--color-gold-hover);
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}

	.feat-spotlight__intro-text a:hover {
		color: #fff;
	}

	.feat-spotlight__stage {
		display: grid;
		gap: 0;
		padding-block: 0.5rem 1rem;
	}

	.feat-spotlight__row {
		position: relative;
		overflow: hidden;
		border-block: 1px solid rgba(255, 255, 255, 0.04);
	}

	.feat-spotlight__row-bg {
		position: absolute;
		inset: 0;
		opacity: 0.22;
	}

	.feat-spotlight__row-bg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		filter: saturate(0.9) contrast(1.05);
	}

	.feat-spotlight__row--left .feat-spotlight__row-bg {
		mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.35) 55%, transparent 100%);
	}

	.feat-spotlight__row--right .feat-spotlight__row-bg {
		mask-image: linear-gradient(270deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.35) 55%, transparent 100%);
	}

	.feat-spotlight__row-inner {
		position: relative;
		z-index: 1;
		padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
	}

	.feat-spotlight__row-content {
		max-width: 34rem;
		padding: 1.1rem 1.15rem;
		border: 1px solid rgba(255, 255, 255, 0.06);
		background: rgba(8, 12, 14, 0.72);
		backdrop-filter: blur(10px);
	}

	.feat-spotlight__row--left .feat-spotlight__row-content {
		margin-right: auto;
	}

	.feat-spotlight__row--right .feat-spotlight__row-content {
		margin-left: auto;
	}

	.feat-spotlight__badge {
		display: inline-flex;
		width: 2rem;
		height: 2rem;
		margin-bottom: 0.65rem;
		color: var(--color-gold-hover);
		filter: drop-shadow(0 4px 10px rgba(197, 138, 69, 0.35));
	}

	.feat-spotlight__badge svg {
		width: 100%;
		height: 100%;
	}

	.feat-spotlight__row-title {
		margin: 0 0 0.55rem;
		color: #fff;
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 2.2vw, 1.45rem);
		font-weight: 800;
		line-height: 1.15;
	}

	.feat-spotlight__row-text {
		margin: 0;
		color: rgba(181, 180, 170, 0.95);
		font-size: 0.88rem;
		line-height: 1.62;
	}

	.feat-spotlight__row-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.85rem;
		color: var(--color-gold-hover);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.feat-spotlight__row-link svg {
		width: 0.85rem;
		height: 0.85rem;
		transition: transform 0.2s ease;
	}

	.feat-spotlight__row-link:hover {
		color: #fff;
	}

	.feat-spotlight__row-link:hover svg {
		transform: translateX(3px);
	}

	.feat-spotlight__buy-band {
		position: relative;
		padding: clamp(2rem, 4vw, 2.75rem) 0;
		background:
			linear-gradient(180deg, rgba(8, 12, 14, 0.92) 0%, rgba(6, 9, 10, 0.98) 100%),
			url('https://enlisted.net/i/scr/3.jpg?v=20251222') center 40% / cover no-repeat;
		border-top: 1px solid rgba(197, 138, 69, 0.14);
	}

	.feat-spotlight__buy-band::before {
		content: '';
		position: absolute;
		inset: 0;
		background: rgba(8, 12, 14, 0.82);
		pointer-events: none;
	}

	.feat-spotlight__buy-inner {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: 0.75rem;
		text-align: center;
	}

	.feat-spotlight__buy-logo {
		width: auto;
		height: clamp(2.5rem, 5vw, 3.25rem);
		opacity: 0.92;
		filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.45));
	}

	.feat-spotlight__buy-tagline {
		margin: 0;
		max-width: 32rem;
		color: rgba(229, 238, 238, 0.88);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.feat-spotlight__buy-tagline a {
		color: var(--color-gold-hover);
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}

	.feat-spotlight__buy-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.55rem 0.75rem;
		margin-top: 0.15rem;
	}

	.feat-spotlight__buy-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-height: 3rem;
		padding: 0.85rem 1.65rem;
		border: 1px solid rgba(255, 228, 170, 0.55);
		border-radius: 0.15rem;
		background: linear-gradient(135deg, #e8b066 0%, #c58a45 46%, #a86f2f 100%);
		color: #140c04;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.32) inset,
			0 10px 24px rgba(0, 0, 0, 0.32);
		transition: transform 0.2s ease, filter 0.2s ease;
	}

	.feat-spotlight__buy-btn svg {
		width: 1rem;
		height: 1rem;
	}

	.feat-spotlight__buy-btn:hover {
		filter: brightness(1.05);
		transform: translateY(-1px);
		color: #140c04;
	}

	.feat-spotlight__buy-secondary {
		display: inline-flex;
		align-items: center;
		min-height: 3rem;
		padding: 0.75rem 1rem;
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.feat-spotlight__buy-secondary:hover {
		color: #fff;
	}

	.feat-spotlight__buy-note {
		margin: 0;
		color: rgba(181, 180, 170, 0.82);
		font-size: 0.76rem;
		line-height: 1.5;
	}

	.feat-spotlight__buy-note a {
		color: var(--color-gold-hover);
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}

	.feat-spotlight__faq {
		padding: clamp(1.5rem, 3vw, 2rem) 0 clamp(2rem, 4vw, 2.75rem);
		background: linear-gradient(180deg, rgba(10, 16, 18, 0.98), rgba(8, 12, 14, 1));
	}

	.feat-spotlight__faq-title {
		margin: 0 0 1rem;
		color: #fff;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.5vw, 1.75rem);
		font-weight: 800;
		letter-spacing: 0.08em;
		text-align: center;
		text-transform: uppercase;
	}

	.feat-spotlight__faq-list {
		display: grid;
		gap: 0.55rem;
		max-width: 52rem;
		margin-inline: auto;
	}

	.feat-spotlight__faq-item {
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 0.2rem;
		background: rgba(255, 255, 255, 0.03);
		overflow: hidden;
	}

	.feat-spotlight__faq-q {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 1rem;
		color: rgba(255, 255, 255, 0.88);
		font-size: 0.88rem;
		font-weight: 600;
		line-height: 1.45;
		cursor: pointer;
		list-style: none;
	}

	.feat-spotlight__faq-q::-webkit-details-marker {
		display: none;
	}

	.feat-spotlight__faq-icon {
		display: inline-grid;
		place-items: center;
		width: 1.65rem;
		height: 1.65rem;
		border-radius: 999px;
		background: rgba(197, 138, 69, 0.18);
		color: var(--color-gold-hover);
		font-size: 0.82rem;
		font-weight: 800;
	}

	.feat-spotlight__faq-caret {
		width: 1rem;
		height: 1rem;
		opacity: 0.7;
		transition: transform 0.2s ease;
	}

	.feat-spotlight__faq-item[open] .feat-spotlight__faq-caret {
		transform: rotate(180deg);
	}

	.feat-spotlight__faq-item[open] .feat-spotlight__faq-q {
		color: var(--color-gold-hover);
	}

	.feat-spotlight__faq-a {
		padding: 0 1rem 1rem 3.4rem;
		color: rgba(181, 180, 170, 0.92);
		font-size: 0.84rem;
		line-height: 1.6;
	}

	.feat-spotlight__faq-a p {
		margin: 0;
	}

	.feat-spotlight__faq-more {
		display: inline-flex;
		margin: 1rem auto 0;
		color: var(--color-gold-hover);
		font-size: 0.82rem;
		font-weight: 700;
	}

	.feat-spotlight__faq-more:hover {
		color: #fff;
	}

	.feat-spotlight__faq .shell {
		display: grid;
		justify-items: center;
	}

	@media (max-width: 720px) {
		.feat-spotlight__row-content {
			max-width: none;
		}

		.feat-spotlight__buy-actions {
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			max-width: 20rem;
		}

		.feat-spotlight__buy-btn,
		.feat-spotlight__buy-secondary {
			width: 100%;
			justify-content: center;
		}
	}
</style>
