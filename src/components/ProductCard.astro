---
import { pricingGallery, enlistedImages } from '../data/enlisted';
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import PlanSummaryPanels from './PlanSummaryPanels.astro';
import ProductMediaTrust from './ProductMediaTrust.astro';
import { productThumbSizes } from '../lib/responsive-images';

interface Props {
	name?: string;
	locale?: LocaleCode;
	/** Set true only when this card is the page LCP (never on homepage — hero wins). */
	priority?: boolean;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);
const priority = Astro.props.priority ?? false;

const { name = ui.product.title } = Astro.props;

/** Localized alts aligned 1:1 with enlistedImages.product; undefined falls back to data alt. */
const productAlts = [
	ui.images.battleRoyale,
	ui.images.playerEsp,
	ui.images.espWallhack,
	undefined,
	ui.images.rebootFight,
] as const;

/** Hero still + five unique product thumbs — six Enlisted images, no repeats. */
const heroPreview = {
	src: pricingGallery[0].src,
	fullSrc: pricingGallery[0].src,
	alt: pricingGallery[0].alt,
};

/** Screenshot thumbs only — each unique Enlisted still. */
const images = enlistedImages.product.map((image, index) => ({
	src: image.src,
	fullSrc: image.src,
	alt: productAlts[index] ?? image.alt,
}));
const monthlyPlan = productInfo.plans.find((plan) => plan.id === 'monthly') ?? productInfo.plans[0];
const lifetimePlan = productInfo.plans.find((plan) => plan.id === 'lifetime');
---

<section class="product surface-card" id="product" data-product aria-label="Product details">
	<div class="product__media">
		<figure class="product__figure media-frame">
			<img
				src={heroPreview.src}
				alt={heroPreview.alt}
				width="1280"
				height="720"
				class="product__image"
				data-main-image
				loading={priority ? 'eager' : 'lazy'}
				fetchpriority={priority ? 'high' : 'auto'}
				decoding="async"
			/>
			<span class="product__credit" aria-hidden="true">Enlisted</span>
		</figure>
		<div class="product__thumbs" role="group" aria-label="Product preview images">
			{
				images.map((image, index) => (
					<button
						type="button"
						class:list={['product__thumb media-frame']}
						aria-label={`Show ${image.alt}`}
						aria-pressed="false"
						data-thumb
						data-index={String(index)}
						data-src={image.src}
						data-alt={image.alt}
					>
						<img
							src={image.src}
							sizes={productThumbSizes}
							alt={image.alt}
							width="320"
							height="200"
							loading="lazy"
							decoding="async"
						/>
					</button>
				))
			}
		</div>
		<ProductMediaTrust locale={locale} />
	</div>

	<div class="product__details">
		<h2 class="product__title">{name}</h2>

		<div class="product__badges">
			<span class="badge">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M12 3l2.2 4.5 5 .7-3.6 3.5.9 5.1L12 14.8 7.5 16.8l.9-5.1L4.8 8.2l5-.7L12 3z"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linejoin="round"></path>
				</svg>
				{ui.product.gameBadge}
			</span>
			<span class="badge">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.6"></circle>
					<path d="M12 8v4.2l2.5 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
					></path>
				</svg>
				{ui.product.platformBadge}
			</span>
			<span class="badge badge--status">
				<span class="badge__dot" aria-hidden="true"></span>
				{ui.product.statusBadge}
			</span>
		</div>

		<div
			class="product__plan-picker"
			data-plan-selector
			data-default-plan={monthlyPlan.id}
			data-buy-prefix={ui.common.buyNow}
		>
			<div class="product__plans">
				<button
					type="button"
					class="product__plan is-selected"
					data-plan={monthlyPlan.id}
					data-plan-label={ui.product.monthly}
					data-plan-price={monthlyPlan.price}
					data-checkout-url={siteConfig.checkoutUrl}
					aria-pressed="true"
				>
					<span class="product__plan-label">{ui.product.monthly}</span>
					<span class="product__plan-price">${monthlyPlan.price}</span>
				</button>
				{
					lifetimePlan && (
						<button
							type="button"
							class="product__plan product__plan--featured"
							data-plan={lifetimePlan.id}
							data-plan-label={ui.product.lifetime}
							data-plan-price={lifetimePlan.price}
							data-checkout-url={siteConfig.checkoutUrl}
							aria-pressed="false"
						>
							<span class="product__plan-label">{ui.product.lifetime}</span>
							<span class="product__plan-price">${lifetimePlan.price}</span>
						</button>
					)
				}
			</div>

			<PlanSummaryPanels defaultPlanId={monthlyPlan.id} class="product__plan-summary" />

			<a
				href={siteConfig.checkoutUrl}
				class="cart-btn bg-brand"
				data-plan-buy
				rel="noopener noreferrer"
				aria-label={`${ui.common.buyNow} — ${ui.product.monthly} $${monthlyPlan.price}`}
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M13 3L4 14h6l-1 7 9-11h-6l1-7z"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				<span data-plan-buy-label>{ui.common.buyNow} — ${monthlyPlan.price}</span>
			</a>
		</div>

		<div class="buy-also">
			<p class="buy-also__label">{ui.common.relatedPages}</p>
			<div class="buy-also__row">
				<a href={getLocalizedPath('enlisted-esp', locale)} class="alt-link">{ui.nav.esp}</a>
				<a href={getLocalizedPath('enlisted-aimbot', locale)} class="alt-link">{ui.nav.aimbot}</a>
				<a href={getLocalizedPath('features', locale)} class="alt-link">{ui.nav.features}</a>
				<a href={getLocalizedPath('setup', locale)} class="alt-link">{ui.nav.setup}</a>
				<a href={getLocalizedPath('pricing', locale)} class="alt-link">{ui.nav.pricing}</a>
			</div>
		</div>
	</div>
</section>

<script>
	import { initPlanSelectors } from '../lib/plan-selector';
	initPlanSelectors();
</script>

<style>
	.product {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 3vw, 2.5rem);
		align-items: start;
		width: 100%;
		margin: 0;
		padding: clamp(1.25rem, 2.5vw, 2rem);
		border-radius: var(--radius-card);
	}

	@media (min-width: 761px) and (prefers-reduced-motion: no-preference) {
		.product {
			animation: card-in 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
		}
	}

	.product__media {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-width: 0;
	}

	.product__figure {
		margin: 0;
		aspect-ratio: 16 / 10;
		border: 1px solid var(--color-border-gold);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
	}

	.product__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		transform: none;
		transition: opacity 0.14s ease;
	}

	.product__figure.media-frame .product__image {
		transform: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.product__figure.media-frame:hover .product__image {
			transform: none;
		}
	}

	.product__credit {
		position: absolute;
		right: 0.75rem;
		bottom: 0.7rem;
		z-index: 2;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: rgba(232, 222, 248, 0.72);
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-shadow: 0 1px 8px rgba(0, 0, 0, 0.65);
	}

	.product__thumbs {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.55rem;
	}

	.product__thumb {
		padding: 0;
		aspect-ratio: 16 / 10;
		width: 100%;
		border: 2px solid transparent;
		border-radius: 0.75rem;
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.product__thumb.is-active,
	.product__thumb:hover {
		border-color: var(--color-orchid);
		transform: translateY(-1px);
	}

	.product__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.85rem, 3.5vw, 2.5rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.product__badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-top: 1rem;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.75rem;
		border-radius: 999px;
		border: 1px solid var(--color-border-gold);
		background: rgba(29, 36, 35, 0.9);
		color: var(--color-orchid);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.badge--status {
		color: var(--color-mint);
		border-color: var(--color-border-gold-mid);
	}

	.badge__dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 999px;
		background: var(--color-mint);
	}

	.product__plan-picker {
		display: grid;
		gap: 0.65rem;
		margin-top: 1.35rem;
		width: 100%;
		box-sizing: border-box;
	}

	.product__plans {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		align-items: stretch;
		width: 100%;
	}

	.product__plan-summary {
		width: 100%;
	}

	.product__plan-picker .cart-btn {
		width: 100%;
		margin-top: 0;
		box-sizing: border-box;
	}

	.product__plan {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.15rem;
		min-height: 4.75rem;
		height: 100%;
		width: 100%;
		padding: 0.9rem 1rem;
		border-radius: 0.9rem;
		border: 1px solid var(--color-border-gold);
		background: rgba(26, 22, 38, 0.85);
		color: var(--color-ink);
		font: inherit;
		text-align: left;
		cursor: pointer;
		box-sizing: border-box;
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			filter 0.2s ease;
	}

	.product__plan.is-selected {
		border-color: var(--color-border-gold-hover);
		box-shadow: inset 0 0 0 1px var(--color-border-gold-mid);
	}

	.product__plan:hover {
		border-color: var(--color-border-gold-hover);
	}

	.product__plan--featured {
		border-color: var(--color-border-gold-hover);
		background: var(--gradient-brand, linear-gradient(180deg, #3a3d37, #1D2423));
		color: white;
	}

	.product__plan--featured.is-selected {
		border-color: rgba(255, 255, 255, 0.55);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
	}

	.product__plan--featured:hover {
		filter: brightness(1.05);
		color: white;
	}

	.product__plan-label {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.product__plan--featured .product__plan-label {
		color: rgba(255, 255, 255, 0.86);
	}

	.product__plan-price {
		font-family: var(--font-display);
		font-size: clamp(1.7rem, 3.4vw, 2.15rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.product__price-row {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.35rem 0.85rem;
		margin-top: 1.35rem;
	}

	.product__price {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.product__price-note {
		margin: 0;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--color-muted);
	}

	.cart-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		width: 100%;
		margin-top: 1.25rem;
		padding: 1rem 1.25rem;
		border: 0;
		border-radius: 0.9rem;
		color: white;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.01em;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.28);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			filter 0.2s ease;
	}

	.cart-btn:hover {
		transform: translateY(-1px);
		filter: brightness(1.05);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.32);
		color: white;
	}

	.buy-also {
		margin-top: 1.35rem;
	}

	.buy-also__label {
		margin: 0 0 0.65rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-faint);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.buy-also__row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.alt-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.65rem 0.95rem;
		border-radius: 999px;
		border: 1px solid var(--color-border-gold);
		background: rgba(26, 22, 38, 0.8);
		color: var(--color-muted);
		font-size: 0.82rem;
		font-weight: 600;
		transition:
			color 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.alt-link:hover {
		color: var(--color-ink);
		border-color: var(--color-border-gold-hover);
		background: rgba(29, 36, 35, 0.85);
	}

	@keyframes card-in {
		from {
			opacity: 0;
			transform: translateY(22px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.product__details {
		min-width: 0;
		padding-top: 0.15rem;
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	@media (max-width: 900px) {
		.product {
			grid-template-columns: 1fr;
			padding: 1rem;
			gap: 1.15rem;
		}
	}

	@media (max-width: 560px) {
		.product {
			padding: 0.85rem;
			border-radius: 1rem;
		}

		.product__title {
			font-size: clamp(1.45rem, 6.5vw, 1.85rem);
		}

		.product__badges {
			gap: 0.4rem;
		}

		.badge {
			font-size: 0.66rem;
			padding: 0.38rem 0.62rem;
		}

		.product__thumbs {
			display: flex;
			gap: 0.5rem;
			overflow-x: auto;
			padding-bottom: 0.25rem;
			scroll-snap-type: x mandatory;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}

		.product__thumbs::-webkit-scrollbar {
			display: none;
		}

		.product__thumb {
			flex: 0 0 42%;
			max-width: 9.5rem;
			scroll-snap-align: start;
		}

		.product__plan {
			min-height: var(--touch-min);
		}

		.product__price {
			font-size: clamp(1.75rem, 8vw, 2.25rem);
		}

		.alt-link {
			flex: 1 1 100%;
			justify-content: center;
			min-height: var(--touch-min);
		}

		.cart-btn {
			min-height: var(--touch-min);
		}
	}
</style>
