---
import { getUi, type PageId } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { enlistedGameplayImages } from '../data/enlisted';
import { productInfo } from '../data/site';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
}

type FeatureId = 'esp' | 'aimbot' | 'wallhack' | 'radar' | 'combat';

const locale = Astro.props.locale ?? defaultLocale;
const pageId = Astro.props.pageId;
const ui = getUi(locale);

const sectionTitle = locale === 'en' ? 'Cheat Features' : ui.nav.features;
const platformLabel = productInfo.platforms[0];

const pageToFeature: Partial<Record<PageId, FeatureId>> = {
	'enlisted-esp': 'esp',
	'enlisted-aimbot': 'aimbot',
	wallhack: 'wallhack',
	radar: 'radar',
	hacks: 'combat',
	'esp-hack': 'esp',
	'aimbot-hack': 'aimbot',
	'soft-aim': 'aimbot',
	'cheats-2026': 'combat',
	'best-cheats': 'combat',
	'mod-menu': 'combat',
};

const highlightId = pageId ? pageToFeature[pageId] : undefined;

const cards: {
	id: FeatureId;
	badge: string;
	headline: string;
	desc: string;
	image: string;
	alt: string;
	href: string;
}[] = [
	{
		id: 'esp',
		badge: 'ESP',
		headline:
			locale === 'en'
				? 'Soldiers visible through terrain'
				: ui.nav.esp,
		desc:
			locale === 'en'
				? 'Top-down radar plus soldier icons that stay readable through hills, smoke, and heavy cover.'
				: productInfo.features.esp[0],
		image: enlistedGameplayImages.esp,
		alt: 'Enlisted ESP overlay showing soldier boxes and distance readouts in combat',
		href: getLocalizedPath('enlisted-esp', locale),
	},
	{
		id: 'aimbot',
		badge: locale === 'en' ? 'AIMBOT' : ui.nav.aimbot.toUpperCase(),
		headline:
			locale === 'en'
				? 'Soft aim with per-weapon profiles'
				: ui.nav.aimbot,
		desc:
			locale === 'en'
				? 'FOV arc, smoothing, weak-point lock, and hold or toggle modes for rifles and SMGs.'
				: productInfo.features.aimbot[0],
		image: enlistedGameplayImages.aimbot,
		alt: 'Enlisted aimbot targeting overlay with FOV and weak-point lock in a firefight',
		href: getLocalizedPath('enlisted-aimbot', locale),
	},
	{
		id: 'wallhack',
		badge: 'WALLHACK',
		headline:
			locale === 'en'
				? 'Enemy boxes through walls'
				: 'Wallhack',
		desc:
			locale === 'en'
				? 'Bounding boxes, snaplines, and team colour coding through terrain and obstacles.'
				: productInfo.features.esp[1],
		image: enlistedGameplayImages.wallhack,
		alt: 'Enlisted wallhack ESP highlighting enemies through terrain and cover',
		href: getLocalizedPath('wallhack', locale),
	},
	{
		id: 'radar',
		badge: 'RADAR',
		headline:
			locale === 'en'
				? 'Skeleton ESP and snaplines'
				: ui.nav.radar ?? 'Radar',
		desc:
			locale === 'en'
				? '2D radar, skeleton boxes, snaplines, and soldier distance tags during heavy battles.'
				: productInfo.features.radar[0],
		image: enlistedGameplayImages.radar,
		alt: 'Enlisted 2D radar minimap showing off-screen enemy positions',
		href: getLocalizedPath('radar', locale),
	},
	{
		id: 'combat',
		badge: locale === 'en' ? 'COMBAT' : (ui.nav.cheats ?? 'Cheats').toUpperCase(),
		headline:
			locale === 'en'
				? 'Frontline overlays in live fights'
				: (ui.nav.cheats ?? 'Cheats'),
		desc:
			locale === 'en'
				? 'Soldier, vehicle, and artillery ESP with officer markers for large-scale battles.'
				: productInfo.features.esp[4],
		image: enlistedGameplayImages.combat,
		alt: 'Enlisted combat ESP with live soldier and vehicle overlays in a large-scale battle',
		href: getLocalizedPath('hacks', locale),
	},
];

const displayCards = [...cards, ...cards];
---

<section
	class:list={['feat-scroll', highlightId && 'feat-scroll--highlight']}
	aria-labelledby="feat-scroll-title"
	data-feat-carousel
>
	<div class="feat-scroll__shell shell">
		<div class="feat-scroll__head">
			<h2 id="feat-scroll-title" class="feat-scroll__title">{sectionTitle}</h2>
		</div>
	</div>

	<div class="feat-scroll__viewport" data-feat-viewport>
		<div class="feat-scroll__track" data-feat-track>
			{
				displayCards.map((card, index) => {
					const isFeatured = highlightId === card.id;
					const isDuplicate = index >= cards.length;

					return (
						<a
							href={card.href}
							class:list={['feat-scroll__card', isFeatured && 'feat-scroll__card--featured']}
							data-feature-card
							data-feature-id={card.id}
							tabindex={isDuplicate ? -1 : 0}
							aria-hidden={isDuplicate ? 'true' : undefined}
						>
							<div class="feat-scroll__card-media">
								<img src={card.image} alt={card.alt} width="640" height="360" loading="lazy" decoding="async" />
							</div>
							<div class="feat-scroll__card-body">
								<div class="feat-scroll__meta">
									<span class="feat-scroll__badge">{card.badge}</span>
									<span class="feat-scroll__platform">{platformLabel}</span>
								</div>
								<h3 class="feat-scroll__headline">{card.headline}</h3>
								<p class="feat-scroll__desc">{card.desc}</p>
							</div>
						</a>
					);
				})
			}
		</div>
	</div>
</section>

<script>
	const carousel = document.querySelector('[data-feat-carousel]');
	if (carousel) {
		const viewport = carousel.querySelector('[data-feat-viewport]') as HTMLElement | null;
		const track = carousel.querySelector('[data-feat-track]') as HTMLElement | null;

		const pause = () => track?.style.setProperty('animation-play-state', 'paused');
		const play = () => track?.style.setProperty('animation-play-state', 'running');

		viewport?.addEventListener('mouseenter', pause);
		viewport?.addEventListener('mouseleave', play);
		viewport?.addEventListener('focusin', pause);
		viewport?.addEventListener('focusout', () => {
			if (!carousel.contains(document.activeElement)) play();
		});
	}
</script>

<style>
	.feat-scroll {
		position: relative;
		overflow: hidden;
		padding: 2rem 0 2.5rem;
		background: #050607;
	}

	.feat-scroll__shell {
		margin-bottom: 1.25rem;
	}

	.feat-scroll__head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.45rem;
	}

	.feat-scroll__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.6vw, 1.75rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-ink);
	}

	.feat-scroll__viewport {
		overflow: hidden;
		width: 100vw;
		max-width: 100vw;
		margin-left: calc(50% - 50vw);
	}

	.feat-scroll__track {
		display: flex;
		align-items: stretch;
		width: max-content;
		gap: 0.75rem;
		padding-inline: 0.75rem;
		animation: feat-scroll-marquee 42s linear infinite;
		will-change: transform;
	}

	.feat-scroll__card {
		display: flex;
		flex: 0 0 clamp(16rem, 28vw, 20rem);
		width: clamp(16rem, 28vw, 20rem);
		flex-direction: column;
		border-radius: 0;
		background: transparent;
		color: inherit;
		text-decoration: none;
		overflow: hidden;
		transition: opacity 0.2s ease;
	}

	.feat-scroll__card:hover,
	.feat-scroll__card:focus-visible {
		opacity: 0.92;
	}

	.feat-scroll__card--featured {
		outline: 1px solid rgba(200, 155, 95, 0.45);
		outline-offset: 2px;
	}

	.feat-scroll__card-media {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #0a0c0d;
		border-radius: 0;
	}

	.feat-scroll__card-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.feat-scroll__card-body {
		display: grid;
		gap: 0.55rem;
		padding: 0.85rem 0 0;
		text-align: left;
	}

	.feat-scroll__meta {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		flex-wrap: wrap;
	}

	.feat-scroll__badge {
		display: inline-flex;
		align-items: center;
		padding: 0.2rem 0.45rem;
		background: #c89b5f;
		color: #0a0a0a;
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		line-height: 1.2;
		border-radius: 0;
	}

	.feat-scroll__platform {
		font-size: 0.72rem;
		font-weight: 500;
		color: #808080;
	}

	.feat-scroll__headline {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 1.8vw, 1.35rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: 0.01em;
		color: #ffffff;
		text-wrap: balance;
	}

	.feat-scroll__desc {
		margin: 0;
		font-size: 0.8rem;
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.72);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@keyframes feat-scroll-marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(calc(-50% - 0.375rem));
		}
	}

	@media (max-width: 760px) {
		.feat-scroll {
			padding: 1.75rem 0 2rem;
		}

		.feat-scroll__card {
			flex-basis: 15rem;
			width: 15rem;
		}

		.feat-scroll__track {
			gap: 0.6rem;
			padding-inline: 0.6rem;
			animation-duration: 32s;
		}

		@keyframes feat-scroll-marquee {
			from {
				transform: translateX(0);
			}
			to {
				transform: translateX(calc(-50% - 0.3rem));
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.feat-scroll__track {
			animation: none;
			overflow-x: auto;
			width: max-content;
			padding-inline: 0.75rem;
			scroll-snap-type: x mandatory;
			-webkit-overflow-scrolling: touch;
		}

		.feat-scroll__viewport {
			overflow-x: auto;
		}

		.feat-scroll__card {
			scroll-snap-align: start;
		}
	}
</style>
