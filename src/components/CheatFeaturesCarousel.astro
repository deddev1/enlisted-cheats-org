---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { enlistedGameplayImages } from '../data/enlisted';
import { productInfo } from '../data/site';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const sectionTitle = locale === 'en' ? 'Cheat Features' : ui.nav.features;

const cards = [
	{
		title: 'ESP',
		desc:
			locale === 'en'
				? 'Enemy outlines, health bars, and distance readouts through terrain and cover.'
				: productInfo.features.esp[0],
		image: enlistedGameplayImages.esp,
		alt: 'Enlisted ESP overlay showing soldier boxes and distance readouts in combat',
		href: getLocalizedPath('enlisted-esp', locale),
	},
	{
		title: locale === 'en' ? 'Aimbot' : ui.nav.aimbot,
		desc:
			locale === 'en'
				? 'FOV, smoothing, and bone priority for rifles, SMGs, and snipers.'
				: productInfo.features.aimbot[0],
		image: enlistedGameplayImages.aimbot,
		alt: 'Enlisted aimbot targeting overlay with FOV and weak-point lock in a firefight',
		href: getLocalizedPath('enlisted-aimbot', locale),
	},
	{
		title: 'Wallhack',
		desc:
			locale === 'en'
				? 'See enemies through walls with boxes, snaplines, and team colour coding.'
				: productInfo.features.esp[1],
		image: enlistedGameplayImages.wallhack,
		alt: 'Enlisted wallhack ESP highlighting enemies through terrain and cover',
		href: getLocalizedPath('wallhack', locale),
	},
	{
		title: 'Radar',
		desc:
			locale === 'en'
				? '2D off-screen radar for flanks, spawn pushes, and early rotations.'
				: productInfo.features.radar[0],
		image: enlistedGameplayImages.radar,
		alt: 'Enlisted 2D radar minimap showing off-screen enemy positions',
		href: getLocalizedPath('radar', locale),
	},
	{
		title: locale === 'en' ? 'Combat ESP' : ui.nav.cheats ?? 'Cheats',
		desc:
			locale === 'en'
				? 'Live overlays for soldiers, vehicles, and bosses in frontline fights.'
				: productInfo.features.esp[4],
		image: enlistedGameplayImages.combat,
		alt: 'Enlisted combat ESP with live soldier and vehicle overlays in a large-scale battle',
		href: getLocalizedPath('hacks', locale),
	},
] as const;
---

<section class="feat-scroll" aria-labelledby="feat-scroll-title">
	<div class="feat-scroll__bg" aria-hidden="true">
		<img
			src={enlistedGameplayImages.combat}
			alt=""
			width="1600"
			height="900"
			class="feat-scroll__bg-img"
			loading="lazy"
			decoding="async"
		/>
		<div class="feat-scroll__bg-veil"></div>
	</div>

	<div class="feat-scroll__head">
		<h2 id="feat-scroll-title" class="feat-scroll__title">{sectionTitle}</h2>
	</div>

	<div class="feat-scroll__viewport">
		<div class="feat-scroll__track" data-feat-track>
			{
				[...cards, ...cards].map((card) => (
					<a href={card.href} class="feat-scroll__card">
						<div class="feat-scroll__card-media">
							<img src={card.image} alt={card.alt} width="420" height="260" loading="lazy" decoding="async" />
						</div>
						<div class="feat-scroll__card-body">
							<h3 class="feat-scroll__card-title">{card.title}</h3>
							<p class="feat-scroll__card-desc">{card.desc}</p>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.feat-scroll {
		position: relative;
		overflow: hidden;
		padding: 2.25rem 0 2.5rem;
		isolation: isolate;
	}

	.feat-scroll__bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.feat-scroll__bg-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
		filter: grayscale(0.55) saturate(0.45) brightness(0.42) contrast(1.05);
		transform: scale(1.04);
	}

	.feat-scroll__bg-veil {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(8, 10, 11, 0.72) 0%, rgba(8, 10, 11, 0.55) 45%, rgba(8, 10, 11, 0.82) 100%),
			radial-gradient(ellipse 90% 70% at 50% 50%, rgba(13, 17, 18, 0.15) 0%, rgba(8, 10, 11, 0.75) 100%);
	}

	.feat-scroll__head {
		position: relative;
		z-index: 1;
		display: flex;
		justify-content: center;
		margin-bottom: 1.5rem;
		text-align: center;
	}

	.feat-scroll__title {
		margin: 0;
		width: 100%;
		max-width: var(--page-max);
		padding-inline: var(--page-gutter);
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 2rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-ink);
		text-shadow: 0 2px 16px rgba(0, 0, 0, 0.65);
	}

	.feat-scroll__viewport {
		position: relative;
		z-index: 1;
		overflow: hidden;
		width: 100%;
	}

	.feat-scroll__track {
		display: flex;
		align-items: stretch;
		width: max-content;
		gap: 0;
		animation: feat-scroll-marquee 28s linear infinite;
		will-change: transform;
	}

	.feat-scroll__card {
		display: flex;
		flex-direction: column;
		flex: 0 0 calc(100vw / 5);
		width: calc(100vw / 5);
		min-height: 20.5rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-left-width: 0;
		background: rgba(10, 12, 13, 0.62);
		color: inherit;
		text-decoration: none;
		transition:
			background 0.25s ease,
			border-color 0.25s ease;
	}

	.feat-scroll__card:first-child {
		border-left-width: 1px;
	}

	.feat-scroll__card:hover {
		background: rgba(14, 17, 18, 0.82);
		border-color: rgba(197, 138, 69, 0.32);
		z-index: 1;
	}

	.feat-scroll__card-media {
		flex: 0 0 auto;
		height: 10.75rem;
		overflow: hidden;
		background: #0a0c0d;
	}

	.feat-scroll__card-media img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
		background: #0a0c0d;
		transition: transform 0.35s ease;
	}

	.feat-scroll__card:hover .feat-scroll__card-media img {
		transform: scale(1.03);
	}

	.feat-scroll__card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		gap: 0.45rem;
		min-height: 9.5rem;
		padding: 0.9rem 0.75rem 1rem;
		text-align: center;
		background: linear-gradient(180deg, rgba(8, 10, 11, 0.4) 0%, rgba(8, 10, 11, 0.88) 100%);
	}

	.feat-scroll__card-title {
		margin: 0;
		width: 100%;
		font-size: 0.88rem;
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-ink);
	}

	.feat-scroll__card-desc {
		margin: 0;
		width: 100%;
		max-width: 14.5rem;
		font-size: 0.76rem;
		line-height: 1.5;
		color: rgba(241, 238, 229, 0.72);
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}

	@keyframes feat-scroll-marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (max-width: 760px) {
		.feat-scroll {
			padding: 1.75rem 0 2rem;
		}

		.feat-scroll__card {
			flex-basis: calc(100vw / 2.25);
			width: calc(100vw / 2.25);
			min-height: 19rem;
		}

		.feat-scroll__card-media {
			height: 9rem;
		}

		.feat-scroll__card-body {
			min-height: 9rem;
		}

		.feat-scroll__track {
			animation-duration: 20s;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.feat-scroll__track {
			animation: none;
			flex-wrap: nowrap;
			overflow-x: auto;
			width: 100%;
			padding-inline: var(--page-gutter);
			scroll-snap-type: x mandatory;
			-webkit-overflow-scrolling: touch;
		}

		.feat-scroll__viewport {
			mask-image: none;
			overflow-x: auto;
		}

		.feat-scroll__card {
			scroll-snap-align: start;
		}

		.feat-scroll__card:nth-child(n + 6) {
			display: none;
		}
	}
</style>
