---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { enlistedHeroImage, enlistedGameplayImages } from '../data/enlisted';
import { productInfo, siteConfig } from '../data/site';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const buyUrl = siteConfig.checkoutUrl;
const setupHref = getLocalizedPath('setup', locale);
const pricingHref = getLocalizedPath('pricing', locale);
const featuresHref = getLocalizedPath('features', locale);

const monthlyPlan = productInfo.plans.find((plan) => plan.id === 'monthly')!;
const lifetimePlan = productInfo.plans.find((plan) => plan.id === 'lifetime')!;

const heading = locale === 'en' ? 'Cheats for Enlisted' : productInfo.name;

const leadCopy =
	locale === 'en'
		? 'Get ESP, aimbot, wallhack, and radar for Enlisted on Windows PC. Instant digital delivery after purchase — use monthly or lifetime access.'
		: productInfo.summary;

const premiumTitle = locale === 'en' ? 'Lifetime License' : ui.product.lifetime;

const premiumCopy =
	locale === 'en'
		? `One-time $${lifetimePlan.price} purchase with no renewals. Full feature stack, setup help, and anti-cheat updates for as long as you play Enlisted.`
		: `${productInfo.planSummaries.lifetime[1]}. ${productInfo.planSummaries.lifetime[2]}.`;

const primaryLabel = locale === 'en' ? 'Get Access' : ui.common.buyNow;
const setupLabel = locale === 'en' ? 'Setup guide' : ui.nav.setup;
const requirementsLabel = locale === 'en' ? 'System requirements' : ui.nav.setup;
const purchaseLabel = locale === 'en' ? 'Purchase' : ui.common.buyNow;
const platformLabel = locale === 'en' ? 'Available on Windows PC:' : productInfo.platforms[0];
---

<section class="promo" id="gallery" aria-labelledby="promo-title">
	<div class="promo__bg" aria-hidden="true">
		<img
			src={enlistedHeroImage}
			alt=""
			width="1600"
			height="900"
			class="promo__bg-img"
			loading="lazy"
			decoding="async"
		/>
		<div class="promo__bg-veil"></div>
	</div>

	<div class="promo__grid">
		<div class="promo__main">
			<h1 id="promo-title" class="promo__title">{heading}</h1>
			<p class="promo__lead">{leadCopy}</p>

			<div class="promo__actions">
				<a href={buyUrl} class="promo__cta promo__cta--primary" rel="noopener noreferrer">
					<img src="/images/enlisted-brand-mark.svg" alt="" width="88" height="24" class="promo__cta-logo" />
					<span>{primaryLabel}</span>
				</a>
				<a href={setupHref} class="promo__cta promo__cta--ghost">
					<svg class="promo__cta-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path
							fill="currentColor"
							d="M4 5h16a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-5.2l-2.3 2.8a.75.75 0 0 1-1.2 0L9.2 15H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2v6h14V7H5Z"
						></path>
					</svg>
					<span>{setupLabel}</span>
				</a>
				<a href={featuresHref} class="promo__cta promo__cta--ghost">
					<svg class="promo__cta-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path
							fill="currentColor"
							d="M4 4h16v2H4V4Zm0 5h10v2H4V9Zm0 5h16v2H4v-2Zm0 5h10v2H4v-2Z"
						></path>
					</svg>
					<span>{requirementsLabel}</span>
				</a>
			</div>

			<div class="promo__platforms">
				<p class="promo__platforms-label">{platformLabel}</p>
				<div class="promo__platforms-row">
					<span class="promo__platform-badge">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								fill="currentColor"
								d="M3 5.5 10.5 4v7.1H3V5.5Zm10.5-.9L21 3.6V11h-7.5V4.6ZM3 12.9h7.5V20L3 18.5v-5.6Zm9 0H21V18.4L12.5 20v-7.1Z"
							></path>
						</svg>
						Windows PC
					</span>
					<span class="promo__platform-note">
						{locale === 'en' ? `From $${monthlyPlan.price}/mo` : `$${monthlyPlan.price}`}
					</span>
				</div>
			</div>
		</div>

		<aside class="promo__premium" aria-labelledby="promo-premium-title">
			<div class="promo__premium-media">
				<img
					src={enlistedGameplayImages.combat}
					alt="Enlisted squad combat with ESP and aimbot overlays active"
					width="420"
					height="240"
					loading="lazy"
					decoding="async"
				/>
			</div>
			<div class="promo__premium-body">
				<h2 id="promo-premium-title" class="promo__premium-title">{premiumTitle}</h2>
				<p class="promo__premium-copy">{premiumCopy}</p>
				<a href={pricingHref} class="promo__purchase">{purchaseLabel}</a>
			</div>
		</aside>
	</div>
</section>

<style>
	.promo {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		padding: 2rem 0 2.25rem;
	}

	.promo__bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.promo__bg-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
		filter: grayscale(0.35) saturate(0.55) brightness(0.5) contrast(1.05);
		transform: scale(1.03);
	}

	.promo__bg-veil {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(8, 10, 11, 0.88) 0%, rgba(8, 10, 11, 0.72) 52%, rgba(8, 10, 11, 0.82) 100%),
			linear-gradient(180deg, rgba(8, 10, 11, 0.35) 0%, rgba(8, 10, 11, 0.65) 100%);
	}

	.promo__grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 22rem);
		gap: 1.25rem;
		align-items: stretch;
		width: min(100% - 2 * var(--page-gutter), var(--page-max));
		margin-inline: auto;
		padding-inline: var(--page-gutter);
	}

	.promo__main {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1rem;
		min-height: 18rem;
		padding: 1.25rem 0;
	}

	.promo__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.65rem, 3.4vw, 2.35rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #fff;
		text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55);
	}

	.promo__lead {
		margin: 0;
		max-width: 34rem;
		font-size: clamp(0.88rem, 1.5vw, 0.98rem);
		line-height: 1.55;
		color: rgba(241, 238, 229, 0.88);
	}

	.promo__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
	}

	.promo__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		min-height: 2.75rem;
		padding: 0.65rem 1.1rem;
		border-radius: 0.35rem;
		font-size: 0.78rem;
		font-weight: 800;
		line-height: 1;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.promo__cta--primary {
		background: linear-gradient(180deg, #ffb347 0%, #e8922e 100%);
		color: #1a1208;
		box-shadow: 0 4px 14px rgba(232, 146, 46, 0.35);
		padding-inline: 1.25rem;
	}

	.promo__cta--primary:hover {
		background: linear-gradient(180deg, #ffc164 0%, #f0a040 100%);
		transform: translateY(-1px);
	}

	.promo__cta-logo {
		width: auto;
		height: 1.1rem;
		filter: brightness(0.15);
	}

	.promo__cta--ghost {
		border: 1px solid rgba(255, 255, 255, 0.28);
		background: rgba(8, 10, 11, 0.55);
		color: #fff;
	}

	.promo__cta--ghost:hover {
		border-color: rgba(255, 255, 255, 0.45);
		background: rgba(14, 17, 18, 0.75);
	}

	.promo__cta-icon {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
		opacity: 0.9;
	}

	.promo__platforms {
		margin-top: 0.35rem;
	}

	.promo__platforms-label {
		margin: 0 0 0.45rem;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(241, 238, 229, 0.55);
	}

	.promo__platforms-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
	}

	.promo__platform-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(241, 238, 229, 0.82);
	}

	.promo__platform-badge svg {
		width: 1rem;
		height: 1rem;
	}

	.promo__platform-note {
		font-size: 0.78rem;
		color: rgba(241, 238, 229, 0.62);
	}

	.promo__premium {
		display: flex;
		flex-direction: column;
		border: 2px solid rgba(212, 168, 67, 0.85);
		background: rgba(8, 10, 11, 0.78);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
	}

	.promo__premium-media {
		flex: 0 0 auto;
		overflow: hidden;
		border-bottom: 1px solid rgba(212, 168, 67, 0.25);
	}

	.promo__premium-media img {
		display: block;
		width: 100%;
		height: 9.5rem;
		object-fit: cover;
		object-position: center 35%;
	}

	.promo__premium-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.65rem;
		padding: 0.9rem 0.85rem 1rem;
	}

	.promo__premium-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #d4a843;
		text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
	}

	.promo__premium-copy {
		margin: 0;
		flex: 1;
		font-size: 0.76rem;
		line-height: 1.55;
		color: rgba(241, 238, 229, 0.78);
	}

	.promo__purchase {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		border-radius: 0.3rem;
		background: linear-gradient(180deg, #ffb347 0%, #e8922e 100%);
		color: #1a1208;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			background 0.2s ease;
	}

	.promo__purchase:hover {
		background: linear-gradient(180deg, #ffc164 0%, #f0a040 100%);
		transform: translateY(-1px);
	}

	@media (max-width: 900px) {
		.promo__grid {
			grid-template-columns: 1fr;
			max-width: 36rem;
		}

		.promo__main {
			min-height: auto;
		}

		.promo__premium {
			max-width: 22rem;
		}
	}

	@media (max-width: 560px) {
		.promo {
			padding: 1.5rem 0 1.75rem;
		}

		.promo__actions {
			flex-direction: column;
			align-items: stretch;
		}

		.promo__cta {
			width: 100%;
		}

		.promo__premium {
			max-width: none;
		}
	}
</style>
