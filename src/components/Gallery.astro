---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { enlistedHeroImage, enlistedGameplayImages, enlistedOfficialImages } from '../data/enlisted';
import { productInfo, siteConfig } from '../data/site';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const buyUrl = siteConfig.checkoutUrl;
const setupHref = getLocalizedPath('setup', locale);
const pricingHref = getLocalizedPath('pricing', locale);
const featuresHref = getLocalizedPath('features', locale);

const monthlyPlan = productInfo.plans.find((plan) => plan.id === 'monthly')!;
const lifetimePlan = productInfo.plans.find((plan) => plan.id === 'lifetime')!;

const heading = locale === 'en' ? 'Cheats for Enlisted' : productInfo.name;

const leadCopy =
	locale === 'en'
		? 'ESP, aimbot, wallhack, and radar for Enlisted on Windows PC. Instant delivery — monthly or lifetime.'
		: productInfo.summary;

const premiumTitle = locale === 'en' ? 'Lifetime License' : ui.product.lifetime;

const premiumCopy =
	locale === 'en'
		? `One-time $${lifetimePlan.price}. Full stack, setup help, and anti-cheat updates while you play.`
		: `${productInfo.planSummaries.lifetime[1]}. ${productInfo.planSummaries.lifetime[2]}.`;

const primaryLabel = locale === 'en' ? 'Get Access' : ui.common.buyNow;
const setupLabel = locale === 'en' ? 'Setup guide' : ui.nav.setup;
const featuresLabel = locale === 'en' ? 'Game features' : ui.nav.features;
const purchaseLabel = locale === 'en' ? 'Purchase' : ui.common.buyNow;
const platformLabel = locale === 'en' ? 'Available on Windows PC:' : productInfo.platforms[0];
---

<section class="promo" aria-labelledby="promo-title">
	<div class="promo__bg" aria-hidden="true">
		<img
			src={enlistedHeroImage}
			alt={ui.images.hero}
			width="1600"
			height="900"
			class="promo__bg-img"
			loading="lazy"
			decoding="async"
		/>
		<div class="promo__bg-veil"></div>
	</div>

	<div class="promo__grid">
		<div class="promo__main">
			<h2 id="promo-title" class="promo__title">{heading}</h2>
			<p class="promo__lead">{leadCopy}</p>

			<div class="promo__actions">
				<a href={buyUrl} class="promo__cta promo__cta--primary" rel="noopener noreferrer">
					<img
						src={siteConfig.logo}
						alt={siteConfig.logoAlt}
						width="1536"
						height="1024"
						class="promo__cta-logo"
					/>
					<span>{primaryLabel}</span>
				</a>
				<a href={setupHref} class="promo__cta promo__cta--ghost">
					<svg class="promo__cta-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path
							fill="currentColor"
							d="M4 5h16a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-5.2l-2.3 2.8a.75.75 0 0 1-1.2 0L9.2 15H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2v6h14V7H5Z"
						></path>
					</svg>
					<span>{setupLabel}</span>
				</a>
				<a href={featuresHref} class="promo__cta promo__cta--ghost">
					<svg class="promo__cta-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path
							fill="currentColor"
							d="M4 4h16v2H4V4Zm0 5h10v2H4V9Zm0 5h16v2H4v-2Zm0 5h10v2H4v-2Z"
						></path>
					</svg>
					<span>{featuresLabel}</span>
				</a>
			</div>

			<div class="promo__platforms">
				<p class="promo__platforms-label">{platformLabel}</p>
				<div class="promo__platforms-row">
					<span class="promo__platform-badge">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								fill="currentColor"
								d="M3 5.5 10.5 4v7.1H3V5.5Zm10.5-.9L21 3.6V11h-7.5V4.6ZM3 12.9h7.5V20L3 18.5v-5.6Zm9 0H21V18.4L12.5 20v-7.1Z"
							></path>
						</svg>
						Windows PC
					</span>
					<span class="promo__platform-note">
						{locale === 'en' ? `From $${monthlyPlan.price}/mo` : `$${monthlyPlan.price}`}
					</span>
				</div>
			</div>
		</div>

		<aside class="promo__premium" aria-labelledby="promo-premium-title">
			<div class="promo__premium-media">
				<img
					src={enlistedOfficialImages.combat.src}
					alt={enlistedOfficialImages.combat.alt}
					width="420"
					height="240"
					loading="lazy"
					decoding="async"
				/>
			</div>
			<div class="promo__premium-body">
				<h2 id="promo-premium-title" class="promo__premium-title">{premiumTitle}</h2>
				<p class="promo__premium-copy">{premiumCopy}</p>
				<a href={buyUrl} class="promo__purchase" rel="noopener noreferrer">{purchaseLabel}</a>
			</div>
		</aside>
	</div>
</section>

<style>
	.promo {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		padding: 1.25rem 0 1.35rem;
	}

	.promo__bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.promo__bg-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
		filter: grayscale(0.35) saturate(0.55) brightness(0.5) contrast(1.05);
		transform: scale(1.03);
	}

	.promo__bg-veil {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(8, 10, 11, 0.88) 0%, rgba(8, 10, 11, 0.72) 52%, rgba(8, 10, 11, 0.82) 100%),
			linear-gradient(180deg, rgba(8, 10, 11, 0.35) 0%, rgba(8, 10, 11, 0.65) 100%);
	}

	.promo__grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(11.5rem, 14.5rem);
		gap: 0.85rem;
		align-items: stretch;
		width: 100%;
	}

	.promo__main {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.65rem;
		min-height: auto;
		padding: 0.35rem 0;
	}

	.promo__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 2.2vw, 1.45rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: #fff;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.55);
	}

	.promo__lead {
		margin: 0;
		max-width: 28rem;
		font-size: 0.78rem;
		line-height: 1.45;
		color: rgba(241, 238, 229, 0.84);
	}

	.promo__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
	}

	.promo__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-height: 2.15rem;
		padding: 0.45rem 0.8rem;
		border-radius: 0.28rem;
		font-size: 0.68rem;
		font-weight: 800;
		line-height: 1;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.promo__cta--primary {
		background: linear-gradient(180deg, #ffb347 0%, #e8922e 100%);
		color: #1a1208;
		box-shadow: 0 3px 10px rgba(232, 146, 46, 0.3);
		padding-inline: 0.95rem;
	}

	.promo__cta--primary:hover {
		background: linear-gradient(180deg, #ffc164 0%, #f0a040 100%);
		transform: translateY(-1px);
	}

	.promo__cta-logo {
		width: auto;
		height: 1.15rem;
		object-fit: contain;
	}

	.promo__cta--ghost {
		border: 1px solid var(--color-border-muted);
		background: rgba(8, 10, 11, 0.55);
		color: #fff;
	}

	.promo__cta--ghost:hover {
		border-color: var(--color-border-gold-subtle);
		background: rgba(14, 17, 18, 0.75);
	}

	.promo__cta-icon {
		width: 0.85rem;
		height: 0.85rem;
		flex-shrink: 0;
		opacity: 0.9;
	}

	.promo__platforms {
		margin-top: 0.15rem;
	}

	.promo__platforms-label {
		margin: 0 0 0.3rem;
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(241, 238, 229, 0.5);
	}

	.promo__platforms-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
	}

	.promo__platform-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: rgba(241, 238, 229, 0.78);
	}

	.promo__platform-badge svg {
		width: 0.85rem;
		height: 0.85rem;
	}

	.promo__platform-note {
		font-size: 0.68rem;
		color: rgba(241, 238, 229, 0.58);
	}

	.promo__premium {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--color-border-gold);
		border-radius: 0.25rem;
		background: var(--color-panel-solid);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.04),
			0 14px 32px rgba(0, 0, 0, 0.28);
	}

	.promo__premium-media {
		flex: 0 0 auto;
		overflow: hidden;
		border-bottom: 1px solid var(--color-border-faded);
	}

	.promo__premium-media img {
		display: block;
		width: 100%;
		height: 6.25rem;
		object-fit: cover;
		object-position: center 35%;
	}

	.promo__premium-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.45rem;
		padding: 0.65rem 0.65rem 0.75rem;
	}

	.promo__premium-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 0.82rem;
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #d4a843;
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
	}

	.promo__premium-copy {
		margin: 0;
		flex: 1;
		font-size: 0.68rem;
		line-height: 1.45;
		color: rgba(241, 238, 229, 0.74);
	}

	.promo__purchase {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 2rem;
		border-radius: 0.25rem;
		background: linear-gradient(180deg, #ffb347 0%, #e8922e 100%);
		color: #1a1208;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			background 0.2s ease;
	}

	.promo__purchase:hover {
		background: linear-gradient(180deg, #ffc164 0%, #f0a040 100%);
		transform: translateY(-1px);
	}

	@media (max-width: 900px) {
		.promo__grid {
			grid-template-columns: 1fr;
		}

		.promo__premium {
			max-width: 16rem;
			margin-inline: auto;
		}
	}

	@media (max-width: 560px) {
		.promo {
			padding: 1rem 0 1.1rem;
		}

		.promo__actions {
			flex-direction: column;
			align-items: stretch;
		}

		.promo__cta {
			width: 100%;
		}

		.promo__premium {
			max-width: none;
		}
	}
</style>
