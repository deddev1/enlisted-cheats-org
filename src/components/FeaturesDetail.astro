---
import { featureGallery, featureSectionImages } from '../data/enlisted';
import { getUi } from '../data/i18n';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productFeatureDetails, productInfo, siteConfig } from '../data/site';
import { contentSrc, contentSrcSet, galleryTileSizes, productMainSizes } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const responsiveImage = (src: string) => ({
	src: contentSrc(src),
	srcset: contentSrcSet(src),
});
---

<div class="features-detail">
	{
		productFeatureDetails.map((section, index) => {
			const shot = featureSectionImages[section.id];
			const image = responsiveImage(shot.src);
			return (
				<article class="features-detail__section" id={`feature-${section.id}`}>
					<figure class="features-detail__figure media-frame">
						<img
							src={image.src}
							srcset={image.srcset}
							sizes={productMainSizes}
							alt={shot.alt}
							width="960"
							height="600"
							loading={index === 0 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					</figure>

					<div class="features-detail__section-body">
						<header class="features-detail__section-head">
							<h2>{section.title}</h2>
							<p>{section.summary}</p>
						</header>

						<ul class="features-detail__list">
							{section.items.map((item) => (
								<li class="features-detail__item">
									<h3>{item.name}</h3>
									<p>{item.description}</p>
								</li>
							))}
						</ul>
					</div>
				</article>
			);
		})
	}

	<section class="features-detail__gallery" aria-label="Enlisted cheats screenshots">
		<header class="features-detail__gallery-head">
			<h2>In-game screenshots</h2>
			<p>Menu, ESP, aimbot, and radar from live Enlisted sessions.</p>
		</header>
		<div class="features-detail__gallery-scroller" tabindex="0" aria-label="Scroll through Enlisted screenshots">
			<div class="features-detail__gallery-track">
				{
				featureGallery.map((image) => {
					const responsive = responsiveImage(image.src);
					return (
					<figure class="features-detail__gallery-item media-frame">
						<img
							src={responsive.src}
							srcset={responsive.srcset}
							sizes={galleryTileSizes}
							alt={image.alt}
							width="640"
							height="400"
							loading="lazy"
							decoding="async"
							draggable="false"
						/>
					</figure>
					);
				})
				}
			</div>
		</div>
	</section>

	<div class="features-detail__cta">
		<a href={siteConfig.checkoutUrl} class="features-detail__pricing-link btn-buy" rel="noopener noreferrer">
			{ui.common.buyNow} — from ${productInfo.plans[0].price}/mo
		</a>
		<a href={siteConfig.checkoutUrl} class="features-detail__checkout-link" rel="noopener noreferrer">
			{ui.product.addToCart}
		</a>
	</div>
</div>

<style>
	.features-detail {
		display: grid;
		gap: clamp(2rem, 4vw, 3rem);
		width: 100%;
		margin: 0;
	}

	.features-detail__section {
		display: grid;
		gap: 1.35rem;
		padding: clamp(1.1rem, 2vw, 1.5rem);
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border);
		background: rgba(13, 35, 36, 0.55);
	}

	.features-detail__figure {
		margin: 0;
		width: 100%;
		max-width: 52rem;
		margin-inline: auto;
		aspect-ratio: 16 / 9;
		border: 1px solid rgba(32, 191, 192, 0.16);
		border-radius: 0.85rem;
		overflow: hidden;
	}

	.features-detail__figure.media-frame img,
	.features-detail__gallery-item.media-frame img {
		transform: none;
	}

	.features-detail__figure img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	.features-detail__section-body {
		display: grid;
		gap: 1.25rem;
		max-width: 52rem;
		margin-inline: auto;
		width: 100%;
	}

	.features-detail__section-head {
		display: grid;
		gap: 0.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid rgba(32, 191, 192, 0.12);
	}

	.features-detail__section-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.4vw, 1.5rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-ink);
	}

	.features-detail__section-head p {
		margin: 0;
		max-width: 40rem;
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.features-detail__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0;
	}

	.features-detail__item {
		display: grid;
		gap: 0.3rem;
		padding: 0.95rem 0;
		border-bottom: 1px solid rgba(32, 191, 192, 0.1);
	}

	.features-detail__item:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.features-detail__item:first-child {
		padding-top: 0;
	}

	.features-detail__item h3 {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--color-ink);
		line-height: 1.35;
	}

	.features-detail__item h3::before {
		content: '›';
		margin-right: 0.45rem;
		color: var(--color-orchid);
		font-weight: 800;
	}

	.features-detail__item p {
		margin: 0;
		padding-left: 1.1rem;
		color: var(--color-muted);
		font-size: 0.88rem;
		line-height: 1.55;
	}

	.features-detail__gallery {
		display: grid;
		gap: 1.25rem;
		padding: clamp(1.1rem, 2vw, 1.5rem);
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border);
		background: rgba(13, 35, 36, 0.55);
	}

	.features-detail__gallery-head {
		display: grid;
		gap: 0.45rem;
		max-width: 36rem;
		margin-inline: auto;
		text-align: center;
	}

	.features-detail__gallery-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 2.2vw, 1.4rem);
		font-weight: 800;
		color: var(--color-ink);
	}

	.features-detail__gallery-head p {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.features-detail__gallery-scroller {
		overflow-x: auto;
		overflow-y: hidden;
		margin: 0 -0.25rem;
		padding: 0.15rem 0.25rem 0.65rem;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: 0.25rem;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
		scrollbar-color: rgba(32, 191, 192, 0.45) transparent;
		mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
	}

	.features-detail__gallery-scroller:focus-visible {
		outline: 2px solid var(--color-cyan);
		outline-offset: 2px;
		border-radius: 0.5rem;
	}

	.features-detail__gallery-scroller::-webkit-scrollbar {
		height: 6px;
	}

	.features-detail__gallery-scroller::-webkit-scrollbar-thumb {
		border-radius: 999px;
		background: rgba(32, 191, 192, 0.45);
	}

	.features-detail__gallery-track {
		display: flex;
		gap: 0.85rem;
		width: max-content;
		min-width: 100%;
	}

	.features-detail__gallery-item {
		flex: 0 0 clamp(240px, 38vw, 340px);
		margin: 0;
		aspect-ratio: 16 / 10;
		border: 1px solid rgba(32, 191, 192, 0.12);
		border-radius: 0.7rem;
		overflow: hidden;
		scroll-snap-align: start;
	}

	.features-detail__gallery-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	.features-detail__cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
		padding-top: 0.25rem;
	}

	.features-detail__pricing-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.95rem 1.35rem;
		border-radius: 0.75rem;
		font-weight: 700;
		text-decoration: none;
	}

	.features-detail__checkout-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.95rem 1.35rem;
		border-radius: 0.75rem;
		border: 1px solid var(--color-border);
		background: rgba(13, 35, 36, 0.9);
		color: var(--color-muted);
		font-weight: 650;
		text-decoration: none;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.features-detail__checkout-link:hover {
		color: var(--color-ink);
		border-color: rgba(32, 191, 192, 0.45);
	}

	@media (max-width: 640px) {
		.features-detail__gallery-item {
			flex-basis: clamp(220px, 78vw, 300px);
		}

		.features-detail__cta {
			flex-direction: column;
		}

		.features-detail__pricing-link,
		.features-detail__checkout-link {
			width: 100%;
		}
	}
</style>
