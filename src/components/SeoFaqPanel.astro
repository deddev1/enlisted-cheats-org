---
import FaqList, { type FaqItem } from './FaqList.astro';

interface Props {
	items: ReadonlyArray<FaqItem>;
	title?: string;
	intro?: string;
}

const {
	items,
	title = 'Common questions',
	intro = 'Answers about Enlisted Cheats features, gameplay fit, patch-day status, and where to get help.',
} = Astro.props;
---

{
	items.length > 0 && (
		<section class="seo-faq card-panel" aria-labelledby="seo-faq-heading">
			<div class="seo-faq__head">
				<h2 id="seo-faq-heading">{title}</h2>
				<p class="seo-faq__intro">{intro}</p>
			</div>
			<FaqList items={items} groupByCategory />
		</section>
	)
}

<style>
	.seo-faq {
		display: grid;
		gap: 1rem;
	}

	.seo-faq__head {
		display: grid;
		gap: 0.45rem;
	}

	.seo-faq__head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.5vw, 1.55rem);
		font-weight: 800;
	}

	.seo-faq__intro {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.6;
		font-size: 0.92rem;
		max-width: 44rem;
	}
</style>
