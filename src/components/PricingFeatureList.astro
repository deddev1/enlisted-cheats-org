---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productFeatureCategories } from '../data/site';
import RelatedPages from './RelatedPages.astro';

interface Props {
	locale?: LocaleCode;
	showFullLink?: boolean;
	showRelatedPages?: boolean;
}

const locale = Astro.props.locale ?? defaultLocale;
const showFullLink = Astro.props.showFullLink ?? true;
const showRelatedPages = Astro.props.showRelatedPages ?? true;
const ui = getUi(locale);
const featuresHref = getLocalizedPath('features', locale);
---

<section class="pricing-features" aria-labelledby="pricing-features-title">
	<header class="pricing-features__head">
		<div class="pricing-features__intro">
			<h2 id="pricing-features-title" class="pricing-features__title">
				<span class="pricing-features__accent" aria-hidden="true"></span>
				Features
			</h2>
			<p class="pricing-features__subtitle">
				Everything included for campaign missions, squad assaults, and large-scale battles on Windows PC.
			</p>
		</div>
		<div class="pricing-features__badges">
			<span class="pricing-features__badge">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="m9.5 12 1.8 1.8 3.7-3.8M12 3.5 5 6.5v5.2c0 4.2 2.9 7.8 7 8.8 4.1-1 7-4.6 7-8.8V6.5L12 3.5Z"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				Windows 10/11
			</span>
			<span class="pricing-features__badge">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="m9.5 12 1.8 1.8 3.7-3.8M12 3.5 5 6.5v5.2c0 4.2 2.9 7.8 7 8.8 4.1-1 7-4.6 7-8.8V6.5L12 3.5Z"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				Intel/AMD
			</span>
		</div>
	</header>

	<div class="pricing-features__grid">
		{
			productFeatureCategories.map((category) => (
				<article class="pricing-features__card">
					<h3 class="pricing-features__card-title">{category.title}</h3>
					<ul
						class:list={[
							'pricing-features__list',
							category.columns === 2 && 'pricing-features__list--two-col',
						]}
					>
						{category.items.map((item) => (
							<li>
								<span class="pricing-features__bullet" aria-hidden="true"></span>
								<span class="pricing-features__item-text">{item}</span>
							</li>
						))}
					</ul>
				</article>
			))
		}
	</div>

	{
		showFullLink && (
			<a href={featuresHref} class="pricing-features__full-link">
				See all features
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
				</svg>
			</a>
		)
	}

	{
		showRelatedPages && <RelatedPages locale={locale} />
	}
</section>

<style>
	.pricing-features {
		display: grid;
		gap: 0.95rem;
		width: 100%;
		min-width: 0;
		margin: 0;
		padding: var(--panel-padding);
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border-panel);
		background: var(--panel-bg);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.pricing-features__head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem 1.5rem;
	}

	.pricing-features__intro {
		display: grid;
		gap: 0.5rem;
		min-width: 0;
		flex: 1 1 16rem;
	}

	.pricing-features__title {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--heading-section);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-ink);
	}

	.pricing-features__accent {
		display: inline-block;
		width: 0.22rem;
		height: 1.35rem;
		border-radius: 999px;
		background: linear-gradient(180deg, #B47A3C, #343B31);
		flex-shrink: 0;
	}

	.pricing-features__subtitle {
		margin: 0;
		max-width: 42rem;
		color: var(--color-muted);
		font-size: 0.92rem;
		line-height: 1.6;
	}

	.pricing-features__badges {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		flex: 0 0 auto;
	}

	.pricing-features__badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.8rem;
		border-radius: 999px;
		border: 1px solid rgba(197, 138, 69, 0.35);
		background: rgba(197, 138, 69, 0.08);
		color: var(--color-gold-hover);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.pricing-features__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.7rem;
		align-items: stretch;
		grid-auto-rows: 1fr;
	}

	@media (max-width: 1100px) {
		.pricing-features__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.pricing-features__card {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 100%;
		padding: 0.95rem 1rem 1.05rem;
		border-radius: 0.85rem;
		border: 1px solid rgba(197, 138, 69, 0.22);
		background: rgba(13, 17, 18, 0.92);
		box-shadow: 0 10px 26px rgba(0, 0, 0, 0.24);
		transition:
			transform 0.22s ease,
			border-color 0.22s ease,
			box-shadow 0.22s ease,
			background 0.22s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.pricing-features__card:hover {
			transform: translateY(-4px);
			border-color: rgba(197, 138, 69, 0.42);
			background: rgba(16, 20, 21, 0.96);
			box-shadow: 0 14px 32px rgba(0, 0, 0, 0.32);
		}
	}

	.pricing-features__card-title {
		margin: 0 0 0.85rem;
		padding-bottom: 0.7rem;
		border-bottom: 1px solid rgba(197, 138, 69, 0.2);
		font-family: var(--font-display);
		font-size: 1.02rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-ink);
	}

	.pricing-features__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.5rem;
		flex: 1;
		align-content: start;
	}

	.pricing-features__list--two-col {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem 1rem;
	}

	.pricing-features__list li {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		color: rgba(255, 255, 255, 0.92);
		font-size: 0.9rem;
		font-weight: 500;
		line-height: 1.5;
	}

	.pricing-features__bullet {
		flex-shrink: 0;
		width: 0.42rem;
		height: 0.42rem;
		margin-top: 0.48rem;
		border-radius: 50%;
		background: #B47A3C;
		box-shadow: 0 0 0 2px rgba(197, 138, 69, 0.18);
	}

	.pricing-features__item-text {
		flex: 1;
		min-width: 0;
	}

	.pricing-features__full-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		width: 100%;
		padding: 0.95rem 1.15rem;
		border-radius: 0.75rem;
		border: 1px solid rgba(197, 138, 69, 0.35);
		background: rgba(0, 0, 0, 0.32);
		color: var(--color-ink);
		font-size: 0.92rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			transform 0.2s ease;
	}

	.pricing-features__full-link:hover {
		border-color: rgba(197, 138, 69, 0.55);
		background: rgba(0, 0, 0, 0.42);
		color: var(--color-ink);
		transform: translateY(-1px);
	}

	@media (prefers-reduced-motion: reduce) {
		.pricing-features__card,
		.pricing-features__full-link {
			transition: border-color 0.2s ease, background 0.2s ease;
		}

		.pricing-features__card:hover,
		.pricing-features__full-link:hover {
			transform: none;
		}
	}

	@media (max-width: 900px) {
		.pricing-features__grid {
			grid-template-columns: 1fr;
		}

		.pricing-features__list--two-col {
			grid-template-columns: 1fr;
		}
	}
</style>
