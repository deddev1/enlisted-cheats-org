---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import { heroPreloadSrc, heroSizes, heroSrcSet, heroIsExternal } from '../lib/responsive-images';

interface Props {
	accent?: string;
	subtitle?: string;
	subtitleShort?: string;
	locale?: LocaleCode;
	imageAlt?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const {
	accent = ui.hero.accent,
	subtitle = ui.hero.subtitle,
	subtitleShort = ui.hero.subtitleShort,
	imageAlt = ui.images.hero,
} = Astro.props;

const buyUrl = siteConfig.checkoutUrl;
const featuresHref = getLocalizedPath('features', locale);
const setupHref = getLocalizedPath('setup', locale);
const pricingHref = getLocalizedPath('pricing', locale);
const reviewsHref = '/reviews/';

const buyLabels: Partial<Record<LocaleCode, string>> = {
	en: 'Buy',
	es: 'Comprar',
	fr: 'Acheter',
	de: 'Kaufen',
	pt: 'Comprar',
	it: 'Acquista',
};
const buyLabel = buyLabels[locale] ?? ui.hero.buyNow;

const sideActionLabels: Partial<Record<LocaleCode, { features: string; pricing: string }>> = {
	en: { features: 'Game Features', pricing: 'View pricing' },
	es: { features: 'Funciones', pricing: 'Ver precios' },
	fr: { features: 'Fonctionnalités', pricing: 'Voir les tarifs' },
	de: { features: 'Spiel-Features', pricing: 'Preise ansehen' },
};
const sideActions = sideActionLabels[locale] ?? {
	features: ui.hero.seeFeatures,
	pricing: ui.nav.pricing,
};

const reviewsLinkLabels: Partial<Record<LocaleCode, string>> = {
	en: 'Reviews',
};
const reviewsLinkLabel = reviewsLinkLabels[locale] ?? (ui.nav.reviews ?? 'Reviews');

const setupLinkLabels: Partial<Record<LocaleCode, string>> = {
	en: 'System requirements',
};
const setupLinkLabel = setupLinkLabels[locale] ?? ui.nav.setup;

const featureHighlights = ['ESP', 'Aimbot', 'Radar', 'Wallhack'] as const;
---

<section class="hero" aria-label={ui.images.hero}>
	<div class="hero__media">
		<picture class="hero__poster">
			{
				heroIsExternal ? (
					<img
						src={heroPreloadSrc}
						alt={imageAlt}
						width="1600"
						height="900"
						class="hero__poster-img"
						fetchpriority="high"
						decoding="async"
					/>
				) : (
					<>
						<source media="(max-width: 760px)" srcset={heroPreloadSrc} type="image/webp" />
						<source
							media="(min-width: 761px)"
							srcset={heroSrcSet}
							sizes={heroSizes}
							type="image/webp"
						/>
						<img
							src={heroPreloadSrc}
							alt={imageAlt}
							width="1600"
							height="900"
							class="hero__poster-img"
							fetchpriority="high"
							decoding="async"
						/>
					</>
				)
			}
		</picture>
		<video
			class="hero__video"
			data-enlisted-cheats-video="hero"
			src="/videos/enlisted-cheats-preview.mp4"
			poster={heroPreloadSrc}
			muted
			autoplay
			loop
			playsinline
			preload="metadata"
			tabindex="-1"
			aria-hidden="true"
		/>
		<div class="hero__veil" aria-hidden="true"></div>
	</div>

	<div class="hero__inner">
		<div class="hero__stack">
			<div class="hero__emblem" aria-hidden="true">
				<span class="hero__emblem-star">★</span>
			</div>

			<h1 class="hero__title">
				<span class="hero__title-main">{productInfo.game.toUpperCase()}</span>
				<span class="hero__title-sub">CHEATS</span>
			</h1>

			<p class="hero__kicker">{accent}</p>

			<p class="hero__subtitle hero__subtitle--full">{subtitle}</p>
			<p class="hero__subtitle hero__subtitle--short">{subtitleShort}</p>

			<ul class="hero__features" aria-label="Included modules">
				{
					featureHighlights.map((item) => (
						<li class="hero__feature">{item}</li>
					))
				}
			</ul>

			<div class="hero__actions" role="group" aria-label="Primary actions">
				<a href={featuresHref} class="hero__btn hero__btn--side">
					{sideActions.features}
				</a>
				<a
					href={buyUrl}
					class="hero__btn hero__btn--buy"
					rel="noopener noreferrer"
					aria-label={buyLabel}
				>
					<span class="hero__btn-icon" aria-hidden="true">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none">
							<path
								d="M6 6h15l-1.5 9h-12L6 6Zm0 0L5 3H2M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm8 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</span>
					{buyLabel}
				</a>
				<a href={pricingHref} class="hero__btn hero__btn--side">
					{sideActions.pricing}
				</a>
			</div>

			<div class="hero__links">
				<a href={reviewsHref} class="hero__link">
					<span class="hero__link-icon" aria-hidden="true">★</span>
					{reviewsLinkLabel}
				</a>
				<a href={setupHref} class="hero__link">
					<span class="hero__link-icon" aria-hidden="true">⚙</span>
					{setupLinkLabel}
				</a>
			</div>
		</div>
	</div>
</section>

<script src="/scripts/enlisted-cheats-bg-video.js" defer></script>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		min-height: clamp(560px, 88svh, 820px);
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
		background: var(--color-midnight);
	}

	.hero__poster,
	.hero__poster-img,
	.hero__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero__poster {
		z-index: 1;
		margin: 0;
		display: block;
	}

	.hero__poster-img {
		object-fit: cover;
		object-position: center 38%;
		background: var(--color-midnight);
		transform: scale(1.01);
		filter: brightness(0.88) contrast(1.04) saturate(1.06);
	}

	.hero__video {
		z-index: 2;
		object-fit: cover;
		object-position: center 38%;
		opacity: 0;
		transition: opacity 0.5s ease;
		pointer-events: none;
	}

	.hero__video.is-ready {
		opacity: 1;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		z-index: 3;
		background:
			radial-gradient(ellipse 80% 70% at 50% 42%, rgba(8, 10, 12, 0.08) 0%, rgba(8, 10, 12, 0.52) 68%, rgba(8, 10, 12, 0.82) 100%),
			linear-gradient(180deg, rgba(8, 10, 12, 0.42) 0%, rgba(8, 10, 12, 0.12) 34%, rgba(8, 10, 12, 0.72) 100%);
		pointer-events: none;
	}

	.hero__inner {
		position: relative;
		z-index: 4;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		max-width: none;
		margin: 0 auto;
		padding:
			calc(4.75rem + env(safe-area-inset-top, 0px))
			var(--page-gutter)
			calc(2.5rem + env(safe-area-inset-bottom, 0px));
		min-height: inherit;
		text-align: center;
	}

	.hero__stack {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: min(100%, 42rem);
		margin-inline: auto;
		animation: hero-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero__emblem {
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		margin-bottom: 1rem;
		border-radius: 50%;
		border: 2px solid rgba(255, 255, 255, 0.18);
		background:
			radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.03)),
			linear-gradient(180deg, rgba(30, 30, 30, 0.85), rgba(10, 10, 10, 0.95));
		box-shadow:
			0 0 0 1px rgba(0, 0, 0, 0.35) inset,
			0 12px 32px rgba(0, 0, 0, 0.45);
	}

	.hero__emblem-star {
		font-size: 1.65rem;
		line-height: 1;
		color: #d8dde2;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.65);
	}

	.hero__kicker {
		order: 2;
		margin: 0.85rem 0 0;
		max-width: 34rem;
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1.45;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.72);
	}

	.hero__title {
		order: 1;
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		width: 100%;
	}

	.hero__title-main {
		font-family: var(--font-display);
		font-size: clamp(2rem, 6vw, 3.75rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-ink);
		text-shadow:
			0 2px 18px rgba(0, 0, 0, 0.85),
			0 0 40px rgba(0, 0, 0, 0.35);
	}

	.hero__title-sub {
		display: block;
		width: fit-content;
		font-size: clamp(0.95rem, 2vw, 1.35rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: 0.32em;
		text-indent: 0.32em;
		text-transform: uppercase;
		color: var(--color-cta);
	}

	.hero__subtitle {
		order: 3;
		margin: 0.95rem 0 0;
		max-width: 38rem;
		font-size: clamp(0.92rem, 1.5vw, 1.05rem);
		line-height: 1.65;
		color: var(--color-body);
		text-shadow: 0 1px 12px rgba(0, 0, 0, 0.75);
	}

	.hero__features {
		order: 4;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.45rem;
		margin: 1.1rem 0 0;
		padding: 0;
		list-style: none;
		width: 100%;
	}

	.hero__feature {
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: rgba(88, 96, 75, 0.22);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-ink);
		backdrop-filter: blur(6px);
	}

	.hero__actions {
		order: 5;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: stretch;
		gap: 0.65rem;
		width: min(100%, 36rem);
		margin-top: 1.5rem;
	}

	.hero__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-height: 2.85rem;
		padding: 0.75rem 0.85rem;
		border-radius: 0.35rem;
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		text-decoration: none;
		text-align: center;
		transition:
			transform 0.2s ease,
			filter 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.hero__btn--side {
		border: 1px solid rgba(255, 255, 255, 0.14);
		background: rgba(18, 18, 18, 0.55);
		color: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(8px);
	}

	.hero__btn--side:hover {
		background: rgba(28, 28, 28, 0.72);
		border-color: rgba(255, 255, 255, 0.24);
		color: #ffffff;
		transform: translateY(-1px);
	}

	.hero__btn--buy {
		min-height: 3.1rem;
		padding-inline: 1rem;
		border: 1px solid rgba(197, 138, 69, 0.55);
		background: linear-gradient(180deg, var(--color-cta) 0%, var(--color-accent) 100%);
		color: var(--color-ink);
		font-size: 0.88rem;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.22) inset,
			0 10px 28px rgba(13, 17, 18, 0.35),
			0 4px 14px rgba(0, 0, 0, 0.35);
	}

	.hero__btn--buy:hover {
		filter: brightness(1.05);
		transform: translateY(-2px);
		background: linear-gradient(180deg, var(--color-cta-hover) 0%, var(--color-cta) 100%);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.28) inset,
			0 14px 34px rgba(13, 17, 18, 0.42),
			0 6px 18px rgba(0, 0, 0, 0.38);
		color: var(--color-ink);
	}

	.hero__btn-icon {
		display: inline-flex;
	}

	.hero__links {
		order: 6;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 1.5rem;
		width: min(100%, 36rem);
		margin-top: 1rem;
	}

	.hero__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-width: 9rem;
		font-size: 0.82rem;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.72);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.hero__link:hover {
		color: #ffffff;
	}

	.hero__link-icon {
		opacity: 0.75;
		font-size: 0.75rem;
		line-height: 1;
	}

	.hero__subtitle--short {
		display: none;
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(22px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 760px) {
		.hero {
			min-height: min(92svh, 760px);
		}

		.hero__inner {
			align-items: center;
			padding-top: calc(4.25rem + env(safe-area-inset-top, 0px));
			padding-bottom: calc(1.75rem + env(safe-area-inset-bottom, 0px));
		}

		.hero__stack {
			width: min(100%, 24rem);
			animation: none;
		}

		.hero__emblem {
			width: 3.75rem;
			height: 3.75rem;
			margin-bottom: 0.65rem;
		}

		.hero__title-main {
			font-size: clamp(1.65rem, 9vw, 2.35rem);
			letter-spacing: 0.06em;
		}

		.hero__subtitle--full {
			display: none;
		}

		.hero__subtitle--short {
			display: block;
			margin-top: 0.75rem;
			font-size: 0.9rem;
		}

		.hero__features {
			margin-top: 0.75rem;
		}

		.hero__actions {
			grid-template-columns: 1fr;
			width: 100%;
			gap: 0.55rem;
		}

		.hero__btn--buy {
			order: -1;
			width: 100%;
			min-height: var(--touch-min);
			font-size: 0.95rem;
		}

		.hero__btn--side {
			width: 100%;
			min-height: var(--touch-min);
		}

		.hero__links {
			width: 100%;
			gap: 0.85rem 1.25rem;
		}

		.hero__link {
			min-width: 0;
		}

		.hero__poster-img,
		.hero__video {
			object-position: center 30%;
		}

		.hero__veil {
			background:
				radial-gradient(ellipse 100% 80% at 50% 70%, rgba(8, 10, 12, 0.1) 0%, rgba(8, 10, 12, 0.78) 72%),
				linear-gradient(180deg, rgba(8, 10, 12, 0.45) 0%, rgba(8, 10, 12, 0.2) 38%, rgba(8, 10, 12, 0.88) 100%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__stack {
			animation: none;
		}

		.hero__video {
			display: none;
		}
	}
</style>
