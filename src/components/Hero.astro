---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import { heroPreloadSrc, heroSizes, heroSrcSet, heroIsExternal } from '../lib/responsive-images';

interface Props {
	accent?: string;
	subtitle?: string;
	subtitleShort?: string;
	locale?: LocaleCode;
	imageAlt?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const {
	accent = ui.hero.accent,
	subtitle = ui.hero.subtitle,
	subtitleShort = ui.hero.subtitleShort,
	imageAlt = ui.images.hero,
} = Astro.props;

const buyUrl = siteConfig.checkoutUrl;
const featuresHref = getLocalizedPath('features', locale);
const setupHref = getLocalizedPath('setup', locale);
const pricingHref = getLocalizedPath('pricing', locale);
const previewHref = '#gallery';

const buyLabels: Partial<Record<LocaleCode, string>> = {
	en: 'Buy Now',
	es: 'Comprar ahora',
	fr: 'Acheter',
	de: 'Jetzt kaufen',
	pt: 'Comprar agora',
	it: 'Acquista ora',
};
const buyLabel = buyLabels[locale] ?? ui.hero.buyNow;

const previewLabels: Partial<Record<LocaleCode, string>> = {
	en: 'Watch Preview',
	es: 'Ver vista previa',
	fr: 'Voir l’aperçu',
	de: 'Vorschau ansehen',
};
const previewLabel = previewLabels[locale] ?? ui.hero.seeFeatures;

const featureHighlights = ['ESP', 'Aimbot', 'Radar', 'Wallhack'] as const;
---

<section class="hero" aria-label={ui.images.hero}>
	<div class="hero__media">
		<picture class="hero__poster">
			{
				heroIsExternal ? (
					<img
						src={heroPreloadSrc}
						alt={imageAlt}
						width="1600"
						height="900"
						class="hero__poster-img"
						fetchpriority="high"
						decoding="async"
					/>
				) : (
					<>
						<source media="(max-width: 760px)" srcset={heroPreloadSrc} type="image/webp" />
						<source
							media="(min-width: 761px)"
							srcset={heroSrcSet}
							sizes={heroSizes}
							type="image/webp"
						/>
						<img
							src={heroPreloadSrc}
							alt={imageAlt}
							width="1600"
							height="900"
							class="hero__poster-img"
							fetchpriority="high"
							decoding="async"
						/>
					</>
				)
			}
		</picture>
		<video
			class="hero__video"
			data-enlisted-cheats-video="hero"
			src="/videos/enlisted-cheats-preview.mp4"
			poster={heroPreloadSrc}
			muted
			autoplay
			loop
			playsinline
			preload="metadata"
			tabindex="-1"
			aria-hidden="true"
		/>
		<div class="hero__veil" aria-hidden="true"></div>
	</div>

	<div class="hero__inner">
		<div class="hero__stack">
			<div class="hero__emblem" aria-hidden="true">
				<span class="hero__emblem-star">★</span>
			</div>

			<p class="hero__kicker">{accent}</p>

			<h1 class="hero__title">
				<span class="hero__title-main">{siteConfig.name}</span>
				<span class="hero__title-sub">{productInfo.game}</span>
			</h1>

			<p class="hero__subtitle hero__subtitle--full">{subtitle}</p>
			<p class="hero__subtitle hero__subtitle--short">{subtitleShort}</p>

			<ul class="hero__features" aria-label="Included modules">
				{
					featureHighlights.map((item) => (
						<li class="hero__feature">{item}</li>
					))
				}
			</ul>

			<div class="hero__actions" role="group" aria-label="Primary actions">
				<a href={featuresHref} class="hero__btn hero__btn--side">
					{ui.hero.seeFeatures}
				</a>
				<a
					href={buyUrl}
					class="hero__btn hero__btn--buy"
					rel="noopener noreferrer"
					aria-label={buyLabel}
				>
					<span class="hero__btn-icon" aria-hidden="true">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none">
							<path
								d="M12 3v10m0 0 4-4m-4 4-4-4M5 21h14"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</span>
					{buyLabel}
				</a>
				<a href={previewHref} class="hero__btn hero__btn--side">
					{previewLabel}
				</a>
			</div>

			<div class="hero__links">
				<a href={setupHref} class="hero__link">
					<span class="hero__link-icon" aria-hidden="true">⚙</span>
					{ui.nav.setup}
				</a>
				<a href={pricingHref} class="hero__link">
					<span class="hero__link-icon" aria-hidden="true">◆</span>
					{ui.nav.pricing}
				</a>
			</div>

			<ul class="hero__platforms" aria-label="Supported platforms">
				{
					productInfo.platforms.map((platform) => (
						<li class="hero__platform">
							<span class="hero__platform-icon" aria-hidden="true">
								{platform.includes('Windows') ? (
									<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
										<path d="M3 5.5 10.5 4.5V11H3V5.5Zm0 13L10.5 19.5V13H3v5.5ZM11.5 4 21 2.5V11h-9.5V4Zm0 17.5L21 21.5V13h-9.5v8.5Z" />
									</svg>
								) : (
									<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
										<path
											d="M8 5h8a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3Zm1 3v2h6V8H9Zm0 4v2h4v-2H9Z"
										/>
									</svg>
								)}
							</span>
							{platform}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<script src="/scripts/enlisted-cheats-bg-video.js" defer></script>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		min-height: clamp(560px, 88svh, 820px);
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
		background: #0a0908;
	}

	.hero__poster,
	.hero__poster-img,
	.hero__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero__poster {
		z-index: 1;
		margin: 0;
		display: block;
	}

	.hero__poster-img {
		object-fit: cover;
		object-position: center 38%;
		background: #0a0908;
		transform: scale(1.01);
		filter: brightness(0.88) contrast(1.04) saturate(1.06);
	}

	.hero__video {
		z-index: 2;
		object-fit: cover;
		object-position: center 38%;
		opacity: 0;
		transition: opacity 0.5s ease;
		pointer-events: none;
	}

	.hero__video.is-ready {
		opacity: 1;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		z-index: 3;
		background:
			radial-gradient(ellipse 80% 70% at 50% 42%, rgba(8, 10, 12, 0.15) 0%, rgba(8, 10, 12, 0.72) 68%, rgba(8, 10, 12, 0.92) 100%),
			linear-gradient(180deg, rgba(8, 10, 12, 0.55) 0%, rgba(8, 10, 12, 0.18) 34%, rgba(8, 10, 12, 0.82) 100%);
		pointer-events: none;
	}

	.hero__inner {
		position: relative;
		z-index: 4;
		display: flex;
		align-items: center;
		justify-content: center;
		width: min(100% - (var(--page-gutter) * 2), 920px);
		margin: 0 auto;
		padding:
			calc(5.5rem + env(safe-area-inset-top, 0px))
			0
			calc(2.5rem + env(safe-area-inset-bottom, 0px));
		min-height: inherit;
		text-align: center;
	}

	.hero__stack {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0;
		width: 100%;
		animation: hero-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero__emblem {
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		margin-bottom: 0.85rem;
		border-radius: 50%;
		border: 2px solid rgba(255, 255, 255, 0.18);
		background:
			radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.03)),
			linear-gradient(180deg, rgba(30, 30, 30, 0.85), rgba(10, 10, 10, 0.95));
		box-shadow:
			0 0 0 1px rgba(0, 0, 0, 0.35) inset,
			0 12px 32px rgba(0, 0, 0, 0.45);
	}

	.hero__emblem-star {
		font-size: 1.65rem;
		line-height: 1;
		color: #d8dde2;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.65);
	}

	.hero__kicker {
		margin: 0 0 0.55rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.72);
	}

	.hero__title {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
	}

	.hero__title-main {
		font-family: var(--font-display);
		font-size: clamp(2rem, 6vw, 3.75rem);
		font-weight: 800;
		line-height: 0.95;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #f3f5f7;
		text-shadow:
			0 2px 18px rgba(0, 0, 0, 0.85),
			0 0 40px rgba(0, 0, 0, 0.35);
	}

	.hero__title-sub {
		font-size: clamp(0.78rem, 1.6vw, 0.95rem);
		font-weight: 700;
		letter-spacing: 0.34em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.58);
	}

	.hero__subtitle {
		margin: 1rem auto 0;
		max-width: 42rem;
		font-size: clamp(0.92rem, 1.5vw, 1.05rem);
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.78);
		text-shadow: 0 1px 12px rgba(0, 0, 0, 0.75);
	}

	.hero__features {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.45rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	.hero__feature {
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.06);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.82);
		backdrop-filter: blur(6px);
	}

	.hero__actions {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 0.65rem;
		width: min(100%, 680px);
		margin-top: 1.65rem;
	}

	.hero__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-height: 2.85rem;
		padding: 0.75rem 1.1rem;
		border-radius: 0.35rem;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			filter 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.hero__btn--side {
		border: 1px solid rgba(255, 255, 255, 0.14);
		background: rgba(18, 18, 18, 0.55);
		color: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(8px);
	}

	.hero__btn--side:hover {
		background: rgba(28, 28, 28, 0.72);
		border-color: rgba(255, 255, 255, 0.24);
		color: #ffffff;
		transform: translateY(-1px);
	}

	.hero__btn--buy {
		min-height: 3.35rem;
		padding: 0.9rem 1.65rem;
		border: 1px solid rgba(255, 190, 120, 0.45);
		background: linear-gradient(180deg, #ffb347 0%, #f07a18 52%, #d85f00 100%);
		color: #ffffff;
		font-size: 0.92rem;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.35) inset,
			0 10px 28px rgba(216, 95, 0, 0.35),
			0 4px 14px rgba(0, 0, 0, 0.35);
		white-space: nowrap;
	}

	.hero__btn--buy:hover {
		filter: brightness(1.05);
		transform: translateY(-2px);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.42) inset,
			0 14px 34px rgba(216, 95, 0, 0.42),
			0 6px 18px rgba(0, 0, 0, 0.38);
		color: #ffffff;
	}

	.hero__btn-icon {
		display: inline-flex;
	}

	.hero__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.25rem;
		margin-top: 1rem;
	}

	.hero__link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.82rem;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.72);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.hero__link:hover {
		color: #ffffff;
	}

	.hero__link-icon {
		opacity: 0.75;
		font-size: 0.75rem;
	}

	.hero__platforms {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.25rem;
		margin: 1.35rem 0 0;
		padding: 0;
		list-style: none;
	}

	.hero__platform {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.55);
	}

	.hero__platform-icon {
		display: inline-flex;
		opacity: 0.85;
	}

	.hero__subtitle--short {
		display: none;
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(22px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 760px) {
		.hero {
			min-height: min(92svh, 760px);
		}

		.hero__inner {
			align-items: flex-end;
			padding-top: calc(4.75rem + env(safe-area-inset-top, 0px));
			padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
		}

		.hero__stack {
			animation: none;
		}

		.hero__emblem {
			width: 3.75rem;
			height: 3.75rem;
			margin-bottom: 0.65rem;
		}

		.hero__title-main {
			font-size: clamp(1.65rem, 9vw, 2.35rem);
			letter-spacing: 0.06em;
		}

		.hero__subtitle--full {
			display: none;
		}

		.hero__subtitle--short {
			display: block;
			margin-top: 0.75rem;
			font-size: 0.9rem;
		}

		.hero__features {
			margin-top: 0.75rem;
		}

		.hero__actions {
			grid-template-columns: 1fr;
			width: 100%;
			gap: 0.55rem;
		}

		.hero__btn--buy {
			order: -1;
			width: 100%;
			min-height: var(--touch-min);
			font-size: 0.95rem;
		}

		.hero__btn--side {
			width: 100%;
			min-height: var(--touch-min);
		}

		.hero__poster-img,
		.hero__video {
			object-position: center 30%;
		}

		.hero__veil {
			background:
				radial-gradient(ellipse 100% 80% at 50% 70%, rgba(8, 10, 12, 0.1) 0%, rgba(8, 10, 12, 0.78) 72%),
				linear-gradient(180deg, rgba(8, 10, 12, 0.45) 0%, rgba(8, 10, 12, 0.2) 38%, rgba(8, 10, 12, 0.88) 100%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__stack {
			animation: none;
		}

		.hero__video {
			display: none;
		}
	}
</style>
