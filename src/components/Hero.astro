---
import { enlistedHeroAlt } from '../data/enlisted';
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { siteConfig } from '../data/site';
import { heroPreloadSrc, heroSizes, heroSrcSet, heroIsExternal } from '../lib/responsive-images';

interface Props {
	accent?: string;
	locale?: LocaleCode;
	/** Localized descriptive alt for the hero poster (SEO + screen readers). */
	imageAlt?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const {
	accent = ui.hero.accent,
	imageAlt = ui.images.hero || enlistedHeroAlt,
} = Astro.props;

const buyUrl = siteConfig.checkoutUrl;
const featuresUrl = getLocalizedPath('features', locale);
const pricingUrl = getLocalizedPath('pricing', locale);
const setupUrl = getLocalizedPath('setup', locale);
const espUrl = getLocalizedPath('enlisted-esp', locale);
const aimbotUrl = getLocalizedPath('enlisted-aimbot', locale);
const wallhackUrl = getLocalizedPath('wallhack', locale);
const radarUrl = getLocalizedPath('radar', locale);
const reviewsUrl = '/reviews/';

const gameFeatures = ui.hero.gameFeatures ?? ui.hero.seeFeatures;
const buyLabel = ui.hero.buy ?? ui.hero.buyNow;
const viewPricing = ui.hero.viewPricing ?? ui.nav.pricing;
const seeReviews = ui.nav.reviews ?? 'See Reviews';
const systemRequirements = ui.hero.systemRequirements ?? ui.nav.setup;

const featurePills = [
	{ label: ui.nav.esp, href: espUrl },
	{ label: ui.nav.aimbot, href: aimbotUrl },
	{ label: 'Wallhack', href: wallhackUrl },
	{ label: 'Radar', href: radarUrl },
];
---

<section class="hero" aria-label={ui.images.hero}>
	<div class="hero__media">
		<picture class="hero__poster">
			{
				heroIsExternal ? (
					<img
						src={heroPreloadSrc}
						alt={imageAlt}
						width="1920"
						height="1080"
						class="hero__poster-img"
						fetchpriority="high"
						decoding="async"
					/>
				) : (
					<>
						<source media="(max-width: 760px)" srcset={heroPreloadSrc} type="image/webp" />
						<source
							media="(min-width: 761px)"
							srcset={heroSrcSet}
							sizes={heroSizes}
							type="image/webp"
						/>
						<img
							src={heroPreloadSrc}
							alt={imageAlt}
							width="1920"
							height="1080"
							class="hero__poster-img"
							fetchpriority="high"
							decoding="async"
						/>
					</>
				)
			}
		</picture>
		<div class="hero__veil" aria-hidden="true"></div>
	</div>

	<div class="hero__inner">
		<div class="hero__content">
			<h1 class="hero__logo">
				<span class="hero__logo-main">Enlisted</span>
				<span class="hero__logo-sub">Cheats</span>
			</h1>

			<p class="hero__tagline">{accent}</p>

			<ul class="hero__features" aria-label="Included modules">
				{
					featurePills.map((pill) => (
						<li>
							<a href={pill.href} class="hero__feature-pill">
								{pill.label}
							</a>
						</li>
					))
				}
			</ul>

			<div class="hero__actions">
				<a href={featuresUrl} class="hero__btn hero__btn--ghost">
					{gameFeatures}
				</a>
				<a href={buyUrl} class="hero__btn hero__btn--buy" rel="noopener noreferrer">
					<svg class="hero__btn-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path
							d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM6.2 6h14.6l-1.4 7H8.1L6.2 6zm-.8-2 2.2 11h11.2l2-11H5.4z"
							fill="currentColor"></path>
					</svg>
					{buyLabel}
				</a>
				<a href={pricingUrl} class="hero__btn hero__btn--ghost">
					{viewPricing}
				</a>
			</div>

			<div class="hero__meta">
				<a href={reviewsUrl} class="hero__meta-link">
					<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path
							d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27z"
							fill="currentColor"></path>
					</svg>
					{seeReviews}
				</a>
				<a href={setupUrl} class="hero__meta-link">
					<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path
							d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h10v2H4v-2z"
							fill="currentColor"></path>
					</svg>
					{systemRequirements}
				</a>
			</div>
		</div>
	</div>

	<div class="hero__platforms" aria-label="Supported platform">
		<span class="hero__platform">
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path
					d="M3 5.5L11 4v16l-8-1.45V5.5zm10 14.5V4l8-1.5v16L13 20z"
					fill="currentColor"></path>
			</svg>
			Windows PC
		</span>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		min-height: min(92vh, 920px);
		display: flex;
		flex-direction: column;
		justify-content: center;
		color: #fff;
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
		background: #0D1112;
	}

	.hero__poster,
	.hero__poster-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero__poster {
		margin: 0;
		display: block;
	}

	.hero__poster-img {
		object-fit: cover;
		object-position: center 35%;
		transform: scale(1.04);
		filter: saturate(1.08) contrast(1.05) brightness(0.92);
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			linear-gradient(180deg, rgba(8, 6, 4, 0.72) 0%, rgba(8, 6, 4, 0.18) 34%, rgba(8, 6, 4, 0.28) 62%, rgba(8, 6, 4, 0.88) 100%),
			radial-gradient(circle at 50% 42%, transparent 0%, rgba(8, 6, 4, 0.35) 72%);
		pointer-events: none;
	}

	.hero__inner {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: calc(36rem + (var(--page-gutter) * 2));
		margin: 0 auto;
		padding: calc(5rem + env(safe-area-inset-top, 0px)) var(--page-gutter) 5.5rem;
	}

	.hero__content {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		max-width: 36rem;
		margin-inline: auto;
		text-align: center;
		animation: hero-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero__logo {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
		font-family: var(--font-display);
		line-height: 0.95;
		text-transform: uppercase;
		filter: drop-shadow(0 8px 28px rgba(0, 0, 0, 0.65));
	}

	.hero__logo-main {
		font-size: clamp(2.8rem, 8vw, 5.4rem);
		font-weight: 800;
		letter-spacing: 0.08em;
		padding-inline-start: 0.08em;
		background: linear-gradient(180deg, #f1eee5 0%, #c58a45 48%, #58604b 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero__logo-sub {
		font-size: clamp(1rem, 2.4vw, 1.45rem);
		font-weight: 700;
		letter-spacing: 0.35em;
		padding-inline-start: 0.35em;
		color: var(--color-gold);
	}

	.hero__tagline {
		margin: 1rem 0 0;
		width: 100%;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(255, 236, 196, 0.88);
	}

	.hero__features {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.3rem;
		width: auto;
		max-width: 100%;
		margin: 1.1rem 0 0;
		padding: 0;
		list-style: none;
	}

	.hero__features li {
		display: flex;
	}

	.hero__feature-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: auto;
		padding: 0.28rem 0.55rem;
		border-radius: 999px;
		border: 1px solid rgba(197, 138, 69, 0.28);
		background: rgba(0, 0, 0, 0.35);
		color: rgba(255, 244, 220, 0.92);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			color 0.2s ease;
	}

	.hero__feature-pill:hover {
		border-color: rgba(197, 138, 69, 0.55);
		background: rgba(197, 138, 69, 0.12);
		color: #fff;
	}

	.hero__actions {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.65rem;
		width: 100%;
		max-width: 36rem;
		margin-top: 1.65rem;
	}

	.hero__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		width: 100%;
		min-height: 3rem;
		padding: 0.85rem 0.75rem;
		border-radius: 0.35rem;
		border: 1px solid transparent;
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		cursor: pointer;
		transition:
			transform 0.2s ease,
			filter 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.hero__btn--ghost {
		background: rgba(0, 0, 0, 0.48);
		border-color: rgba(255, 255, 255, 0.18);
		color: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(8px);
	}

	.hero__btn--ghost:hover {
		background: rgba(0, 0, 0, 0.62);
		border-color: rgba(255, 255, 255, 0.32);
		transform: translateY(-1px);
	}

	.hero__btn--buy {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		padding-inline: 0.85rem;
		background: linear-gradient(135deg, #e8b066 0%, #c58a45 46%, #a86f2f 100%);
		border-color: rgba(255, 228, 170, 0.55);
		color: #140c04;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.35) inset,
			0 0 0 1px rgba(197, 138, 69, 0.2),
			0 0 26px rgba(197, 138, 69, 0.34),
			0 14px 30px rgba(0, 0, 0, 0.36);
	}

	.hero__btn--buy::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, transparent 50%);
		pointer-events: none;
	}

	.hero__btn--buy::after {
		content: '';
		position: absolute;
		top: -10%;
		left: 0;
		width: 42%;
		height: 120%;
		background: linear-gradient(
			105deg,
			transparent 0%,
			rgba(255, 255, 255, 0.12) 42%,
			rgba(255, 255, 255, 0.28) 50%,
			rgba(255, 255, 255, 0.12) 58%,
			transparent 100%
		);
		transform: translateX(-170%) skewX(-18deg);
		pointer-events: none;
	}

	.hero__btn--buy:hover {
		filter: brightness(1.05);
		transform: translateY(-2px);
		color: #140c04;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.4) inset,
			0 0 0 1px rgba(255, 228, 170, 0.4),
			0 0 32px rgba(197, 138, 69, 0.45),
			0 16px 34px rgba(0, 0, 0, 0.38);
	}

	@media (hover: hover) and (pointer: fine) {
		.hero__btn--buy:hover::after {
			animation: hero-buy-shine 2.2s ease-in-out infinite;
		}
	}

	@keyframes hero-buy-shine {
		0% {
			transform: translateX(-170%) skewX(-18deg);
		}
		100% {
			transform: translateX(320%) skewX(-18deg);
		}
	}

	.hero__btn--buy .hero__btn-icon {
		position: relative;
		z-index: 2;
		width: 1.1rem;
		height: 1.1rem;
		flex-shrink: 0;
	}

	.hero__meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 1.5rem;
		width: 100%;
		max-width: 36rem;
		margin-top: 1.15rem;
	}

	.hero__meta-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.hero__meta-link svg {
		width: 1rem;
		height: 1rem;
		opacity: 0.85;
	}

	.hero__meta-link:hover {
		color: #fff;
	}

	.hero__platforms {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 3;
		display: flex;
		justify-content: center;
		padding: 1rem var(--page-gutter) calc(1rem + env(safe-area-inset-bottom, 0px));
		background: linear-gradient(180deg, transparent, rgba(8, 6, 4, 0.82));
	}

	.hero__platform {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.hero__platform svg {
		width: 1.15rem;
		height: 1.15rem;
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 760px) {
		.hero {
			min-height: min(88svh, 760px);
		}

		.hero__inner {
			padding-top: calc(5.5rem + env(safe-area-inset-top, 0px));
			padding-bottom: 4.25rem;
		}

		.hero__poster-img {
			object-position: center 28%;
		}

		.hero__actions {
			grid-template-columns: 1fr;
			max-width: 18rem;
		}

		.hero__btn {
			font-size: 0.82rem;
			padding-inline: 1.25rem;
		}

		.hero__btn--buy {
			order: -1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__content {
			animation: none;
		}
	}
</style>
