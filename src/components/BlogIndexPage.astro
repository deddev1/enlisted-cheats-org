---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import BlogCinematicCard from './BlogCinematicCard.astro';
import { blogUi, type LocaleCode } from '../data/i18n/locales';
import {
	absoluteBlogUrl,
	blogCardExcerpt,
	blogCardHeading,
	getBlogBasePath,
	getCheatsBlogPosts,
	getFeaturedPosts,
} from '../data/blog/helpers';
import { siteConfig } from '../data/site';
import { getLocalizedPath } from '../data/i18n/routing';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const ui = blogUi[locale];
const cheatsPosts = getCheatsBlogPosts(locale);
const featured = getFeaturedPosts(locale, 3);
const canonicalPath = getBlogBasePath(locale);
const canonicalURL = absoluteBlogUrl(locale);
const homeHref = getLocalizedPath('home', locale);
const guidesHref = '/guides/';

const articleListSchema = {
	'@type': 'CollectionPage',
	'@id': `${canonicalURL}#collection`,
	name: ui.blogH1,
	description: ui.blogDescription,
	url: canonicalURL,
	inLanguage: 'en',
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: cheatsPosts.map((post, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: absoluteBlogUrl(locale, post.translation.slug),
			name: post.translation.title,
		})),
	},
};
---

<Layout
	title={ui.blogTitle}
	description={ui.blogDescription}
	canonicalPath={canonicalPath}
	locale={locale}
	englishOnlyAlternates={true}
	breadcrumbs={[{ label: ui.home, href: homeHref }, { label: ui.blogH1 }]}
	extraGraph={[articleListSchema]}
>
	<Navbar locale={locale} />
	<main class="blog">
		<header class="blog__hero">
			<p class="blog__eyebrow">Enlisted Cheats intel</p>
			<h1>{ui.blogH1}</h1>
			<p class="blog__intro">{ui.blogIntro}</p>
			<p class="blog__note">
				Product guides and comparisons are published in English. For in-game mission and faction guides, see the
				<a href={guidesHref}>Enlisted guides hub</a>.
			</p>
		</header>

		{
			featured.length > 0 && (
				<section class="blog__featured" aria-label="Featured">
					<h2 class="blog__section-title blog__section-title--center">Featured cheat guides</h2>
					<div class="blog__grid">
						{featured.map((post, index) => (
							<BlogCinematicCard
								href={post.canonicalPath}
								imageSrc={post.imageSrc}
								imageAlt={post.translation.imageAlt}
								title={blogCardHeading(post.translation.title)}
								description={blogCardExcerpt(post.translation.intro)}
								loading={index === 0 ? 'eager' : 'lazy'}
								fetchpriority={index === 0 ? 'high' : undefined}
							/>
						))}
					</div>
				</section>
			)
		}

		<section class="blog__section" aria-labelledby="blog-cheats-posts">
			<h2 id="blog-cheats-posts" class="blog__section-title blog__section-title--center">
				All cheat guides
			</h2>
			<div class="blog__grid" aria-label={ui.allPosts}>
				{
					cheatsPosts.map((post) => (
						<BlogCinematicCard
							href={post.canonicalPath}
							imageSrc={post.imageSrc}
							imageAlt={post.translation.imageAlt}
							title={blogCardHeading(post.translation.title)}
							description={blogCardExcerpt(post.translation.intro)}
						/>
					))
				}
			</div>
		</section>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.blog {
		width: min(var(--page-max), calc(100% - (var(--page-gutter) * 2)));
		margin: 0 auto;
		padding: 2rem 0 3.5rem;
	}

	.blog__hero {
		margin-bottom: 2rem;
		text-align: center;
	}

	.blog__eyebrow {
		margin: 0 0 0.5rem;
		color: var(--color-gold);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: 0.72rem;
	}

	.blog__hero h1 {
		margin: 0 0 0.65rem;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		line-height: 1.08;
	}

	.blog__intro {
		max-width: 40rem;
		margin-inline: auto;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.blog__note {
		max-width: 40rem;
		margin: 0.75rem auto 0;
		color: rgba(255, 255, 255, 0.55);
		font-size: 0.82rem;
		line-height: 1.5;
	}

	.blog__note a {
		color: var(--color-gold-hover);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.blog__featured,
	.blog__section {
		margin-bottom: 2rem;
	}

	.blog__section-title {
		margin: 0 0 0.45rem;
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.blog__section-title--center {
		text-align: center;
	}

	.blog__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.55rem;
		align-items: stretch;
	}

	@media (max-width: 900px) {
		.blog__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
