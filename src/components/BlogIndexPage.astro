---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import BlogCinematicCard from './BlogCinematicCard.astro';
import { blogUi, type LocaleCode } from '../data/i18n/locales';
import {
	absoluteBlogUrl,
	blogCardExcerpt,
	blogCardHeading,
	getAllPostsForLocale,
	getBlogBasePath,
	getFeaturedPosts,
	getPostsByCategory,
} from '../data/blog/helpers';
import { siteConfig } from '../data/site';
import { getLocalizedPath } from '../data/i18n/routing';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const ui = blogUi[locale];
const posts = getAllPostsForLocale(locale);
const featured = getFeaturedPosts(locale, 3);
const gameGuides = getPostsByCategory(locale, 'Enlisted Game Guides');
const productPosts = posts.filter((post) => post.category !== 'Enlisted Game Guides');
const canonicalPath = getBlogBasePath(locale);
const canonicalURL = absoluteBlogUrl(locale);
const homeHref = getLocalizedPath('home', locale);

const articleListSchema = {
	'@type': 'CollectionPage',
	'@id': `${canonicalURL}#collection`,
	name: ui.blogH1,
	description: ui.blogDescription,
	url: canonicalURL,
	inLanguage: locale,
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: posts.map((post, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: absoluteBlogUrl(locale, post.translation.slug),
			name: post.translation.title,
		})),
	},
};
---

<Layout
	title={ui.blogTitle}
	description={ui.blogDescription}
	canonicalPath={canonicalPath}
	locale={locale}
	breadcrumbs={[{ label: ui.home, href: homeHref }, { label: ui.blogH1 }]}
	extraGraph={[articleListSchema]}
>
	<Navbar locale={locale} />
	<main class="blog">
		<header class="blog__hero">
			<p class="blog__eyebrow">Enlisted guides &amp; product intel</p>
			<h1>{ui.blogH1}</h1>
			<p class="blog__intro">{ui.blogIntro}</p>
		</header>

		{
			featured.length > 0 && (
				<section class="blog__featured" aria-label="Featured">
					<h2 class="blog__section-title blog__section-title--center">Featured guides</h2>
					<div class="blog__grid">
						{featured.map((post, index) => (
							<BlogCinematicCard
								href={post.canonicalPath}
								imageSrc={post.imageSrc}
								imageAlt={post.translation.imageAlt}
								title={blogCardHeading(post.translation.title)}
								description={blogCardExcerpt(post.translation.intro)}
								loading={index === 0 ? 'eager' : 'lazy'}
								fetchpriority={index === 0 ? 'high' : undefined}
							/>
						))}
					</div>
				</section>
			)
		}

		{
			gameGuides.length > 0 && (
				<section class="blog__section" aria-labelledby="blog-game-guides">
					<h2 id="blog-game-guides" class="blog__section-title blog__section-title--center">
						Enlisted game guides
					</h2>
					<p class="blog__section-intro blog__section-intro--center">
						Campaign missions, battlefield, factions, missions, and patch notes — with links to official
						Enlisted Wiki and Gaijin resources.
					</p>
					<div class="blog__grid">
						{gameGuides.map((post) => (
							<BlogCinematicCard
								href={post.canonicalPath}
								imageSrc={post.imageSrc}
								imageAlt={post.translation.imageAlt}
								title={blogCardHeading(post.translation.title)}
								description={blogCardExcerpt(post.translation.intro)}
							/>
						))}
					</div>
				</section>
			)
		}

		<section class="blog__section" aria-labelledby="blog-product-posts">
			<h2 id="blog-product-posts" class="blog__section-title blog__section-title--center">
				Product guides &amp; comparisons
			</h2>
			<div class="blog__grid" aria-label={ui.allPosts}>
				{
					productPosts.map((post) => (
						<BlogCinematicCard
							href={post.canonicalPath}
							imageSrc={post.imageSrc}
							imageAlt={post.translation.imageAlt}
							title={blogCardHeading(post.translation.title)}
							description={blogCardExcerpt(post.translation.intro)}
						/>
					))
				}
			</div>
		</section>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.blog {
		width: min(var(--page-max), calc(100% - (var(--page-gutter) * 2)));
		margin: 0 auto;
		padding: 2rem 0 3.5rem;
	}

	.blog__hero {
		margin-bottom: 2rem;
		text-align: center;
	}

	.blog__eyebrow {
		margin: 0 0 0.5rem;
		color: var(--color-gold);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: 0.72rem;
	}

	.blog__hero h1 {
		margin: 0 0 0.65rem;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		line-height: 1.08;
	}

	.blog__intro {
		max-width: 40rem;
		margin-inline: auto;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.blog__featured,
	.blog__section {
		margin-bottom: 2rem;
	}

	.blog__section-title {
		margin: 0 0 0.45rem;
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.blog__section-title--center {
		text-align: center;
	}

	.blog__section-intro {
		margin: 0 0 1rem;
		max-width: 40rem;
		color: rgba(255, 255, 255, 0.68);
		font-size: 0.88rem;
		line-height: 1.55;
	}

	.blog__section-intro--center {
		margin-inline: auto;
		text-align: center;
	}

	.blog__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.55rem;
		align-items: stretch;
	}

	@media (max-width: 900px) {
		.blog__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
