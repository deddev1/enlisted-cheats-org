---
import { enlistedHeroAlt, enlistedOfficialScreens } from '../data/enlisted';
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import {
	heroIsExternal,
	heroPreloadSrc,
	heroSizes,
	heroSrcSet,
} from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const cheatsUrl = getLocalizedPath('hacks', locale);
const featuresUrl = getLocalizedPath('features', locale);
const setupUrl = getLocalizedPath('setup', locale);
const pricingUrl = getLocalizedPath('pricing', locale);
const updatesUrl = getLocalizedPath('updates', locale);
const espUrl = getLocalizedPath('enlisted-esp', locale);
const wallhackUrl = getLocalizedPath('wallhack', locale);
const aimbotUrl = getLocalizedPath('enlisted-aimbot', locale);
const radarUrl = getLocalizedPath('radar', locale);
const monthlyPlan = productInfo.plans[0];
const lifetimePlan = productInfo.plans[1];

const moduleLinks = [
	{ label: ui.nav.esp, href: espUrl },
	{ label: ui.nav.aimbot, href: aimbotUrl },
	{ label: 'Wallhack', href: wallhackUrl },
	{ label: 'Radar', href: radarUrl },
] as const;
---

<section class="home-about" id="about" aria-labelledby="home-about-title">
	<div class="home-about__media" aria-hidden="true">
		{
			heroIsExternal ? (
				<img
					src={heroPreloadSrc}
					alt={enlistedHeroAlt}
					width="1920"
					height="1080"
					class="home-about__bg"
					loading="lazy"
					decoding="async"
					fetchpriority="low"
				/>
			) : (
				<picture>
					<source media="(max-width: 760px)" srcset={heroPreloadSrc} type="image/webp" />
					<source media="(min-width: 761px)" srcset={heroSrcSet} sizes={heroSizes} type="image/webp" />
					<img
						src={heroPreloadSrc}
						alt={enlistedHeroAlt}
						width="1920"
						height="1080"
						class="home-about__bg"
						loading="lazy"
						decoding="async"
						fetchpriority="low"
					/>
				</picture>
			)
		}
		<div class="home-about__veil"></div>
	</div>

	<div class="home-about__inner">
		<div class="home-about__layout">
			<article class="home-about__panel home-about__panel--primary">
				<h2 id="home-about-title" class="home-about__title">Cheats for Enlisted</h2>
				<p class="home-about__lead">
					<a href={cheatsUrl} class="home-about__inline-link">Enlisted Cheats</a> is a{' '}
					<a href={setupUrl} class="home-about__inline-link">Windows PC</a> package for campaign missions,
					squad assaults, and large-scale battles —{' '}
					<a href={espUrl} class="home-about__inline-link">ESP</a>,{' '}
					<a href={wallhackUrl} class="home-about__inline-link">wallhack</a>,{' '}
					<a href={aimbotUrl} class="home-about__inline-link">aimbot</a>, and{' '}
					<a href={radarUrl} class="home-about__inline-link">radar</a> in one license with{' '}
					<a href={updatesUrl} class="home-about__inline-link">updates</a> after patches.
				</p>

				<div class="home-about__actions">
					<a href={siteConfig.checkoutUrl} class="home-about__btn home-about__btn--primary" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM6.2 6h14.6l-1.4 7H8.1L6.2 6zm-.8-2 2.2 11h11.2l2-11H5.4z"
								fill="currentColor"></path>
						</svg>
						{ui.product.addToCart}
					</a>
					<a href={featuresUrl} class="home-about__btn home-about__btn--ghost">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h10v2H4v-2z"
								fill="currentColor"></path>
						</svg>
						{ui.nav.features}
					</a>
					<a href={setupUrl} class="home-about__btn home-about__btn--ghost">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M4 6h16v2H4V6zm2 11h2v2H6v-2zm4-8h2v10h-2V9zm4 3h2v7h-2v-7zm4-6h2v13h-2V6z"
								fill="currentColor"></path>
						</svg>
						{ui.nav.setup}
					</a>
				</div>

				<div class="home-about__modules">
					<p class="home-about__modules-label">Included in every license:</p>
					<div class="home-about__modules-list">
						{
							moduleLinks.map((item) => (
								<a href={item.href} class="home-about__module">
									{item.label}
								</a>
							))
						}
					</div>
				</div>
			</article>

			<aside class="home-about__panel home-about__panel--premium">
				<figure class="home-about__premium-media">
					<img
						src={enlistedOfficialScreens.squadCombat.src}
						alt={enlistedOfficialScreens.squadCombat.alt}
						width="640"
						height="360"
						loading="lazy"
						decoding="async"
					/>
				</figure>
				<div class="home-about__premium-body">
					<h3 class="home-about__premium-title">Premium access</h3>
					<p class="home-about__premium-copy">
						Get the full <a href={featuresUrl} class="home-about__inline-link">cheat stack</a> with instant
						delivery, undetected maintenance, and rebuilds when{' '}
						<a href={updatesUrl} class="home-about__inline-link">anti-cheat updates</a> land. Choose{' '}
						<a href={pricingUrl} class="home-about__inline-link">monthly</a> from ${monthlyPlan.price}/mo or a
						one-time <a href={pricingUrl} class="home-about__inline-link">lifetime license</a> at $
						{lifetimePlan.price}.
					</p>
					<a href={pricingUrl} class="home-about__btn home-about__btn--purchase" rel="noopener noreferrer">
						View pricing
					</a>
				</div>
			</aside>
		</div>
	</div>
</section>

<style>
	.home-about {
		position: relative;
		isolation: isolate;
		overflow: hidden;
	}

	.home-about__media {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
	}

	.home-about__bg {
		position: absolute;
		top: 50%;
		left: 50%;
		width: auto;
		height: auto;
		min-width: 100%;
		min-height: 100%;
		max-width: none;
		transform: translate(-50%, -50%);
		object-fit: cover;
		object-position: center 40%;
		filter: saturate(1.05) contrast(1.08) brightness(0.72);
	}

	.home-about__veil {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(8, 10, 11, 0.55) 0%, rgba(8, 10, 11, 0.72) 48%, rgba(8, 10, 11, 0.88) 100%),
			radial-gradient(circle at 50% 40%, rgba(8, 10, 11, 0.15), rgba(8, 10, 11, 0.65) 72%);
	}

	.home-about__inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: none;
		margin-inline: 0;
		padding: var(--panel-padding);
	}

	.home-about__layout {
		display: grid;
		grid-template-columns: minmax(0, 1.42fr) minmax(0, 0.88fr);
		gap: 0.85rem;
		align-items: stretch;
	}

	.home-about__panel {
		display: flex;
		flex-direction: column;
		min-width: 0;
		border-radius: 0.2rem;
		background: rgba(8, 10, 11, 0.72);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.home-about__panel--primary {
		gap: 1rem;
		padding: clamp(1rem, 2vw, 1.35rem);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.home-about__panel--premium {
		overflow: hidden;
		border: 1px solid rgba(197, 138, 69, 0.55);
		box-shadow:
			0 0 0 1px rgba(197, 138, 69, 0.12),
			0 12px 32px rgba(0, 0, 0, 0.28),
			inset 0 1px 0 rgba(255, 220, 150, 0.08);
	}

	.home-about__title {
		margin: 0;
		color: #fff;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.8vw, 1.85rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.home-about__lead {
		margin: 0;
		max-width: 42rem;
		color: rgba(255, 255, 255, 0.9);
		font-size: clamp(0.88rem, 1.35vw, 0.96rem);
		line-height: 1.62;
	}

	.home-about__inline-link {
		color: var(--color-gold-hover);
		text-decoration: underline;
		text-decoration-color: rgba(211, 154, 80, 0.42);
		text-underline-offset: 0.14em;
		text-decoration-thickness: 1px;
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}

	.home-about__inline-link:hover,
	.home-about__inline-link:focus-visible {
		color: #fff;
		text-decoration-color: rgba(255, 255, 255, 0.55);
	}

	.home-about__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		gap: 0.55rem;
	}

	.home-about__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-height: 2.85rem;
		padding: 0.75rem 1rem;
		border-radius: 0.15rem;
		border: 1px solid transparent;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			filter 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.home-about__btn svg {
		width: 0.95rem;
		height: 0.95rem;
		flex-shrink: 0;
	}

	.home-about__btn--primary {
		flex: 1 1 12rem;
		background: linear-gradient(180deg, #efb56a 0%, var(--color-gold) 48%, #a86f2f 100%);
		border-color: rgba(255, 220, 150, 0.45);
		color: #1a1006;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.28) inset,
			0 10px 24px rgba(0, 0, 0, 0.28);
	}

	.home-about__btn--primary:hover {
		filter: brightness(1.05);
		transform: translateY(-1px);
		color: #1a1006;
	}

	.home-about__btn--ghost {
		flex: 1 1 8.5rem;
		background: rgba(0, 0, 0, 0.35);
		border-color: rgba(255, 255, 255, 0.18);
		color: rgba(255, 255, 255, 0.92);
	}

	.home-about__btn--ghost:hover {
		background: rgba(0, 0, 0, 0.5);
		border-color: rgba(255, 255, 255, 0.3);
		color: #fff;
	}

	.home-about__modules {
		display: grid;
		gap: 0.55rem;
		padding-top: 0.35rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.home-about__modules-label {
		margin: 0;
		color: rgba(255, 255, 255, 0.52);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.home-about__modules-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.75rem;
	}

	.home-about__module {
		display: inline-flex;
		align-items: center;
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.home-about__module:hover,
	.home-about__module:focus-visible {
		color: var(--color-gold-hover);
	}

	.home-about__premium-media {
		margin: 0;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-bottom: 1px solid rgba(197, 138, 69, 0.22);
	}

	.home-about__premium-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
	}

	.home-about__premium-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1rem 1rem 1.1rem;
	}

	.home-about__premium-title {
		margin: 0;
		color: var(--color-gold-hover);
		font-family: var(--font-display);
		font-size: clamp(1rem, 2vw, 1.15rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.home-about__premium-copy {
		margin: 0;
		flex: 1;
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.82rem;
		line-height: 1.58;
	}

	.home-about__btn--purchase {
		width: 100%;
		min-height: 2.85rem;
		background: linear-gradient(180deg, #efb56a 0%, var(--color-gold) 48%, #a86f2f 100%);
		border-color: rgba(255, 220, 150, 0.45);
		color: #1a1006;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.28) inset,
			0 10px 24px rgba(0, 0, 0, 0.24);
	}

	.home-about__btn--purchase:hover {
		filter: brightness(1.05);
		transform: translateY(-1px);
		color: #1a1006;
	}

	@media (max-width: 900px) {
		.home-about__layout {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.home-about__actions {
			flex-direction: column;
		}

		.home-about__btn {
			width: 100%;
		}
	}
</style>
