---
import { enlistedOfficialScreens } from '../data/enlisted';
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const cheatsUrl = getLocalizedPath('hacks', locale);
const featuresUrl = getLocalizedPath('features', locale);
const setupUrl = getLocalizedPath('setup', locale);
const pricingUrl = getLocalizedPath('pricing', locale);
const updatesUrl = getLocalizedPath('updates', locale);
const supportUrl = getLocalizedPath('support', locale);
const espUrl = getLocalizedPath('enlisted-esp', locale);
const wallhackUrl = getLocalizedPath('wallhack', locale);
const aimbotUrl = getLocalizedPath('enlisted-aimbot', locale);
const radarUrl = getLocalizedPath('radar', locale);
const monthlyPlan = productInfo.plans[0];
const lifetimePlan = productInfo.plans[1];

const highlightLinks = [
	{ label: 'Undetected', href: cheatsUrl },
	{ label: 'ESP', href: espUrl },
	{ label: 'Wallhack', href: wallhackUrl },
	{ label: 'Aimbot', href: aimbotUrl },
	{ label: 'Radar', href: radarUrl },
] as const;
---

<section class="home-about" id="about" aria-labelledby="home-about-title">
	<div class="shell home-about__inner">
		<div class="home-about__layout">
			<div class="home-about__main">
				<p class="home-about__eyebrow">
					<span class="home-about__eyebrow-mark" aria-hidden="true"></span>
					Cheats for Enlisted · Windows PC · Instant delivery
				</p>
				<h2 id="home-about-title" class="home-about__title">
					<span class="home-about__title-accent">Enlisted Cheats</span> built to stay undetected
				</h2>
				<p class="home-about__lead">
					Looking for reliable <strong>cheats for Enlisted</strong> that hold up after patches?{' '}
					<a href={cheatsUrl} class="home-about__inline-link">Enlisted Cheats</a> is the Windows PC
					package players use for large-scale battles, squad assaults, and campaign missions —{' '}
					<a href={espUrl} class="home-about__inline-link">ESP</a>,{' '}
					<a href={wallhackUrl} class="home-about__inline-link">wallhack</a>,{' '}
					<a href={aimbotUrl} class="home-about__inline-link">aimbot</a>, and{' '}
					<a href={radarUrl} class="home-about__inline-link">radar</a> in one{' '}
					<a href={pricingUrl} class="home-about__inline-link">license</a>, with{' '}
					<a href={updatesUrl} class="home-about__inline-link">updates</a> when anti-cheat and game
					patches drop.
				</p>
				<ul class="home-about__highlights" aria-label="Enlisted cheat highlights">
					{
						highlightLinks.map((item) => (
							<li>
								<a href={item.href} class="home-about__highlight">
									{item.label}
								</a>
							</li>
						))
					}
					<li>
						<a href={pricingUrl} class="home-about__highlight home-about__highlight--price">
							From ${monthlyPlan.price}/mo
						</a>
					</li>
				</ul>
				<p class="home-about__copy">
					We rebuild the stack when Gaijin anti-cheat moves, deliver licenses fast, and publish clear{' '}
					<a href={setupUrl} class="home-about__inline-link">setup guides</a> so you can toggle modules
					mid-match without overlay clutter.{' '}
					<a href={pricingUrl} class="home-about__inline-link">Monthly and lifetime plans</a> unlock the
					full <a href={featuresUrl} class="home-about__inline-link">Enlisted cheat feature set</a> plus{' '}
					<a href={supportUrl} class="home-about__inline-link">support</a> every time{' '}
					<a href={updatesUrl} class="home-about__inline-link">patches land</a> — from ${monthlyPlan.price}
					/mo or ${lifetimePlan.price} one-time.
				</p>

				<div class="home-about__actions">
					<a href={siteConfig.checkoutUrl} class="home-about__btn home-about__btn--primary" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM6.2 6h14.6l-1.4 7H8.1L6.2 6zm-.8-2 2.2 11h11.2l2-11H5.4z"
								fill="currentColor"></path>
						</svg>
						Get Enlisted cheats — ${monthlyPlan.price}/mo
					</a>
					<a href={featuresUrl} class="home-about__btn home-about__btn--ghost">
						{ui.nav.features}
					</a>
					<a href={pricingUrl} class="home-about__btn home-about__btn--ghost">
						{ui.nav.pricing}
					</a>
				</div>

				<p class="home-about__platform">
					<span class="home-about__platform-label">Built for</span>
					<a href={setupUrl} class="home-about__platform-value home-about__inline-link">Windows PC</a>
				</p>
			</div>

			<aside class="home-about__card">
				<figure class="home-about__card-media">
					<img
						src={enlistedOfficialScreens.squadThumb.src}
						alt={enlistedOfficialScreens.squadThumb.alt}
						width="420"
						height="236"
						loading="lazy"
						decoding="async"
					/>
				</figure>
				<div class="home-about__card-body">
					<p class="home-about__card-kicker">Why players buy</p>
					<h3 class="home-about__card-title">One package. Every front.</h3>
					<p class="home-about__card-text">
						Buy <a href={cheatsUrl} class="home-about__inline-link">cheats for Enlisted</a> once and run{' '}
						<a href={espUrl} class="home-about__inline-link">ESP</a>,{' '}
						<a href={wallhackUrl} class="home-about__inline-link">wallhack</a>,{' '}
						<a href={aimbotUrl} class="home-about__inline-link">aimbot</a>, and{' '}
						<a href={radarUrl} class="home-about__inline-link">radar</a> together.{' '}
						<a href={pricingUrl} class="home-about__inline-link">Monthly</a> or{' '}
						<a href={pricingUrl} class="home-about__inline-link">lifetime</a> — we keep your build live
						through <a href={updatesUrl} class="home-about__inline-link">anti-cheat updates</a>.
					</p>
					<a href={siteConfig.checkoutUrl} class="home-about__btn home-about__btn--card" rel="noopener noreferrer">
						Get access — from ${monthlyPlan.price}/mo
					</a>
				</div>
			</aside>
		</div>
	</div>
</section>

<style>
	.home-about {
		position: relative;
	}

	.home-about__inner {
		padding-block: clamp(1.75rem, 3vw, 2.25rem);
	}

	.home-about__layout {
		display: grid;
		grid-template-columns: minmax(0, 1.28fr) minmax(0, 17.5rem);
		gap: clamp(1rem, 2vw, 1.5rem);
		align-items: stretch;
	}

	.home-about__main {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.85rem;
		max-width: 40rem;
	}

	.home-about__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		color: var(--color-gold-hover);
		font-size: 0.64rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.home-about__eyebrow-mark {
		display: inline-block;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: linear-gradient(135deg, var(--color-gold-hover), var(--color-accent));
		box-shadow: 0 0 12px rgba(197, 138, 69, 0.55);
		flex-shrink: 0;
	}

	.home-about__title {
		margin: 0;
		color: #fff;
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 3.8vw, 2.55rem);
		font-weight: 800;
		line-height: 1.06;
		letter-spacing: -0.02em;
		text-transform: none;
		max-width: 16ch;
	}

	.home-about__title-accent {
		display: block;
		background: linear-gradient(90deg, #f0bc72 0%, #d39a50 45%, #c58a45 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.home-about__lead {
		margin: 0;
		color: rgba(255, 244, 220, 0.92);
		font-size: clamp(0.9rem, 1.45vw, 1rem);
		line-height: 1.62;
	}

	.home-about__lead strong {
		color: #fff;
		font-weight: 700;
	}

	.home-about__highlights {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 0.1rem 0 0;
		padding: 0;
		list-style: none;
	}

	.home-about__highlight {
		display: inline-flex;
		align-items: center;
		min-height: 1.85rem;
		padding: 0.28rem 0.62rem;
		border: 1px solid rgba(197, 138, 69, 0.28);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.04);
		color: rgba(255, 255, 255, 0.88);
		font-size: 0.64rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}

	.home-about__highlight:hover,
	.home-about__highlight:focus-visible {
		border-color: rgba(211, 154, 80, 0.55);
		background: rgba(197, 138, 69, 0.16);
		color: #fff;
		transform: translateY(-1px);
	}

	.home-about__highlight--price {
		border-color: rgba(255, 220, 150, 0.42);
		background: rgba(197, 138, 69, 0.18);
		color: #ffe8c4;
	}

	.home-about__copy {
		margin: 0;
		color: rgba(181, 180, 170, 0.92);
		font-size: 0.84rem;
		line-height: 1.55;
		max-width: 36rem;
	}

	.home-about__inline-link {
		color: var(--color-gold-hover);
		text-decoration: underline;
		text-decoration-color: rgba(211, 154, 80, 0.42);
		text-underline-offset: 0.14em;
		text-decoration-thickness: 1px;
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}

	.home-about__inline-link:hover,
	.home-about__inline-link:focus-visible {
		color: #fff;
		text-decoration-color: rgba(255, 255, 255, 0.55);
	}

	.home-about__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-top: 0.25rem;
	}

	.home-about__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-height: 2.55rem;
		padding: 0.65rem 0.95rem;
		border-radius: 0.2rem;
		border: 1px solid transparent;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			filter 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.home-about__btn svg {
		width: 0.95rem;
		height: 0.95rem;
		flex-shrink: 0;
	}

	.home-about__btn--primary {
		background: linear-gradient(180deg, var(--color-gold-hover) 0%, var(--color-gold) 52%, var(--color-accent) 100%);
		border-color: rgba(255, 220, 150, 0.45);
		color: #1a1006;
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
	}

	.home-about__btn--primary:hover {
		filter: brightness(1.05);
		transform: translateY(-1px);
		color: #1a1006;
	}

	.home-about__btn--ghost {
		background: rgba(255, 255, 255, 0.04);
		border-color: rgba(255, 255, 255, 0.16);
		color: rgba(255, 255, 255, 0.9);
	}

	.home-about__btn--ghost:hover {
		background: rgba(0, 0, 0, 0.58);
		border-color: rgba(255, 255, 255, 0.28);
		color: #fff;
	}

	.home-about__platform {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0.2rem 0 0;
	}

	.home-about__platform-label {
		color: rgba(255, 255, 255, 0.55);
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.home-about__platform-value {
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.home-about__card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--color-border-panel-strong);
		background: rgba(255, 255, 255, 0.03);
		box-shadow: none;
	}

	.home-about__card-media {
		margin: 0;
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.home-about__card-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
	}

	.home-about__card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.9rem 0.95rem 1rem;
	}

	.home-about__card-kicker {
		margin: 0;
		color: var(--color-gold);
		font-size: 0.64rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.home-about__card-title {
		margin: 0;
		color: #fff;
		font-family: var(--font-display);
		font-size: 0.92rem;
		font-weight: 800;
		line-height: 1.25;
		text-transform: uppercase;
	}

	.home-about__card-text {
		margin: 0;
		flex: 1;
		color: rgba(181, 180, 170, 0.95);
		font-size: 0.78rem;
		line-height: 1.5;
	}

	.home-about__btn--card {
		width: 100%;
		margin-top: 0.25rem;
		min-height: 2.45rem;
		padding-inline: 0.85rem;
		font-size: 0.66rem;
		background: linear-gradient(180deg, var(--color-gold-hover) 0%, var(--color-gold) 100%);
		border-color: rgba(255, 220, 150, 0.35);
		color: #1a1006;
	}

	.home-about__btn--card:hover {
		filter: brightness(1.05);
		color: #1a1006;
	}

	@media (max-width: 900px) {
		.home-about__layout {
			grid-template-columns: 1fr;
		}

		.home-about__card {
			max-width: 20rem;
		}
	}

	@media (max-width: 560px) {
		.home-about__actions {
			flex-direction: column;
			align-items: stretch;
		}

		.home-about__btn {
			width: 100%;
		}

		.home-about__card {
			max-width: none;
		}
	}
</style>
