---
import { enlistedHeroAlt, enlistedOfficialScreens } from '../data/enlisted';
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { siteConfig } from '../data/site';
import {
	contentSrc,
	contentSrcSet,
	heroIsExternal,
	heroPreloadSrc,
	heroSizes,
	heroSrcSet,
} from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);
const about = ui.homeAbout;

const featuresUrl = getLocalizedPath('features', locale);
const setupUrl = getLocalizedPath('setup', locale);
const pricingUrl = getLocalizedPath('pricing', locale);
const espUrl = getLocalizedPath('enlisted-esp', locale);
const wallhackUrl = getLocalizedPath('wallhack', locale);
const aimbotUrl = getLocalizedPath('enlisted-aimbot', locale);
const radarUrl = getLocalizedPath('radar', locale);

const moduleLinks = [
	{ label: ui.nav.esp, href: espUrl },
	{ label: ui.nav.aimbot, href: aimbotUrl },
	{ label: about.wallhack, href: wallhackUrl },
	{ label: about.radar, href: radarUrl },
] as const;

const aboutPremiumSrc = contentSrc(enlistedOfficialScreens.squadCombat.src);
const aboutPremiumSrcSet = contentSrcSet(enlistedOfficialScreens.squadCombat.src);
const aboutPremiumSizes = '(max-width: 680px) 100vw, 640px';
---

<section class="home-about" id="about" aria-labelledby="home-about-title">
	<div class="home-about__media" aria-hidden="true">
		{
			heroIsExternal ? (
				<img
					src={heroPreloadSrc}
					alt={enlistedHeroAlt}
					width="1920"
					height="1080"
					class="home-about__bg"
					loading="lazy"
					decoding="async"
					fetchpriority="low"
				/>
			) : (
				<picture>
					<source media="(max-width: 760px)" srcset={heroPreloadSrc} type="image/webp" />
					<source media="(min-width: 761px)" srcset={heroSrcSet} sizes={heroSizes} type="image/webp" />
					<img
						src={heroPreloadSrc}
						alt={enlistedHeroAlt}
						width="1920"
						height="1080"
						class="home-about__bg"
						loading="lazy"
						decoding="async"
						fetchpriority="low"
					/>
				</picture>
			)
		}
		<div class="home-about__veil"></div>
	</div>

	<div class="shell home-about__inner">
		<div class="home-about__layout">
			<div class="home-about__content">
				<h2 id="home-about-title" class="home-about__title">{about.title}</h2>

				<div class="home-about__copy">
					<p class="home-about__lead" set:html={about.lead} />
					<p class="home-about__text" set:html={about.text1} />
					<p class="home-about__text" set:html={about.text2} />
				</div>

				<div class="home-about__actions">
					<a href={siteConfig.checkoutUrl} class="home-about__btn home-about__btn--primary" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM6.2 6h14.6l-1.4 7H8.1L6.2 6zm-.8-2 2.2 11h11.2l2-11H5.4z"
								fill="currentColor"></path>
						</svg>
						{ui.product.addToCart}
					</a>
					<a href={featuresUrl} class="home-about__btn home-about__btn--ghost">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h10v2H4v-2z"
								fill="currentColor"></path>
						</svg>
						{ui.nav.features}
					</a>
					<a href={setupUrl} class="home-about__btn home-about__btn--ghost">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M4 6h16v2H4V6zm2 11h2v2H6v-2zm4-8h2v10h-2V9zm4 3h2v7h-2v-7zm4-6h2v13h-2V6z"
								fill="currentColor"></path>
						</svg>
						{ui.nav.setup}
					</a>
				</div>

				<div class="home-about__modules">
					<p class="home-about__modules-label">{about.modulesLabel}</p>
					<div class="home-about__modules-list">
						{
							moduleLinks.map((item) => (
								<a href={item.href} class="home-about__module">
									{item.label}
								</a>
							))
						}
					</div>
				</div>
			</div>

			<aside class="home-about__premium">
				<figure class="home-about__premium-media">
					<img
						src={aboutPremiumSrc}
						{...(aboutPremiumSrcSet ? { srcset: aboutPremiumSrcSet } : {})}
						sizes={aboutPremiumSizes}
						alt={enlistedOfficialScreens.squadCombat.alt}
						width="640"
						height="360"
						loading="lazy"
						decoding="async"
						fetchpriority="low"
					/>
				</figure>
				<div class="home-about__premium-body">
					<h3 class="home-about__premium-title">{about.premiumTitle}</h3>
					<p class="home-about__premium-copy" set:html={about.premiumCopy} />
					<a href={pricingUrl} class="home-about__btn home-about__btn--purchase" rel="noopener noreferrer">
						{about.viewPricing}
					</a>
				</div>
			</aside>
		</div>
	</div>
</section>

<style>
	.home-about {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding-block: clamp(1rem, 2.2vw, 1.65rem);
	}

	.home-about__media {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		mask-image: linear-gradient(
			180deg,
			transparent 0%,
			#000 9%,
			#000 91%,
			transparent 100%
		);
		-webkit-mask-image: linear-gradient(
			180deg,
			transparent 0%,
			#000 9%,
			#000 91%,
			transparent 100%
		);
	}

	.home-about__bg {
		position: absolute;
		top: 50%;
		left: 50%;
		width: auto;
		height: auto;
		min-width: 100%;
		min-height: 100%;
		max-width: none;
		transform: translate(-50%, -50%);
		object-fit: cover;
		object-position: center 38%;
		filter: saturate(0.82) brightness(0.5);
	}

	.home-about__veil {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				180deg,
				rgba(13, 17, 18, 0.96) 0%,
				rgba(13, 17, 18, 0.52) 38%,
				rgba(13, 17, 18, 0.48) 62%,
				rgba(13, 17, 18, 0.94) 100%
			),
			linear-gradient(
				105deg,
				rgba(13, 17, 18, 0.62) 0%,
				rgba(13, 17, 18, 0.22) 46%,
				rgba(13, 17, 18, 0.32) 100%
			),
			radial-gradient(ellipse 90% 70% at 50% 42%, rgba(197, 138, 69, 0.06), transparent 68%);
	}

	.home-about__inner {
		position: relative;
		z-index: 1;
	}

	.home-about__layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 17rem;
		gap: clamp(0.85rem, 2vw, 1.15rem);
		align-items: start;
	}

	.home-about__content {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.75rem;
		min-width: 0;
	}

	.home-about__copy {
		display: grid;
		gap: 0.55rem;
		max-width: 38rem;
	}

	.home-about__title {
		margin: 0;
		max-width: 38rem;
		color: #fff;
		font-family: var(--font-display);
		font-size: var(--heading-section);
		font-weight: 800;
		line-height: 1.08;
		letter-spacing: 0.01em;
	}

	.home-about__lead,
	.home-about__text,
	.home-about__premium-copy {
		margin: 0;
		color: rgba(255, 255, 255, 0.9);
		font-size: clamp(0.86rem, 1.2vw, 0.92rem);
		line-height: 1.55;
		text-wrap: pretty;
	}

	.home-about__copy :global(a),
	.home-about__premium-copy :global(a) {
		color: var(--color-gold-hover);
		text-decoration: underline;
		text-decoration-color: rgba(211, 154, 80, 0.42);
		text-underline-offset: 0.14em;
		text-decoration-thickness: 1px;
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}

	.home-about__copy :global(a:hover),
	.home-about__copy :global(a:focus-visible),
	.home-about__premium-copy :global(a:hover),
	.home-about__premium-copy :global(a:focus-visible) {
		color: #fff;
		text-decoration-color: rgba(255, 255, 255, 0.55);
	}

	.home-about__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		gap: 0.45rem;
		max-width: 38rem;
	}

	.home-about__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 2.45rem;
		padding: 0.55rem 0.85rem;
		border-radius: 0.15rem;
		border: 1px solid transparent;
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			filter 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.home-about__btn svg {
		width: 0.82rem;
		height: 0.82rem;
		flex-shrink: 0;
	}

	.home-about__btn--primary {
		flex: 1 1 10.5rem;
		background: linear-gradient(180deg, #efb56a 0%, var(--color-gold) 48%, #a86f2f 100%);
		border-color: rgba(255, 220, 150, 0.45);
		color: #1a1006;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.28) inset,
			0 6px 16px rgba(0, 0, 0, 0.22);
	}

	.home-about__btn--primary:hover {
		filter: brightness(1.05);
		transform: translateY(-1px);
		color: #1a1006;
	}

	.home-about__btn--ghost {
		flex: 1 1 7.5rem;
		background: transparent;
		border-color: rgba(255, 255, 255, 0.28);
		color: rgba(255, 255, 255, 0.92);
	}

	.home-about__btn--ghost:hover {
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(255, 255, 255, 0.42);
		color: #fff;
	}

	.home-about__modules {
		display: grid;
		gap: 0.4rem;
		padding-top: 0.35rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		max-width: 38rem;
	}

	.home-about__modules-label {
		margin: 0;
		color: rgba(255, 255, 255, 0.55);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.home-about__modules-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.65rem;
	}

	.home-about__module {
		display: inline-flex;
		align-items: center;
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.home-about__module:hover,
	.home-about__module:focus-visible {
		color: var(--color-gold-hover);
	}

	.home-about__premium {
		display: flex;
		flex-direction: column;
		width: 100%;
		min-width: 0;
		overflow: hidden;
		border-radius: 0.2rem;
		border: 1px solid rgba(197, 138, 69, 0.32);
		background: rgba(0, 0, 0, 0.28);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
	}

	.home-about__premium-media {
		margin: 0;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-bottom: 1px solid rgba(197, 138, 69, 0.22);
	}

	.home-about__premium-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
	}

	.home-about__premium-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.55rem;
		padding: 0.75rem 0.8rem 0.85rem;
	}

	.home-about__premium-title {
		margin: 0;
		color: var(--color-gold-hover);
		font-family: var(--font-display);
		font-size: 0.82rem;
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.home-about__premium-copy {
		margin: 0;
		flex: 1;
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.76rem;
		line-height: 1.5;
	}

	.home-about__btn--purchase {
		width: 100%;
		min-height: 2.45rem;
		background: linear-gradient(180deg, #efb56a 0%, var(--color-gold) 48%, #a86f2f 100%);
		border-color: rgba(255, 220, 150, 0.45);
		color: #1a1006;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.28) inset,
			0 6px 16px rgba(0, 0, 0, 0.2);
	}

	.home-about__btn--purchase:hover {
		filter: brightness(1.05);
		transform: translateY(-1px);
		color: #1a1006;
	}

	@media (max-width: 900px) {
		.home-about__layout {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.home-about__content {
			max-width: none;
		}

		.home-about__copy,
		.home-about__title,
		.home-about__actions,
		.home-about__modules {
			max-width: none;
		}

		.home-about__premium {
			width: 100%;
		}

		.home-about__veil {
			background:
				linear-gradient(
					180deg,
					rgba(13, 17, 18, 0.92) 0%,
					rgba(13, 17, 18, 0.55) 42%,
					rgba(13, 17, 18, 0.9) 100%
				),
				radial-gradient(ellipse 90% 70% at 50% 40%, rgba(197, 138, 69, 0.05), transparent 68%);
		}
	}

	@media (max-width: 560px) {
		.home-about__actions {
			flex-direction: column;
		}

		.home-about__btn {
			width: 100%;
		}
	}
</style>
