---
import { enlistedHeroAlt, enlistedOfficialScreens } from '../data/enlisted';
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import {
	heroIsExternal,
	heroPreloadSrc,
	heroSizes,
	heroSrcSet,
} from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const cheatsUrl = getLocalizedPath('hacks', locale);
const featuresUrl = getLocalizedPath('features', locale);
const setupUrl = getLocalizedPath('setup', locale);
const pricingUrl = getLocalizedPath('pricing', locale);
const updatesUrl = getLocalizedPath('updates', locale);
const supportUrl = getLocalizedPath('support', locale);
const espUrl = getLocalizedPath('enlisted-esp', locale);
const wallhackUrl = getLocalizedPath('wallhack', locale);
const aimbotUrl = getLocalizedPath('enlisted-aimbot', locale);
const radarUrl = getLocalizedPath('radar', locale);
const monthlyPlan = productInfo.plans[0];
---

<section class="home-about" id="about" aria-labelledby="home-about-title">
	<div class="home-about__media" aria-hidden="true">
		{
			heroIsExternal ? (
				<img
					src={heroPreloadSrc}
					alt={enlistedHeroAlt}
					width="1920"
					height="1080"
					class="home-about__bg"
					loading="lazy"
					decoding="async"
					fetchpriority="low"
				/>
			) : (
				<picture>
					<source media="(max-width: 760px)" srcset={heroPreloadSrc} type="image/webp" />
					<source media="(min-width: 761px)" srcset={heroSrcSet} sizes={heroSizes} type="image/webp" />
					<img
						src={heroPreloadSrc}
						alt={enlistedHeroAlt}
						width="1920"
						height="1080"
						class="home-about__bg"
						loading="lazy"
						decoding="async"
						fetchpriority="low"
					/>
				</picture>
			)
		}
		<div class="home-about__veil"></div>
	</div>

	<div class="home-about__inner">
		<div class="home-about__layout">
			<div class="home-about__main">
				<h2 id="home-about-title" class="home-about__title">Cheats for Enlisted</h2>
				<p class="home-about__lead">
					<a href={cheatsUrl} class="home-about__inline-link">Enlisted Cheats</a> is a{' '}
					<a href={setupUrl} class="home-about__inline-link">Windows PC</a> package built for large-scale
					battles, squad assaults, and campaign missions. We ship{' '}
					<a href={espUrl} class="home-about__inline-link">ESP</a>,{' '}
					<a href={wallhackUrl} class="home-about__inline-link">wallhack</a>,{' '}
					<a href={aimbotUrl} class="home-about__inline-link">aimbot</a>, and{' '}
					<a href={radarUrl} class="home-about__inline-link">radar</a> in one{' '}
					<a href={pricingUrl} class="home-about__inline-link">license</a> with{' '}
					<a href={updatesUrl} class="home-about__inline-link">updates</a> after anti-cheat and game
					patches.
				</p>
				<p class="home-about__copy">
					Our team focuses on{' '}
					<a href={cheatsUrl} class="home-about__inline-link">undetected</a> maintenance, fast delivery,
					and clear <a href={setupUrl} class="home-about__inline-link">setup docs</a> so you can toggle
					modules mid-match without overlay clutter.{' '}
					<a href={pricingUrl} class="home-about__inline-link">Monthly and lifetime plans</a> include the
					full <a href={featuresUrl} class="home-about__inline-link">feature stack</a> and{' '}
					<a href={supportUrl} class="home-about__inline-link">support</a> when{' '}
					<a href={updatesUrl} class="home-about__inline-link">patches land</a>.
				</p>

				<div class="home-about__actions">
					<a href={siteConfig.checkoutUrl} class="home-about__btn home-about__btn--primary" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM6.2 6h14.6l-1.4 7H8.1L6.2 6zm-.8-2 2.2 11h11.2l2-11H5.4z"
								fill="currentColor"></path>
						</svg>
						{ui.product.addToCart}
					</a>
					<a href={featuresUrl} class="home-about__btn home-about__btn--ghost">
						{ui.nav.features}
					</a>
					<a href={setupUrl} class="home-about__btn home-about__btn--ghost">
						{ui.nav.setup}
					</a>
				</div>

				<p class="home-about__platform">
					<span class="home-about__platform-label">Built for</span>
					<span class="home-about__platform-value">Windows PC</span>
				</p>
			</div>

			<aside class="home-about__card">
				<figure class="home-about__card-media">
					<img
						src={enlistedOfficialScreens.squadThumb.src}
						alt={enlistedOfficialScreens.squadThumb.alt}
						width="420"
						height="236"
						loading="lazy"
						decoding="async"
					/>
				</figure>
				<div class="home-about__card-body">
					<p class="home-about__card-kicker">Our package</p>
					<h3 class="home-about__card-title">Full Enlisted cheat stack</h3>
					<p class="home-about__card-text">
						<a href={espUrl} class="home-about__inline-link">ESP</a>,{' '}
						<a href={wallhackUrl} class="home-about__inline-link">wallhack</a>,{' '}
						<a href={aimbotUrl} class="home-about__inline-link">aimbot</a>, and{' '}
						<a href={radarUrl} class="home-about__inline-link">radar</a> ship together in our{' '}
						<a href={featuresUrl} class="home-about__inline-link">full cheat stack</a>. Pick{' '}
						<a href={pricingUrl} class="home-about__inline-link">monthly access</a> or a one-time{' '}
						<a href={pricingUrl} class="home-about__inline-link">lifetime license</a> and get maintenance
						when <a href={updatesUrl} class="home-about__inline-link">Gaijin anti-cheat updates</a> roll
						out.
					</p>
					<a href={pricingUrl} class="home-about__btn home-about__btn--card" rel="noopener noreferrer">
						View pricing — from ${monthlyPlan.price}/mo
					</a>
				</div>
			</aside>
		</div>
	</div>
</section>

<style>
	.home-about {
		position: relative;
		isolation: isolate;
		overflow: hidden;
	}

	.home-about__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.home-about__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
		filter: saturate(1.05) contrast(1.08) brightness(0.72);
	}

	.home-about__veil {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(8, 10, 11, 0.92) 0%, rgba(8, 10, 11, 0.78) 42%, rgba(8, 10, 11, 0.55) 100%),
			linear-gradient(180deg, rgba(8, 10, 11, 0.35) 0%, rgba(8, 10, 11, 0.82) 100%);
	}

	.home-about__inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: none;
		margin-inline: 0;
		padding: var(--panel-padding);
	}

	.home-about__layout {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
		gap: var(--layout-gap);
		align-items: center;
	}

	.home-about__main {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.85rem;
		min-width: 0;
	}

	.home-about__title {
		margin: 0;
		color: #fff;
		font-family: var(--font-display);
		font-size: var(--heading-display);
		font-weight: 800;
		line-height: 1.06;
		letter-spacing: -0.02em;
		text-transform: none;
	}

	.home-about__lead {
		margin: 0;
		color: rgba(255, 244, 220, 0.92);
		font-size: clamp(0.9rem, 1.45vw, 1rem);
		line-height: 1.62;
	}

	.home-about__copy {
		margin: 0;
		color: rgba(181, 180, 170, 0.92);
		font-size: 0.84rem;
		line-height: 1.55;
	}

	.home-about__inline-link {
		color: var(--color-gold-hover);
		text-decoration: underline;
		text-decoration-color: rgba(211, 154, 80, 0.42);
		text-underline-offset: 0.14em;
		text-decoration-thickness: 1px;
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}

	.home-about__inline-link:hover,
	.home-about__inline-link:focus-visible {
		color: #fff;
		text-decoration-color: rgba(255, 255, 255, 0.55);
	}

	.home-about__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-top: 0.25rem;
	}

	.home-about__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-height: 2.55rem;
		padding: 0.65rem 0.95rem;
		border-radius: 0.2rem;
		border: 1px solid transparent;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			filter 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.home-about__btn svg {
		width: 0.95rem;
		height: 0.95rem;
		flex-shrink: 0;
	}

	.home-about__btn--primary {
		background: linear-gradient(180deg, var(--color-gold-hover) 0%, var(--color-gold) 52%, var(--color-accent) 100%);
		border-color: rgba(255, 220, 150, 0.45);
		color: #1a1006;
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
	}

	.home-about__btn--primary:hover {
		filter: brightness(1.05);
		transform: translateY(-1px);
		color: #1a1006;
	}

	.home-about__btn--ghost {
		background: rgba(0, 0, 0, 0.42);
		border-color: rgba(255, 255, 255, 0.16);
		color: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(8px);
	}

	.home-about__btn--ghost:hover {
		background: rgba(0, 0, 0, 0.58);
		border-color: rgba(255, 255, 255, 0.28);
		color: #fff;
	}

	.home-about__platform {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0.2rem 0 0;
	}

	.home-about__platform-label {
		color: rgba(255, 255, 255, 0.55);
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.home-about__platform-value {
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.home-about__card {
		display: flex;
		flex-direction: column;
		width: 100%;
		min-width: 0;
		overflow: hidden;
		border: 1px solid var(--color-border-panel-strong);
		background: rgba(0, 0, 0, 0.42);
		box-shadow: none;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}

	.home-about__card-media {
		margin: 0;
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.home-about__card-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
	}

	.home-about__card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.9rem 0.95rem 1rem;
	}

	.home-about__card-kicker {
		margin: 0;
		color: var(--color-gold);
		font-size: 0.64rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.home-about__card-title {
		margin: 0;
		color: #fff;
		font-family: var(--font-display);
		font-size: 0.92rem;
		font-weight: 800;
		line-height: 1.25;
		text-transform: uppercase;
	}

	.home-about__card-text {
		margin: 0;
		flex: 1;
		color: rgba(181, 180, 170, 0.95);
		font-size: 0.78rem;
		line-height: 1.5;
	}

	.home-about__btn--card {
		width: 100%;
		margin-top: 0.25rem;
		min-height: 2.45rem;
		padding-inline: 0.85rem;
		font-size: 0.66rem;
		background: linear-gradient(180deg, var(--color-gold-hover) 0%, var(--color-gold) 100%);
		border-color: rgba(255, 220, 150, 0.35);
		color: #1a1006;
	}

	.home-about__btn--card:hover {
		filter: brightness(1.05);
		color: #1a1006;
	}

	@media (max-width: 900px) {
		.home-about__layout {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.home-about__actions {
			flex-direction: column;
			align-items: stretch;
		}

		.home-about__btn {
			width: 100%;
		}

		.home-about__card {
			max-width: none;
		}
	}
</style>
