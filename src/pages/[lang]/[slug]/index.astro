---
import LocalizedPage from '../../../components/LocalizedPage.astro';
import { localeCodes, defaultLocale, isLocaleCode } from '../../../data/i18n/locales';
import { localizedSlugs, pageIds, type PageId } from '../../../data/i18n/routing';

export function getStaticPaths() {
	const paths: { params: { lang: string; slug: string }; props: { locale: typeof localeCodes[number]; pageId: PageId } }[] = [];

	for (const lang of localeCodes) {
		if (lang === defaultLocale) continue;
		for (const pageId of pageIds) {
			if (pageId === 'home') continue;
			const slug = localizedSlugs[pageId][lang];
			if (!slug) continue;
			paths.push({ params: { lang, slug }, props: { locale: lang, pageId } });
		}
	}

	return paths;
}

const { locale, pageId } = Astro.props;

if (!isLocaleCode(Astro.params.lang ?? '')) {
	return Astro.redirect('/');
}
---

<LocalizedPage locale={locale} pageId={pageId} />
